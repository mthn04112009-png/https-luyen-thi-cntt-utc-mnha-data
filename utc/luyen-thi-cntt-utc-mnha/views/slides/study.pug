extends ../layout
include ../partials/served-by

block content
    +servedByBadge('Tải xuống')
    link(rel="stylesheet", href="/css/slides.css")

    div(class="sl", id="slApp")
        div(class="sl-top")
            a(href=("/slides/subjects/" + sl.subject.id), class="sl-back")
                i(data-lucide="arrow-left", class="w-4 h-4")
                span= sl.subject.name
            div(class="sl-head")
                h1= sl.title
                if sl.description
                    p= sl.description
            div(class="sl-tools")
                a(id="slDownload", href=sl.downloadUrl, class="sl-btn sl-btn-pri", download=sl.fileName)
                    i(data-lucide="download", class="w-4 h-4")
                    span Tải xuống PDF
                    if sl.size
                        small= mb(sl.size) + ' MB'

        div(class="sl-grid")
            nav(class="sl-units", aria-label="Các slide của môn")
                h2 Slide của môn
                each s in sl.siblings
                    a(href=("/slides/study/" + s.id), class=(s.id === sl.id ? "on" : ""))= s.title

            div(class="sl-pane")
                div(class="sl-bar", id="slBar")
                    button(type="button", id="slPrev", aria-label="Trang trước") ◀
                    span(class="sl-page")
                        input(type="number", id="slPageNo", min="1", value="1", aria-label="Số trang")
                        |  / 
                        b(id="slPageTotal") –
                    button(type="button", id="slNext", aria-label="Trang sau") ▶
                    span(class="sl-sep")
                    button(type="button", id="slZoomOut", aria-label="Thu nhỏ") −
                    button(type="button", id="slZoomReset", aria-label="Vừa khung") 100%
                    button(type="button", id="slZoomIn", aria-label="Phóng to") +
                    span(class="sl-sep")
                    button(type="button", id="slFull", aria-label="Toàn màn hình") ⛶
                div(class="sl-stage", id="slStage")
                    div(class="sl-loading", id="slLoading") Đang tải và giải mã slide…
                    canvas(id="slCanvas", hidden)

    script#slData(type="application/json")!= slJson
    script(src="/js/slideViewer.js")
