extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
        a(href="/flashcards/dashboard", class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Dashboard Flashcards
        div(class="mt-3 mb-6")
            h1(class="text-3xl font-bold text-gray-900")= editing ? 'Sửa flashcard' : 'Tạo flashcard'
            p(class="mt-1 text-gray-500") Nhập nội dung theo định dạng bên dưới (hoặc nhờ AI chuyển đổi bằng prompt có sẵn).

        div(id="fcMsg", class="hidden mb-4 p-4 rounded-xl text-sm")

        div(class="grid grid-cols-1 xl:grid-cols-3 gap-6")
            //- ============ CỘT TRÁI ============
            div(class="xl:col-span-2 space-y-6")
                //- Thông tin chung
                div(class="bg-white rounded-2xl border border-gray-200 p-6 space-y-5")
                    div(class="grid grid-cols-1 md:grid-cols-2 gap-5")
                        div
                            label(for="fcSubject", class="block text-sm font-medium text-gray-700 mb-1") Môn học *
                            select(id="fcSubject", class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 bg-white", disabled=editing)
                                option(value="") — Chọn môn học —
                                each s in subjects
                                    option(value=String(s._id))= s.name + (s.code ? ' (' + s.code + ')' : '')
                            if editing
                                p(class="text-xs text-gray-500 mt-1") Không đổi được môn học của bộ đã tạo.
                        div
                            label(for="fcTitle", class="block text-sm font-medium text-gray-700 mb-1") Tiêu đề *
                            input(id="fcTitle", type="text", maxlength="200", placeholder="VD: Unit 1 – Life stories we admire", class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500")
                    div
                        label(for="fcDesc", class="block text-sm font-medium text-gray-700 mb-1") Mô tả (tuỳ chọn)
                        input(id="fcDesc", type="text", maxlength="1000", class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500")

                    //- Chế độ
                    div
                        label(class="block text-sm font-medium text-gray-700 mb-2") Hình thức học *
                        div(class="grid grid-cols-1 sm:grid-cols-2 gap-3")
                            label(class="fc-mode block cursor-pointer rounded-xl border-2 border-gray-200 p-4 hover:border-indigo-300", data-mode="language")
                                input(type="radio", name="fcMode", value="language", class="sr-only")
                                div(class="flex items-center gap-2 font-semibold text-gray-900")
                                    i(data-lucide="languages", class="w-5 h-5 text-emerald-600")
                                    | Học ngoại ngữ
                                p(class="mt-1 text-xs text-gray-500")= modeHint.language
                            label(class="fc-mode block cursor-pointer rounded-xl border-2 border-gray-200 p-4 hover:border-indigo-300", data-mode="theory")
                                input(type="radio", name="fcMode", value="theory", class="sr-only")
                                div(class="flex items-center gap-2 font-semibold text-gray-900")
                                    i(data-lucide="lightbulb", class="w-5 h-5 text-amber-600")
                                    | Học lý thuyết
                                p(class="mt-1 text-xs text-gray-500")= modeHint.theory

                    div(id="fcLangBox")
                        label(for="fcLang", class="block text-sm font-medium text-gray-700 mb-1") Ngôn ngữ nghe &amp; đọc
                        select(id="fcLang", class="w-full md:w-1/2 px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 bg-white")
                            each l in languages
                                option(value=l.code)= l.label + ' — ' + l.code
                        p(class="text-xs text-gray-500 mt-1") Dùng cho nút Nghe (đọc to) và Đọc (nhận giọng nói) của cả bộ thẻ. Cần trình duyệt Google Chrome / Edge.

                    label(class="inline-flex items-center gap-2 text-sm text-gray-700")
                        input(id="fcPub", type="checkbox", class="rounded border-gray-300")
                        | Công khai cho sinh viên

                //- Nội dung
                div(class="bg-white rounded-2xl border border-gray-200 p-6")
                    div(class="flex flex-wrap items-center justify-between gap-3 mb-3")
                        h2(class="font-semibold text-gray-900") Nội dung flashcard
                        div(class="flex flex-wrap items-center gap-2")
                            label(class="text-xs text-gray-500 flex items-center gap-1") Kiểm duyệt ảnh bằng
                                select(id="fcCloud", class="ml-1 px-2 py-1.5 border border-gray-300 rounded-lg text-xs bg-white", disabled)
                                    option(value="") (đang tải…)
                            button(type="button", id="fcUpBtn", class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-gray-100 text-gray-700 text-sm font-medium hover:bg-gray-200 disabled:opacity-50", disabled)
                                i(data-lucide="image-plus", class="w-4 h-4")
                                | Thêm ảnh
                            input(type="file", id="fcFile", accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,image/avif", class="hidden")
                    p(id="fcUpStatus", class="hidden text-xs mb-2")

                    div(class="mb-3 rounded-xl bg-gray-50 border border-gray-200 p-3 text-xs text-gray-600 font-mono leading-relaxed")
                        div(id="fcFmtLang")
                            div <b>+)</b> từ ngoại ngữ (VD: admire)
                            div(class="text-gray-400") https://raw.githubusercontent.com/…  (ảnh — tuỳ chọn, ngay dưới dòng +)
                            div <b>++)</b> phiên âm IPA (VD: ədˈmaɪə) — tuỳ chọn
                            div <b>=&gt;</b> nghĩa tiếng Việt (VD: ngưỡng mộ)
                        div(id="fcFmtTheory", class="hidden")
                            div <b>+)</b> câu hỏi
                            div(class="text-gray-400") https://raw.githubusercontent.com/…  (ảnh — tuỳ chọn, ngay dưới dòng +)
                            div <b>=&gt;</b> câu trả lời
                        div(class="mt-2 font-sans text-gray-500") Mỗi thẻ cách nhau một dòng trống. Nội dung dài có thể viết nhiều dòng. Gõ <code>\n</code> để xuống dòng, công thức toán đặt trong <code>$...$</code>.

                    textarea(id="fcContent", rows="16", spellcheck="false", class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500", placeholder="+) admire\n++) ədˈmaɪə\n=> ngưỡng mộ\n\n+) elephant\n=> con voi")

                    //- Xem trước / kiểm tra
                    div(id="fcPreview", class="mt-4")
                        div(id="fcSummary", class="text-sm font-medium text-gray-700")
                        ul(id="fcErrors", class="mt-2 space-y-1 text-sm text-red-600 list-disc pl-5")
                        div(id="fcHints", class="mt-2 text-sm text-amber-700 hidden")
                        div(id="fcCards", class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3")

                div(class="flex flex-wrap items-center gap-3")
                    button(type="button", id="fcSave", class="px-5 py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 disabled:opacity-60")= editing ? 'Lưu thay đổi' : 'Tạo flashcard'
                    a(href="/flashcards/dashboard", class="px-5 py-2.5 border border-gray-300 bg-white text-gray-700 rounded-lg font-medium hover:bg-gray-50") Huỷ

            //- ============ CỘT PHẢI: PROMPT ============
            div(class="xl:col-span-1")
                div(class="bg-white rounded-2xl border border-gray-200 p-6 xl:sticky xl:top-4")
                    div(class="flex items-center justify-between gap-2 mb-2")
                        h2(class="font-semibold text-gray-900") Prompt chuyển đổi bằng AI
                        button(type="button", id="fcCopy", class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-medium hover:bg-indigo-100")
                            i(data-lucide="copy", class="w-3.5 h-3.5")
                            | Sao chép
                    p(class="text-xs text-gray-500 mb-3") Dán prompt này vào ChatGPT / Gemini kèm nội dung thô (danh sách từ, bài giảng…), rồi dán kết quả vào ô nội dung bên trái. Prompt tự đổi theo hình thức học đang chọn.
                    textarea(id="fcPrompt", rows="22", readonly, class="w-full px-3 py-2.5 border border-gray-200 rounded-lg bg-gray-50 text-xs font-mono")

        script#fcState(type="application/json")!= fcStateJson
        script(src="/js/flashcardForm.js")
