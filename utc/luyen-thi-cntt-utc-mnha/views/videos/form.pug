extends ../layout

block content
    link(rel="stylesheet", href="/css/videos.css")
    div(class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
        a(href=(app.base + "/dashboard"), class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Dashboard #{app.name}
        div(class="mt-3 mb-6")
            h1(class="text-3xl font-bold text-gray-900")= editing ? ('Sửa ' + app.noun) : ('Thêm ' + app.noun)
            p(class="mt-1 text-gray-500")
                | Mỗi #{app.noun} chứa nhiều video. Với mỗi video chỉ cần dán mã nhúng (Chia sẻ → Nhúng) — web tự căn chỉnh kích thước cho phù hợp. Mã nhúng được mã hoá AES-256 trước khi lưu lên GitHub nên mở file JSON không thấy link video.

        div(id="vfMsg", class="hidden mb-4 p-4 rounded-xl text-sm")

        div(class="bg-white rounded-2xl border border-gray-200 p-6 space-y-5")
            div(class="grid grid-cols-1 md:grid-cols-2 gap-5")
                div
                    label(for="vfSubject", class="block text-sm font-medium text-gray-700 mb-1") Môn học *
                    select(id="vfSubject", class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 bg-white", disabled=editing)
                        option(value="") — Chọn môn học —
                        each s in subjects
                            option(value=String(s._id))= s.name + (s.code ? ' (' + s.code + ')' : '')
                    if editing
                        p(class="text-xs text-gray-500 mt-1") Không đổi được môn học đã tạo.
                div
                    label(for="vfTitle", class="block text-sm font-medium text-gray-700 mb-1") Tiêu đề *
                    input(id="vfTitle", type="text", maxlength="200", placeholder="VD: Khoá học Đại số tuyến tính – Chương 1", class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500")
            div
                label(for="vfDesc", class="block text-sm font-medium text-gray-700 mb-1") Mô tả (tuỳ chọn)
                input(id="vfDesc", type="text", maxlength="1000", class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500")

            div
                div(class="flex items-center justify-between mb-2")
                    label(class="block text-sm font-medium text-gray-700") Danh sách video *
                    span(id="vfCount", class="text-xs text-gray-500")
                div(id="vfList", class="space-y-4")
                button(type="button", id="vfAdd", class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-dashed border-indigo-300 text-indigo-700 bg-indigo-50 hover:bg-indigo-100 text-sm font-medium")
                    i(data-lucide="plus", class="w-4 h-4")
                    | Thêm video

            label(class="inline-flex items-center gap-2 text-sm text-gray-700")
                input(id="vfPub", type="checkbox", class="rounded border-gray-300")
                | Công khai cho sinh viên

        div(class="mt-6 flex flex-wrap items-center gap-3")
            button(type="button", id="vfSave", class="px-5 py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 disabled:opacity-60")= editing ? 'Lưu thay đổi' : ('Lưu ' + app.noun)
            a(href=(app.base + "/dashboard"), class="px-5 py-2.5 border border-gray-300 bg-white text-gray-700 rounded-lg font-medium hover:bg-gray-50") Huỷ

    script#vfState(type="application/json")!= vfStateJson
    script(src="/js/videoForm.js")
