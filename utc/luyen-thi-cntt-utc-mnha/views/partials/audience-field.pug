//- Khối "Ai được xem" dùng chung. Dùng: include ../partials/audience-field  rồi  +audienceField()
//- JS: /js/audiencePicker.js (AudiencePicker.init). Tìm người: GET <searchUrl>?q=
mixin audienceField(opts)
    - var o = opts || {}
    link(rel="stylesheet", href="/css/audience.css")
    div(class="au-field")
        label(class="block text-sm font-medium text-gray-700 mb-2")= o.label || 'Ai được xem *'
        div(id="auVis", class="vf-vis", role="radiogroup", aria-label="Ai được xem")
            label(class="vf-vis-opt")
                input(type="radio", name="auVisibility", value="public")
                span
                    b Công khai
                    small Mọi sinh viên đã được duyệt đều xem được (mặc định).
            label(class="vf-vis-opt")
                input(type="radio", name="auVisibility", value="private")
                span
                    b Không công khai
                    small Chỉ admin thấy; sinh viên không thấy và không mở được.
            label(class="vf-vis-opt")
                input(type="radio", name="auVisibility", value="users")
                span
                    b Chỉ hiển thị với…
                    small Chỉ những người bạn chọn (có thể chọn nhiều người) mới thấy.
        div(id="auUsersBox", class="vf-users hidden")
            div(class="flex items-center justify-between mb-2")
                label(class="block text-sm font-medium text-gray-700") Người được xem
                span(id="auUsersCount", class="text-xs text-gray-500")
            div(id="auUserPicker", class="sp")
            div(id="auChips", class="vf-chips")
            p(class="text-xs text-gray-500 mt-2") Tìm được theo họ tên (có/không dấu), email hoặc chỉ một đoạn tên. Chỉ hiện sinh viên đã được duyệt. Id người dùng được lưu trong file JSON trên GitHub.
        //- (tuỳ chọn) form HTML thường: 2 ô ẩn được JS cập nhật theo lựa chọn
        if o.hidden
            input(type="hidden", name="visibility", id="auHidVis")
            input(type="hidden", name="allowedUserIds", id="auHidIds")
