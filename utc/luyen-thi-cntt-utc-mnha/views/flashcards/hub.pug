extends ../layout

block content
    div(class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10")
        a(href="/apps", class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Ứng dụng
        div(class="mt-3 mb-8")
            h1(class="text-3xl font-bold text-gray-900") Flashcards
            p(class="mt-1 text-gray-500") Học thuộc bằng thẻ ghi nhớ, luyện tập theo cấp độ và làm bài kiểm tra.

        div(class=("grid grid-cols-1 gap-6 " + (admin ? "sm:grid-cols-2" : "")))
            if admin
                a(
                    href="/flashcards/dashboard",
                    class="group block bg-white rounded-2xl border border-gray-200 hover:border-indigo-300 hover:shadow-lg transition-all p-8"
                )
                    div(class="w-14 h-14 rounded-2xl bg-violet-50 flex items-center justify-center")
                        i(data-lucide="layout-dashboard", class="w-7 h-7 text-violet-600")
                    h2(class="mt-5 text-xl font-bold text-gray-900 group-hover:text-indigo-600") Dashboard
                    p(class="mt-2 text-sm text-gray-500") Tạo, sửa, công khai hoặc xoá các bộ flashcard (dành cho quản trị viên).
                    span(class="mt-5 inline-flex items-center text-sm font-medium text-indigo-600")
                        | Quản lý flashcard
                        i(data-lucide="chevron-right", class="w-4 h-4 ml-1")
            a(
                href="/flashcards/subjects",
                class="group block bg-white rounded-2xl border border-gray-200 hover:border-indigo-300 hover:shadow-lg transition-all p-8"
            )
                div(class="w-14 h-14 rounded-2xl bg-indigo-50 flex items-center justify-center")
                    i(data-lucide="book-open", class="w-7 h-7 text-indigo-600")
                h2(class="mt-5 text-xl font-bold text-gray-900 group-hover:text-indigo-600") Môn học
                p(class="mt-2 text-sm text-gray-500") Chọn môn học để xem và học các bộ flashcard của môn đó.
                span(class="mt-5 inline-flex items-center text-sm font-medium text-indigo-600")
                    | Chọn môn học
                    i(data-lucide="chevron-right", class="w-4 h-4 ml-1")
