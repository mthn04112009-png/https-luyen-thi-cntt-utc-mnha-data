doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Đặt lại mật khẩu | AI Grading System

        script(src="https://cdn.tailwindcss.com")
        script(src="https://unpkg.com/lucide@latest")

    body(class="min-h-screen bg-gray-50")

        div(class="min-h-screen flex items-center justify-center px-4 py-10")
            div(class="w-full max-w-md")

                //- Logo
                div(class="text-center mb-8")
                    a(
                        href="/"
                        class="inline-flex items-center gap-3"
                    )
                        div(class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center shadow-lg")
                            i(
                                data-lucide="graduation-cap"
                                class="w-7 h-7 text-white"
                            )

                        div(class="text-left")
                            h1(class="text-xl font-bold text-gray-900")
                                | AI Grading
                            p(class="text-xs text-gray-500")
                                | Hệ thống học tập trực tuyến

                //- Card
                div(class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8")

                    div(class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center mb-5")
                        i(
                            data-lucide="lock-keyhole"
                            class="w-6 h-6"
                        )

                    h2(class="text-2xl font-bold text-gray-900")
                        | Đặt lại mật khẩu

                    p(class="text-sm text-gray-500 mt-2 leading-6")
                        | Đặt mật khẩu mới cho tài khoản
                        span(class="font-semibold text-gray-700")
                            = ' ' + email
                        | . Mật khẩu phải có ít nhất 8 ký tự.

                    if error
                        div(class="mt-5 flex items-start gap-3 p-4 bg-red-50 border border-red-200 rounded-xl")
                            i(
                                data-lucide="circle-alert"
                                class="w-5 h-5 text-red-500 flex-shrink-0"
                            )
                            p(class="text-sm text-red-700")
                                = error

                    form(
                        action="/auth/reset-password"
                        method="POST"
                        class="mt-6 space-y-5"
                    )

                        div
                            label(
                                for="password"
                                class="block text-sm font-medium text-gray-700 mb-2"
                            )
                                | Mật khẩu mới

                            div(class="relative")
                                i(
                                    data-lucide="lock"
                                    class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"
                                )

                                input(
                                    id="password"
                                    type="password"
                                    name="password"
                                    required
                                    minlength="8"
                                    autocomplete="new-password"
                                    placeholder="Tối thiểu 8 ký tự"
                                    class="w-full pl-10 pr-12 py-3 border border-gray-300 rounded-xl text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                                )

                                button(
                                    type="button"
                                    id="togglePassword"
                                    aria-label="Hiện/ẩn mật khẩu"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                                )
                                    i(
                                        data-lucide="eye"
                                        class="w-5 h-5"
                                    )

                        div
                            label(
                                for="confirmPassword"
                                class="block text-sm font-medium text-gray-700 mb-2"
                            )
                                | Xác nhận mật khẩu

                            div(class="relative")
                                i(
                                    data-lucide="lock"
                                    class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"
                                )

                                input(
                                    id="confirmPassword"
                                    type="password"
                                    name="confirmPassword"
                                    required
                                    minlength="8"
                                    autocomplete="new-password"
                                    placeholder="Nhập lại mật khẩu"
                                    class="w-full pl-10 pr-12 py-3 border border-gray-300 rounded-xl text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                                )

                                button(
                                    type="button"
                                    id="toggleConfirmPassword"
                                    aria-label="Hiện/ẩn mật khẩu"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                                )
                                    i(
                                        data-lucide="eye"
                                        class="w-5 h-5"
                                    )

                        button(
                            type="submit"
                            class="w-full py-3 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100 transition"
                        )
                            | Đổi mật khẩu

                p(class="text-center text-xs text-gray-400 mt-6")
                    | © #{new Date().getFullYear()} AI Grading System

        script.
            lucide.createIcons();

            function setupPasswordToggle(buttonId, inputId) {
                const button = document.getElementById(buttonId);
                const input = document.getElementById(inputId);

                if (!button || !input) {
                    return;
                }

                button.addEventListener('click', function () {
                    const isPassword = input.type === 'password';

                    input.type = isPassword ? 'text' : 'password';

                    this.innerHTML = `
                        <i data-lucide="${isPassword ? 'eye-off' : 'eye'}" class="w-5 h-5"></i>
                    `;

                    lucide.createIcons();
                });
            }

            setupPasswordToggle('togglePassword', 'password');
            setupPasswordToggle('toggleConfirmPassword', 'confirmPassword');