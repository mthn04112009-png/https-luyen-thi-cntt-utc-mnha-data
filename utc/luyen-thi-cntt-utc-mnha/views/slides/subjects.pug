extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
        a(href="/slides", class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Slide học tập
        div(class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mt-3 mb-8")
            div
                h1(class="text-3xl font-bold text-gray-900") Chọn môn học
                p(class="mt-1 text-gray-500") Chọn môn học để xem slide của môn đó.
            if subjects && subjects.length
                div(class="text-sm text-gray-500")
                    i(data-lucide="book-open", class="w-4 h-4 inline-block mr-1")
                    | #{typeof totalItems !== 'undefined' ? totalItems : subjects.length} môn học

        form(action="/slides/subjects", method="GET", class="mb-6 flex gap-3")
            div(class="relative flex-1")
                i(data-lucide="search", class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none")
                input(
                    type="search",
                    name="q",
                    value=(filters && filters.q) || "",
                    placeholder="Tìm môn học theo tên, mã môn hoặc mô tả...",
                    autocomplete="off",
                    class="w-full pl-9 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                )
            button(type="submit", class="px-4 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800") Tìm
            if filters && filters.q
                a(href="/slides/subjects", class="px-4 py-2.5 border border-gray-300 bg-white text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50") Xoá lọc

        if !subjects || subjects.length === 0
            div(class="bg-white rounded-2xl border border-gray-200 p-10 text-center")
                div(class="w-16 h-16 mx-auto rounded-full bg-indigo-50 flex items-center justify-center mb-4")
                    i(data-lucide="presentation", class="w-8 h-8 text-indigo-600")
                if filters && filters.q
                    h2(class="text-xl font-semibold text-gray-900") Không tìm thấy môn học
                    p(class="mt-2 text-gray-500") Không có kết quả cho "#{filters.q}".
                else
                    h2(class="text-xl font-semibold text-gray-900") Chưa có môn học
                    p(class="mt-2 text-gray-500") Hiện tại chưa có môn học nào được công khai.
        else
            div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6")
                each subject in subjects
                    a(
                        href=("/slides/subjects/" + subject._id),
                        class="group block bg-white rounded-2xl border border-gray-200 hover:border-indigo-300 hover:shadow-lg transition-all duration-200 overflow-hidden"
                    )
                        div(class="h-2 bg-indigo-600")
                        div(class="p-6")
                            div(class="flex items-start justify-between gap-4")
                                div(class="w-12 h-12 rounded-xl bg-indigo-50 flex items-center justify-center flex-shrink-0")
                                    i(data-lucide="presentation", class="w-6 h-6 text-indigo-600")
                                i(data-lucide="arrow-up-right", class="w-5 h-5 text-gray-400 group-hover:text-indigo-600 transition-colors")
                            h2(class="mt-5 text-xl font-bold text-gray-900 group-hover:text-indigo-600 transition-colors")= subject.name
                            if subject.code
                                p(class="mt-1 text-sm font-medium text-indigo-600")= subject.code
                            if subject.description
                                p(class="mt-3 text-sm text-gray-500 line-clamp-3")= subject.description
                            div(class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between")
                                span(class="text-sm text-gray-500")
                                    i(data-lucide="presentation", class="w-4 h-4 inline-block mr-1")
                                    | #{subject.slideCount || 0} slide
                                span(class="text-sm font-medium text-indigo-600")
                                    | Xem slide
                                    i(data-lucide="chevron-right", class="w-4 h-4 inline-block ml-1")
            include ../pagination
