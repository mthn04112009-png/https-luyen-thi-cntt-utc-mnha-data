extends layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Header
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8")
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900")
                    | Luyện tập
                p(class="text-gray-500 mt-1")
                    | Chọn 1 bài để làm và nộp. AI sẽ chấm tự động.

        //- Tìm kiếm + lọc môn
        div(class="bg-white border border-gray-200 rounded-xl p-4 mb-6")
            form(action="/practice", method="GET", class="flex flex-col sm:flex-row gap-3")
                div(class="relative flex-1")
                    i(data-lucide="search", class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none")
                    input(
                        type="search"
                        name="q"
                        value=(filters && filters.q) || ""
                        placeholder="Tìm bài tập theo tên hoặc mô tả..."
                        autocomplete="off"
                        class="w-full pl-9 pr-3 py-2.5 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                    )

                if subjects && subjects.length
                    select(
                        name="subject"
                        data-subject-picker
                        class="px-3 py-2.5 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                    )
                        option(value="") Tất cả môn học
                        each s in subjects
                            option(
                                value=String(s._id)
                                selected=(filters && filters.subject === String(s._id))
                            )
                                = s.name

                button(
                    type="submit"
                    class="px-4 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800"
                )
                    | Tìm

                if filters && (filters.q || filters.subject)
                    a(
                        href="/practice"
                        class="px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 text-center"
                    )
                        | Xoá lọc

        //- Danh sách bài
        if lessons && lessons.length
            div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5")
                each lesson in lessons
                    .bg-white.border.border-gray-200.rounded-2xl.p-5.shadow-sm.flex.flex-col
                        div(class="flex items-start gap-3 flex-1")
                            .w-11.h-11.rounded-xl.bg-indigo-100.text-indigo-600.flex.items-center.justify-center.flex-shrink-0
                                i(data-lucide="pencil", class="w-5 h-5")

                            div(class="flex-1 min-w-0")
                                h2(class="font-bold text-gray-900 truncate")
                                    = lesson.title
                                p(class="text-xs text-gray-500 mt-0.5 truncate")
                                    = (lesson.subject && lesson.subject.name) || 'Chưa có môn'

                        //- Điểm cũ
                        if submittedMap && submittedMap[String(lesson._id)]
                            div(class="mt-4 p-3 rounded-lg bg-green-50 border border-green-200 flex items-center justify-between")
                                span(class="text-xs font-medium text-green-700")
                                    | Điểm gần nhất
                                span(class="text-lg font-bold text-green-700")
                                    = submittedMap[String(lesson._id)].score
                                    span(class="text-xs text-green-600 font-normal")
                                        | / #{submittedMap[String(lesson._id)].maxScore}

                        //- Nút làm bài
                        a(
                            href=`/lessons/${lesson._id}`
                            class="mt-4 inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-semibold hover:bg-indigo-700 transition"
                        )
                            i(data-lucide="play", class="w-4 h-4")
                            if submittedMap && submittedMap[String(lesson._id)]
                                | Làm lại
                            else
                                | Làm bài

            //- Phân trang
            include pagination

        else
            .bg-white.border.border-gray-200.rounded-2xl.py-16.text-center
                .w-14.h-14.rounded-full.bg-gray-100.text-gray-400.flex.items-center.justify-center.mx-auto
                    i(data-lucide="inbox", class="w-6 h-6")
                if filters && filters.q
                    h2(class="font-semibold text-gray-900 mt-4")
                        | Không tìm thấy bài nào
                    p(class="text-sm text-gray-500 mt-1")
                        | Không có kết quả cho "#{filters.q}". Thử từ khoá khác nhé.
                else
                    h2(class="font-semibold text-gray-900 mt-4")
                        | Chưa có bài học
                    p(class="text-sm text-gray-500 mt-1")
                        | Hãy quay lại sau.