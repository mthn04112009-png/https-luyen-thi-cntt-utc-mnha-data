extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
        a(href="/flashcards", class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Flashcards
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-3 mb-6")
            div
                h1(class="text-3xl font-bold text-gray-900") Dashboard Flashcards
                p(class="mt-1 text-gray-500") Tạo và quản lý các bộ flashcard. Dữ liệu lưu trên GitHub: subjects/&lt;môn&gt;/flashcards/&lt;tên&gt;_&lt;timestamp&gt;.json
            a(
                href=("/flashcards/dashboard/new" + (filters && filters.subject ? ("?subject=" + filters.subject) : "")),
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700"
            )
                i(data-lucide="plus", class="w-4 h-4")
                | Tạo flashcard

        form(action="/flashcards/dashboard", method="GET", class="mb-6 flex flex-col sm:flex-row gap-3")
            div(class="relative flex-1")
                i(data-lucide="search", class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none")
                input(
                    type="search",
                    name="q",
                    value=(filters && filters.q) || "",
                    placeholder="Tìm theo tiêu đề hoặc mô tả...",
                    autocomplete="off",
                    class="w-full pl-9 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                )
            select(name="subject", class="px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500")
                option(value="") Tất cả môn học
                each s in subjects
                    option(value=String(s._id), selected=(filters && filters.subject === String(s._id)))= s.name
            button(type="submit", class="px-4 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800") Lọc
            if filters && (filters.q || filters.subject)
                a(href="/flashcards/dashboard", class="px-4 py-2.5 border border-gray-300 bg-white text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 text-center") Xoá lọc

        if !flashcards || flashcards.length === 0
            div(class="bg-white rounded-2xl border border-gray-200 p-10 text-center")
                div(class="w-16 h-16 mx-auto rounded-full bg-indigo-50 flex items-center justify-center mb-4")
                    i(data-lucide="layers", class="w-8 h-8 text-indigo-600")
                h2(class="text-xl font-semibold text-gray-900") Chưa có bộ flashcard
                p(class="mt-2 text-gray-500") Bấm "Tạo flashcard" để thêm bộ thẻ đầu tiên.
        else
            div(class="bg-white rounded-2xl border border-gray-200 overflow-hidden")
                div(class="overflow-x-auto")
                    table(class="min-w-full text-sm")
                        thead(class="bg-gray-50 text-left text-gray-500")
                            tr
                                th(class="px-4 py-3 font-medium") Bộ flashcard
                                th(class="px-4 py-3 font-medium") Môn học
                                th(class="px-4 py-3 font-medium") Chế độ
                                th(class="px-4 py-3 font-medium text-center") Số thẻ
                                th(class="px-4 py-3 font-medium text-center") Công khai
                                th(class="px-4 py-3 font-medium text-right") Thao tác
                        tbody(class="divide-y divide-gray-100")
                            each f in flashcards
                                tr(class="hover:bg-gray-50", data-row=String(f._id))
                                    td(class="px-4 py-3")
                                        a(href=("/flashcards/study/" + f._id), class="font-medium text-gray-900 hover:text-indigo-600")= f.title
                                        if f.updatedAt
                                            div(class="text-xs text-gray-400") Cập nhật #{new Date(f.updatedAt).toLocaleString('vi-VN')}
                                    td(class="px-4 py-3 text-gray-600")= f.subject ? f.subject.name : '—'
                                    td(class="px-4 py-3")
                                        if f.mode === 'theory'
                                            span(class="px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-medium") Học lý thuyết
                                        else
                                            span(class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-medium")= "Ngoại ngữ · " + languageName(f.language)
                                    td(class="px-4 py-3 text-center text-gray-700")= f.cardCount || 0
                                    td(class="px-4 py-3 text-center")
                                        button(
                                            type="button",
                                            data-publish=String(f._id),
                                            class=("fc-pub px-2.5 py-1 rounded-full text-xs font-medium " + (f.isPublished !== false ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600"))
                                        )= f.isPublished !== false ? 'Đang công khai' : 'Đang ẩn'
                                    td(class="px-4 py-3 text-right whitespace-nowrap")
                                        a(href=("/flashcards/study/" + f._id), class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200") Xem
                                        a(href=("/flashcards/dashboard/" + f._id + "/edit"), class="ml-1 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-indigo-50 text-indigo-700 hover:bg-indigo-100") Sửa
                                        button(type="button", data-delete=String(f._id), data-title=f.title, class="fc-del ml-1 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-red-50 text-red-600 hover:bg-red-100") Xoá
            include ../pagination

        script.
            (function () {
                function post(url) {
                    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }, body: '{}' })
                        .then(function (r) { return r.json().catch(function () { return { success: false, message: 'Máy chủ trả lỗi ' + r.status }; }); });
                }
                document.querySelectorAll('.fc-pub').forEach(function (b) {
                    b.addEventListener('click', function () {
                        b.disabled = true;
                        post('/flashcards/dashboard/' + b.getAttribute('data-publish') + '/publish').then(function (d) {
                            b.disabled = false;
                            if (!d.success) { alert(d.message || 'Không đổi được trạng thái.'); return; }
                            b.textContent = d.isPublished ? 'Đang công khai' : 'Đang ẩn';
                            b.className = 'fc-pub px-2.5 py-1 rounded-full text-xs font-medium ' + (d.isPublished ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600');
                        });
                    });
                });
                document.querySelectorAll('.fc-del').forEach(function (b) {
                    b.addEventListener('click', function () {
                        if (!confirm('Xoá bộ flashcard "' + b.getAttribute('data-title') + '"? File trên GitHub cũng sẽ bị xoá.')) return;
                        b.disabled = true;
                        post('/flashcards/dashboard/' + b.getAttribute('data-delete') + '/delete').then(function (d) {
                            if (!d.success) { b.disabled = false; alert(d.message || 'Không xoá được.'); return; }
                            window.location.reload();
                        });
                    });
                });
            })();
