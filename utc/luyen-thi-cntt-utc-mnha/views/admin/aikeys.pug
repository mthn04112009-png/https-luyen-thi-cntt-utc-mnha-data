extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Header
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8")
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900")
                    | API Key AI
                p(class="text-gray-500 mt-1")
                    | Quản lý khóa API dùng cho hệ thống chấm bài

            div(class="flex flex-wrap items-center gap-3")
                a(
                    href="/admin/ai-keys/cloudinary"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50"
                )
                    i(data-lucide="cloud", class="w-4 h-4")
                    | Cloudinary

                button(
                    type="button"
                    onclick="document.getElementById('keyModal').classList.remove('hidden')"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700"
                )
                    i(data-lucide="plus", class="w-4 h-4")
                    | Thêm API Key

        //- Flash
        if success
            div(class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm")
                = success
        if error
            div(class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm")
                = error

        //- Security notice
        div(class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-6")
            div(class="flex items-start gap-3")
                i(data-lucide="shield-check", class="w-5 h-5 text-blue-600 mt-0.5")
                div
                    p(class="font-medium text-blue-900")
                        | Bảo mật API Key
                    p(class="text-sm text-blue-700 mt-1")
                        | API Key được lưu ở dạng mã hóa AES-256-GCM và không hiển thị đầy đủ trong giao diện.

        //- Danh sách key
        div(class="grid grid-cols-1 lg:grid-cols-2 gap-5")
            if aiKeys && aiKeys.length
                each key in aiKeys
                    div(class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm")
                        div(class="flex items-start justify-between")
                            div
                                div(class="flex items-center gap-3")
                                    div(class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center")
                                        i(data-lucide="key-round", class="w-5 h-5")
                                    div
                                        h2(class="font-semibold text-gray-900")
                                            = key.name || 'Gemini API Key'
                                        div(class="flex items-center gap-2 mt-1")
                                            span(class="px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-700")
                                                = key.model || 'Chưa chọn model'
                                            if (key.provider || 'gemini') === 'vilao'
                                                span(class="px-2 py-0.5 rounded text-xs font-medium bg-teal-100 text-teal-700")
                                                    | vilao.ai
                                            else
                                                span(class="px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700")
                                                    | Gemini

                            if key.isActive && !key.isRevoked
                                span(class="px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-medium")
                                    | Đang hoạt động
                            else
                                span(class="px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 text-xs font-medium")
                                    | Đã tắt

                        //- Masked key
                        div(class="mt-5 p-3 bg-gray-50 rounded-lg font-mono text-sm text-gray-600")
                            = key.maskedKey || (key.lastFour ? '••••••••••••' + key.lastFour : '••••••••••••••••')

                        //- Meta
                        div(class="mt-3 flex items-center gap-4 text-xs text-gray-500")
                            div
                                | Dùng: 
                                span(class="font-semibold text-gray-700")
                                    = key.usageCount || 0
                            if key.lastUsedAt
                                div
                                    | Lần cuối: #{new Date(key.lastUsedAt).toLocaleString('vi-VN')}

                        //- Audit + Actions
                        div(class="mt-4 flex items-center justify-between pt-3 border-t border-gray-100")
                            p(class="text-xs text-gray-500")
                                | Cập nhật:
                                = ' ' + (key.updatedAt ? new Date(key.updatedAt).toLocaleString('vi-VN') : '—')

                            div(class="flex items-center gap-2")
                                form(
                                    action="/admin/ai-keys/" + key._id + "/toggle"
                                    method="POST"
                                    class="inline"
                                )
                                    button(
                                        type="submit"
                                        class="px-3 py-1.5 rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 text-xs font-medium"
                                    )
                                        = key.isActive ? 'Tắt' : 'Bật'

                                form(
                                    action="/admin/ai-keys/" + key._id + "/delete"
                                    method="POST"
                                    class="inline"
                                    onsubmit="return confirm('Bạn có chắc muốn xóa API Key này?')"
                                )
                                    button(
                                        type="submit"
                                        class="w-8 h-8 rounded-lg text-red-500 hover:bg-red-50 flex items-center justify-center"
                                    )
                                        i(data-lucide="trash-2", class="w-4 h-4")
            else
                div(class="lg:col-span-2 bg-white border border-gray-200 rounded-2xl py-12 text-center")
                    i(data-lucide="key-round", class="w-10 h-10 mx-auto text-gray-300")
                    p(class="text-gray-500 mt-3")
                        | Chưa có API Key.
                    button(
                        type="button"
                        onclick="document.getElementById('keyModal').classList.remove('hidden')"
                        class="inline-flex items-center gap-2 mt-5 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700"
                    )
                        i(data-lucide="plus", class="w-4 h-4")
                        | Thêm API Key đầu tiên

        //- Phân trang
        include ../pagination

        //- Modal thêm key
        div#keyModal(class="hidden fixed inset-0 z-50 bg-black/50 p-4")
            div(class="min-h-full flex items-center justify-center")
                div(class="bg-white rounded-2xl w-full max-w-lg shadow-xl")
                    div(class="px-6 py-5 border-b border-gray-200 flex items-center justify-between")
                        h2(class="font-bold text-gray-900")
                            | Thêm API Key
                        button(
                            type="button"
                            onclick="document.getElementById('keyModal').classList.add('hidden')"
                            class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center"
                        )
                            i(data-lucide="x", class="w-5 h-5")

                    form(
                        action="/admin/ai-keys"
                        method="POST"
                        class="p-6 space-y-5"
                    )
                        //- ★ MODEL ƯU TIÊN (tuỳ chọn) — chỉ để hiển thị/thống kê,
                        //- KHÔNG khoá key vào 1 model. Key này vẫn dùng được cho
                        //- mọi model khi chấm bài; model thực tế do lesson/prompt
                        //- chọn tại thời điểm chấm.
                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | Model ưu tiên (tuỳ chọn)
                            select(
                                name="model"
                                id="keyModelSelect"
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500"
                            )
                                option(value="") — Không cố định (dùng mọi model) —
                                each m in supportedModels
                                    option(value=m, data-provider="gemini")
                                        = m
                                each m in (vilaoModels || [])
                                    option(value=m, data-provider="vilao", hidden, disabled)
                                        = m
                            p(class="text-xs text-gray-500 mt-1")
                                | Chỉ là nhãn tham khảo. Key vẫn dùng được cho mọi model được hỗ trợ khi chấm bài.

                        //- Tên
                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | Tên gợi nhớ *
                            input(
                                type="text"
                                name="name"
                                required
                                placeholder="Ví dụ: Key chính - Gemini 3.6"
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500"
                            )

                        //- Nhà cung cấp (Gemini mặc định, thêm vilao.ai)
                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | Nhà cung cấp *
                            select(
                                name="provider"
                                id="providerSelect"
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500"
                            )
                                option(value="gemini", selected) Gemini (Google)
                                option(value="vilao") vilao.ai

                        //- API Key
                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | API Key *
                            input(
                                type="password"
                                name="apiKey"
                                id="apiKeyInput"
                                required
                                autocomplete="off"
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono outline-none focus:ring-2 focus:ring-indigo-500"
                                placeholder="AIza..."
                            )
                            p(class="text-xs text-gray-500 mt-1")
                                | Key sẽ được mã hoá AES-256-GCM trước khi lưu vào DB.
                            p(id="apiKeyWarn", class="hidden text-xs text-yellow-600 mt-1")

                        //- Actions
                        div(class="flex justify-end gap-3 pt-2")
                            button(
                                type="button"
                                onclick="document.getElementById('keyModal').classList.add('hidden')"
                                class="px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50"
                            )
                                | Hủy

                            button(
                                type="submit"
                                class="px-4 py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700"
                            )
                                | Lưu API Key

        script.
            (function () {
                var provider = document.getElementById('providerSelect');
                var modelSel = document.getElementById('keyModelSelect');
                var keyInput = document.getElementById('apiKeyInput');
                var warn = document.getElementById('apiKeyWarn');
                if (!provider || !modelSel || !keyInput) return;

                function syncProvider() {
                    var p = provider.value;
                    for (var i = 0; i < modelSel.options.length; i++) {
                        var o = modelSel.options[i];
                        var op = o.getAttribute('data-provider');
                        if (!op) continue; // option "Không cố định"
                        var show = op === p;
                        o.hidden = !show;
                        o.disabled = !show;
                    }
                    var cur = modelSel.options[modelSel.selectedIndex];
                    if (cur && cur.getAttribute('data-provider') && cur.getAttribute('data-provider') !== p) {
                        modelSel.value = '';
                    }
                    keyInput.placeholder = p === 'vilao' ? 'sk-...' : 'AIza...';
                    checkPrefix();
                }

                // Chỉ cảnh báo mềm, không chặn lưu
                function checkPrefix() {
                    var v = keyInput.value.trim();
                    var p = provider.value;
                    var msg = '';
                    if (v) {
                        if (p === 'gemini' && v.indexOf('AIza') !== 0) {
                            msg = 'Key Gemini thường bắt đầu bằng "AIza". Kiểm tra lại nhà cung cấp nếu bạn nhập nhầm.';
                        } else if (p === 'vilao' && v.indexOf('sk-') !== 0) {
                            msg = 'Key vilao.ai thường bắt đầu bằng "sk-". Kiểm tra lại nhà cung cấp nếu bạn nhập nhầm.';
                        }
                    }
                    warn.textContent = msg;
                    warn.classList.toggle('hidden', !msg);
                }

                provider.addEventListener('change', syncProvider);
                keyInput.addEventListener('input', checkPrefix);
                syncProvider();
            })();
