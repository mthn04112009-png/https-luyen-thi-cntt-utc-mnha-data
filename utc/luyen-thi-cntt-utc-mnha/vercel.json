{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "views/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/connect/usage-archive",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/github/prune-history",
      "schedule": "30 20 * * *"
    }
  ]
}
