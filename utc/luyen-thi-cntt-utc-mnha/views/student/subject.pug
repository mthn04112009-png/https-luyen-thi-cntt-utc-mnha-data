extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Breadcrumb
        nav(class="mb-6 text-sm")
            a(href="/subjects", class="text-blue-600 hover:text-blue-700") ← Danh sách môn học
            span(class="mx-2 text-gray-400") /
            span(class="text-gray-600")= subject.name

        //- Header môn học
        div(class="bg-white rounded-2xl border border-gray-200 overflow-hidden mb-8")
            div(class="h-2 bg-blue-600")

            div(class="p-6 sm:p-8")
                div(class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4")
                    div(class="flex items-start gap-4")
                        div(class="w-14 h-14 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0")
                            i(data-lucide="book-open", class="w-7 h-7 text-blue-600")

                        div
                            h1(class="text-2xl sm:text-3xl font-bold text-gray-900")= subject.name

                            if subject.code
                                p(class="mt-1 text-sm font-medium text-blue-600")= subject.code

                            if subject.description
                                p(class="mt-3 text-gray-600")= subject.description

                            p(class="mt-3 text-sm text-gray-500")
                                i(data-lucide="user", class="w-4 h-4 inline-block mr-1")
                                | Người tạo môn: 
                                span(class="font-medium text-gray-700")= subject.createdBy && subject.createdBy.name ? subject.createdBy.name : 'Không rõ'

                            if subject.updatedBy && subject.updatedBy.name
                                p(class="mt-1 text-sm text-gray-500")
                                    i(data-lucide="user-pen", class="w-4 h-4 inline-block mr-1")
                                    | Cập nhật bởi: 
                                    span(class="font-medium text-gray-700")= subject.updatedBy.name
                                    if subject.updatedAt
                                        |  · #{new Date(subject.updatedAt).toLocaleDateString("vi-VN")}

                    div(class="text-right flex-shrink-0")
                        div(class="text-sm text-gray-500")
                            i(data-lucide="layers", class="w-4 h-4 inline-block mr-1")
                            | #{typeof totalItems !== 'undefined' ? totalItems : (lessons ? lessons.length : 0)} bài học

        //- Danh sách bài học
        h2(class="text-xl font-semibold text-gray-900 mb-4") Danh sách bài học

        //- Tìm kiếm bài học trong môn
        form(action=`/subjects/${subject._id}`, method="GET", class="mb-6 flex gap-3")
            div(class="relative flex-1")
                i(data-lucide="search", class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none")
                input(
                    type="search"
                    name="q"
                    value=(filters && filters.q) || ""
                    placeholder="Tìm bài học theo tên hoặc mô tả..."
                    autocomplete="off"
                    class="w-full pl-9 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-blue-500"
                )
            button(type="submit", class="px-4 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800") Tìm
            if filters && filters.q
                a(href=`/subjects/${subject._id}`, class="px-4 py-2.5 border border-gray-300 bg-white text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50") Xoá lọc

        if !lessons || lessons.length === 0
            div(class="bg-white rounded-2xl border border-gray-200 p-10 text-center")
                div(class="w-16 h-16 mx-auto rounded-full bg-gray-50 flex items-center justify-center mb-4")
                    i(data-lucide="inbox", class="w-8 h-8 text-gray-400")

                if filters && filters.q
                    h3(class="text-lg font-semibold text-gray-900") Không tìm thấy bài học
                    p(class="mt-2 text-gray-500") Không có kết quả cho "#{filters.q}".
                else
                    h3(class="text-lg font-semibold text-gray-900") Chưa có bài học
                    p(class="mt-2 text-gray-500") Môn học này hiện chưa có bài học nào được công khai.
        else
            div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
                each lesson in lessons
                    a(
                        href=`/lessons/${lesson._id}`
                        class="group block bg-white rounded-xl border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all p-5"
                    )
                        div(class="flex items-start justify-between gap-4")
                            div(class="flex items-start gap-3 flex-1 min-w-0")
                                div(class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0")
                                    i(data-lucide="file-text", class="w-5 h-5 text-blue-600")

                                div(class="flex-1 min-w-0")
                                    h3(class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors")
                                        = lesson.title

                                    if lesson.description
                                        p(class="mt-1 text-sm text-gray-500 line-clamp-2")
                                            = lesson.description

                                    div(class="mt-2 flex flex-col items-start gap-1 text-xs text-gray-400")
                                        span
                                            i(data-lucide="user", class="w-3 h-3 inline-block mr-1")
                                            | Người tạo đề: #{lesson.createdBy && lesson.createdBy.name ? lesson.createdBy.name : 'Không rõ'}
                                        if lesson.createdAt
                                            span
                                                i(data-lucide="calendar", class="w-3 h-3 inline-block mr-1")
                                                | #{new Date(lesson.createdAt).toLocaleDateString("vi-VN")}
                                        if lesson.updatedAt && lesson.updatedAt !== lesson.createdAt
                                            span
                                                i(data-lucide="clock", class="w-3 h-3 inline-block mr-1")
                                                | Cập nhật #{new Date(lesson.updatedAt).toLocaleDateString("vi-VN")}
                                        if lesson.updatedBy && lesson.updatedBy.name
                                            span
                                                i(data-lucide="user-pen", class="w-3 h-3 inline-block mr-1")
                                                | Cập nhật bởi: #{lesson.updatedBy.name}

                                    //- ★ Tên file JSON trên GitHub mà bài học này lấy dữ liệu
                                    - var lessonFileName = lesson.githubFile ? lesson.githubFile.split('/').pop() : ''
                                    if lessonFileName
                                        p(class="mt-1 text-xs text-gray-400 font-mono break-all", title=lesson.githubFile)
                                            i(data-lucide="file-json", class="w-3 h-3 inline-block mr-1")
                                            | File: #{lessonFileName}

                            i(
                                data-lucide="chevron-right"
                                class="w-5 h-5 text-gray-400 group-hover:text-blue-600 transition-colors flex-shrink-0"
                            )

                        //- ★ Điểm gần nhất (giống trang Luyện tập)
                        if submittedMap && submittedMap[String(lesson._id)]
                            div(class="mt-4 p-3 rounded-lg bg-green-50 border border-green-200 flex items-center justify-between")
                                span(class="text-xs font-medium text-green-700")
                                    | Điểm gần nhất
                                span(class="text-lg font-bold text-green-700")
                                    = submittedMap[String(lesson._id)].score
                                    span(class="text-xs text-green-600 font-normal")
                                        |  / #{submittedMap[String(lesson._id)].maxScore}

            //- Phân trang
            include ../pagination
