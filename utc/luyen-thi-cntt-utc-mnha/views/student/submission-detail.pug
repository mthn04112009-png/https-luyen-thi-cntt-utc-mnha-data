extends ../layout

block content
    div(class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Back
        div(class="mb-6 flex items-center justify-between gap-3")
            a(
                href=isAdmin ? '/admin/submissions' : '/submissions/history'
                class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700"
            )
                i(data-lucide="arrow-left", class="w-4 h-4")
                | Quay lại danh sách

            //- Chỉ admin/giảng viên: mở trang nhận xét (chấm) bài này
            if isAdmin
                a(
                    href=`/admin/submissions/${submission._id}/review`
                    class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
                )
                    i(data-lucide="message-square-text", class="w-4 h-4")
                    = (submission.teacherComment && submission.teacherComment.content) ? 'Sửa nhận xét' : 'Chấm bài / Nhận xét'

        //- ============================================================
        //- HEADER — Bài nộp + Điểm
        //- ============================================================
        div(class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-6")
            div(class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4")

                //- Left: info
                div(class="flex-1 min-w-0")
                    h1(class="text-2xl font-bold text-gray-900 break-words")
                        = (submission.lessonId && submission.lessonId.title) || 'Bài nộp'

                    if submission.subjectId && submission.subjectId.name
                        p(class="text-sm text-gray-500 mt-1")
                            = submission.subjectId.name

                    //- Meta info
                    div(class="flex flex-wrap items-center gap-3 mt-3 text-xs text-gray-500")
                        if submission.userId && submission.userId.name
                            span(class="inline-flex items-center gap-1")
                                i(data-lucide="user", class="w-3.5 h-3.5")
                                = submission.userId.name

                        if submission.submittedAt
                            span(class="inline-flex items-center gap-1")
                                i(data-lucide="clock", class="w-3.5 h-3.5")
                                = new Date(submission.submittedAt).toLocaleString('vi-VN')

                        if submission.model
                            span(class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 font-mono")
                                i(data-lucide="bot", class="w-3 h-3")
                                = submission.model

                        //- ★ Nhãn AI giống lesson.pug: ưu tiên snapshot lưu trên bài nộp (submission.aiLabel)
                        //-   → fallback aiLabel controller truyền vào
                        - const shownAiLabel = submission.aiLabel || aiLabel
                        if shownAiLabel
                            span(class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-purple-50 text-purple-700")
                                i(data-lucide="key-round", class="w-3 h-3")
                                = shownAiLabel

                        if submission.latencyMs
                            span(class="inline-flex items-center gap-1")
                                i(data-lucide="timer", class="w-3.5 h-3.5")
                                = (submission.latencyMs / 1000).toFixed(1) + 's'

                //- Right: score / status
                div(class="text-right flex-shrink-0")
                    if submission.status === 'graded'
                        div(class="flex items-baseline gap-1 justify-end")
                            span(class="text-5xl font-bold text-green-600")
                                = submission.score !== null && submission.score !== undefined ? submission.score : '—'
                            span(class="text-lg text-gray-400")
                                | / 10
                        p(class="text-xs text-gray-500 mt-1")
                            | Đã chấm
                    else if submission.status === 'grading' || submission.status === 'pending'
                        span(class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-medium bg-blue-100 text-blue-700")
                            i(data-lucide="loader", class="w-4 h-4")
                            | Đang chấm
                    else if submission.status === 'failed'
                        span(class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-medium bg-red-100 text-red-700")
                            i(data-lucide="circle-alert", class="w-4 h-4")
                            | Chấm lỗi
                    else
                        span(class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-medium bg-yellow-100 text-yellow-700")
                            | Chờ chấm

        //- ============================================================
        //- LỖI CHẤM (nếu failed)
        //- ============================================================
        if submission.status === 'failed' && submission.errorMessage
            div(class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200")
                div(class="flex items-start gap-3")
                    i(data-lucide="circle-alert", class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5")
                    div(class="flex-1 min-w-0")
                        p(class="font-semibold text-red-900 mb-1")
                            | Chấm bài thất bại
                        p(class="text-sm text-red-800 break-words")
                            = submission.errorMessage

        //- ============================================================
        //- ĐỀ BÀI (nếu có)
        //- ============================================================
        if submission.lessonId && submission.lessonId.contentHtml
            div(class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-6")
                h2(class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2")
                    i(data-lucide="file-text", class="w-5 h-5 text-indigo-600")
                    | Đề bài
                div(class="prose prose-sm max-w-none text-gray-800")
                    != submission.lessonId.contentHtml

        //- ============================================================
        //- BÀI LÀM
        //- ============================================================
        div(class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-6")
            h2(class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2")
                i(data-lucide="pencil", class="w-5 h-5 text-indigo-600")
                | Bài làm
            div(class="p-4 rounded-lg bg-gray-50 border border-gray-100")
                if submission.answerHtml
                    //- ★ FIX: answerHtml thực chất là text thô (có thể chứa
                    //  code C++ với < >), không phải HTML thật — trước đây
                    //  render bằng `!=` (unescaped) nên: (1) trình duyệt hiểu
                    //  nhầm các dấu < > thành thẻ HTML, nội dung dễ bị nuốt
                    //  mất hoặc vỡ layout; (2) \n trong text không tự xuống
                    //  dòng vì không có CSS giữ khoảng trắng.
                    //  Sửa: dùng `pre` + `whitespace-pre-wrap` để giữ nguyên
                    //  xuống dòng theo \n, và render bằng `=` (escaped) để
                    //  an toàn + hiển thị đúng ký tự < > trong code, đồng
                    //  thời giữ nguyên tông màu xám gốc (text-gray-800) thay
                    //  vì màu xanh lá cố định như khối "Lời giải mẫu".
                    pre(class="text-sm text-gray-800 whitespace-pre-wrap font-mono m-0")
                        = submission.answerHtml
                else
                    p(class="text-gray-400 italic")
                        = submission.hasDrawing ? '(Không nhập chữ — chỉ nộp phần vẽ tay)' : '(Không có nội dung)'

        //- ============================================================
        //- BẢN VẼ TAY (JS Paint) + kết quả AI đọc ảnh
        //- ============================================================
        if submission.hasDrawing
            div(class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-6")
                h2(class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2")
                    | 🎨 Bản vẽ tay
                div(class="p-3 rounded-lg bg-gray-50 border border-gray-100 text-center")
                    a(href=`/submissions/${submission._id}/drawing`, target="_blank", rel="noopener")
                        img(
                            src=`/submissions/${submission._id}/drawing`
                            alt="Bản vẽ tay của bài nộp"
                            style="max-width:100%;max-height:640px;background:#fff;border:1px solid #e5e7eb;border-radius:6px"
                        )
                    div(class="text-xs text-gray-400 mt-2") Bấm vào ảnh để xem cỡ lớn

                if submission.drawingAnalysis
                    - var da = submission.drawingAnalysis
                    details(class="mt-4 p-4 rounded-lg bg-violet-50 border border-violet-100")
                        summary(class="cursor-pointer font-semibold text-violet-900 text-sm")
                            | 🔎 AI đã đọc bản vẽ như thế nào (bước phân tích ảnh trước khi chấm)
                        div(class="mt-3 text-sm text-gray-800 space-y-3")
                            p(class="text-xs text-gray-500")
                                | Loại: #{da.kind || 'không rõ'} • Độ rõ nét: #{da.legibility || 'không rõ'}
                            if da.transcription
                                div
                                    div(class="font-semibold") Chữ/ký hiệu đọc được
                                    pre(class="whitespace-pre-wrap font-mono text-sm m-0")= da.transcription
                            if da.description
                                div
                                    div(class="font-semibold") Mô tả bố cục
                                    p(class="whitespace-pre-wrap m-0")= da.description
                            if da.uncertain && da.uncertain.length
                                div
                                    div(class="font-semibold") Chỗ AI chưa chắc chắn
                                    ul(class="list-disc pl-5 m-0")
                                        each u in da.uncertain
                                            li= u

        //- ============================================================
        //- BREAKDOWN — Điểm chi tiết
        //- ============================================================
        if submission.breakdown && Array.isArray(submission.breakdown) && submission.breakdown.length
            div(class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-6")
                h2(class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2")
                    i(data-lucide="list-checks", class="w-5 h-5 text-indigo-600")
                    | Chi tiết điểm theo tiêu chí

                div(class="space-y-3")
                    each item in submission.breakdown
                        div(class="p-4 rounded-lg bg-gray-50 border border-gray-100")
                            div(class="flex items-start justify-between gap-4 mb-2")
                                p(class="font-semibold text-gray-900")
                                    = item.criterion || '(không có tên)'
                                span(class="flex-shrink-0 text-lg font-bold text-indigo-600")
                                    = item.score !== null && item.score !== undefined ? item.score : '—'

                            if item.comment
                                p(class="text-sm text-gray-700 whitespace-pre-wrap")
                                    = item.comment

        //- ============================================================
        //- NHẬN XÉT CHUNG
        //- ============================================================
        if submission.feedback
            div(class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-6")
                h2(class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2")
                    i(data-lucide="bot", class="w-5 h-5 text-indigo-600")
                    | Nhận xét của AI
                div(class="text-sm text-gray-700 whitespace-pre-wrap leading-7")
                    = submission.feedback

        //- ============================================================
        //- NHẬN XÉT CỦA GIẢNG VIÊN (tuỳ chọn — không có thì ẩn cả khối)
        //- ============================================================
        - var tcNote = (submission.teacherComment && submission.teacherComment.content) ? String(submission.teacherComment.content).trim() : ''
        if tcNote
            div(class="bg-white border border-indigo-200 rounded-2xl p-6 shadow-sm mb-6")
                h2(class="text-lg font-bold text-gray-900 mb-1 flex items-center gap-2")
                    i(data-lucide="message-square-text", class="w-5 h-5 text-indigo-600")
                    | Nhận xét của giảng viên
                p(class="text-xs text-gray-500 mb-3")
                    = submission.teacherComment.commentedByName || 'Giảng viên'
                    if submission.teacherComment.commentedAt
                        |  · #{new Date(submission.teacherComment.commentedAt).toLocaleString('vi-VN')}
                div(class="text-sm text-gray-700 whitespace-pre-wrap leading-7")
                    = tcNote

        //- ============================================================
        //- LỖI NGỮ PHÁP
        //- ============================================================
        if submission.grammar && Array.isArray(submission.grammar.errors) && submission.grammar.errors.length
            div(class="bg-white border border-orange-200 rounded-2xl p-6 shadow-sm mb-6")
                h2(class="text-lg font-bold text-orange-900 mb-4 flex items-center gap-2")
                    i(data-lucide="spell-check", class="w-5 h-5 text-orange-600")
                    | Lỗi ngữ pháp đã phát hiện
                    span(class="ml-2 px-2 py-0.5 rounded-full text-xs font-bold bg-orange-100 text-orange-700")
                        = submission.grammar.errors.length

                div(class="space-y-3")
                    each err, idx in submission.grammar.errors
                        div(class="p-4 rounded-lg bg-orange-50 border border-orange-100")
                            div(class="flex items-center gap-2 mb-2")
                                span(class="text-xs font-bold text-orange-600")
                                    | Lỗi #{idx + 1}

                            div(class="space-y-2 text-sm")
                                div
                                    span(class="font-medium text-gray-700")
                                        | Câu gốc: 
                                    span(class="text-red-600 line-through")
                                        = err.original || '(không có)'

                                div
                                    span(class="font-medium text-gray-700")
                                        | Câu sửa: 
                                    span(class="text-green-700 font-semibold")
                                        = err.corrected || '(không có)'

                                if err.explanation
                                    div
                                        span(class="font-medium text-gray-700")
                                            | Giải thích: 
                                        span(class="text-gray-800")
                                            = err.explanation

        //- ============================================================
        //- SO SÁNH VỚI LỜI GIẢI MẪU
        //- ============================================================
        if submission.sampleComparison && Array.isArray(submission.sampleComparison.missingPoints) && submission.sampleComparison.missingPoints.length
            div(class="bg-white border border-purple-200 rounded-2xl p-6 shadow-sm mb-6")
                h2(class="text-lg font-bold text-purple-900 mb-4 flex items-center gap-2")
                    i(data-lucide="git-compare", class="w-5 h-5 text-purple-600")
                    | So sánh với lời giải mẫu

                p(class="text-sm text-purple-700 mb-3")
                    | Các ý còn thiếu so với lời giải mẫu:

                ul(class="space-y-2 list-disc list-inside")
                    each point in submission.sampleComparison.missingPoints
                        li(class="text-sm text-purple-900")
                            = point

        //- ============================================================
        //- LỜI GIẢI MẪU (chỉ hiện khi đã chấm)
        //- ============================================================
        if submission.status === 'graded' && submission.lessonId && submission.lessonId.sampleSolution
            div(class="bg-white border border-green-200 rounded-2xl p-6 shadow-sm mb-6")
                h2(class="text-lg font-bold text-green-900 mb-3 flex items-center gap-2")
                    i(data-lucide="lightbulb", class="w-5 h-5 text-green-600")
                    | Lời giải mẫu
                //- ★ FIX: sampleSolution là HTML thật (div/h3/pre/code, đã
                //  escape sẵn &lt; &gt; bên trong các khối <pre><code>) —
                //  giống hệt cấu trúc của "Đề bài" bên trên, không phải
                //  text thô như "Bài làm". Trước đây nhúng bằng `pre` +
                //  `= ` (escaped) nên toàn bộ thẻ HTML (h3, pre, code...)
                //  bị hiện ra dưới dạng chữ thô thay vì được trình duyệt
                //  render thành tiêu đề/khối code như ý.
                //  Sửa: render bằng `!=` (unescaped, giống khối Đề bài) để
                //  HTML được hiểu đúng, đồng thời thêm class `prose` để có
                //  typography cho h3/p/pre/code — nhưng vẫn giữ nguyên nền
                //  + khung màu xanh lá (bg-green-50, border-green-100) và
                //  tông chữ xanh (text-green-900) thay vì màu gray mặc định
                //  của "prose".
                div(class="prose prose-sm max-w-none text-green-900 p-4 rounded-lg bg-green-50 border border-green-100")
                    != submission.lessonId.sampleSolution

        //- ============================================================
        //- PROMPT SNAPSHOT (chỉ hiện cho admin)
        //- ============================================================
        if isAdmin && submission.promptSnapshot
            div(class="bg-purple-50 border border-purple-200 rounded-2xl p-6 shadow-sm")
                h2(class="text-lg font-bold text-purple-900 mb-3 flex items-center gap-2")
                    i(data-lucide="code", class="w-5 h-5 text-purple-600")
                    | Prompt đã dùng để chấm

                div(class="space-y-1 mb-3 text-xs text-purple-700")
                    if submission.promptSnapshot.name
                        div
                            span(class="font-semibold")
                                | Tên: 
                            = submission.promptSnapshot.name
                    if submission.promptSnapshot.version !== undefined
                        div
                            span(class="font-semibold")
                                | Phiên bản: 
                            = 'v' + submission.promptSnapshot.version
                    if submission.promptSnapshot.maxScore !== undefined
                        div
                            span(class="font-semibold")
                                | Điểm tối đa: 
                            = submission.promptSnapshot.maxScore
                    if submission.promptSnapshot.strictness
                        div
                            span(class="font-semibold")
                                | Mức độ chặt: 
                            = submission.promptSnapshot.strictness

                if submission.promptSnapshot.rubric && submission.promptSnapshot.rubric.length
                    div(class="mb-3")
                        p(class="text-xs font-semibold text-purple-700 mb-2")
                            | Rubric:
                        ul(class="text-xs text-purple-800 space-y-1")
                            each r in submission.promptSnapshot.rubric
                                li
                                    = r.criterion + ' (' + r.weight + '%)'
                                    if r.description
                                        |  — #{r.description}

                if submission.promptSnapshot.content
                    details(class="mt-3")
                        summary(class="cursor-pointer text-xs font-semibold text-purple-700 hover:text-purple-900")
                            | Xem nội dung prompt đầy đủ
                        pre(class="mt-2 p-3 rounded-lg bg-white text-xs text-gray-800 overflow-x-auto whitespace-pre-wrap border border-purple-100")
                            = submission.promptSnapshot.content