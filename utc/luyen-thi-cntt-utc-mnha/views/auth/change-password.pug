extends ../layout

block content
    div(class="max-w-md mx-auto px-4 py-10")
        div(class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8")

            div(class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center mb-5")
                i(data-lucide="key-round", class="w-6 h-6")

            h1(class="text-2xl font-bold text-gray-900") Đổi mật khẩu
            p(class="text-sm text-gray-500 mt-2 leading-6")
                | Bạn đang đăng nhập nên không cần xác minh lại. Mật khẩu phải có ít nhất 8 ký tự.

            if success
                div(class="mt-5 flex items-start gap-3 p-4 bg-green-50 border border-green-200 rounded-xl")
                    i(data-lucide="circle-check", class="w-5 h-5 text-green-600 flex-shrink-0")
                    p(class="text-sm text-green-700") Đã đổi mật khẩu thành công. Lần đăng nhập sau hãy dùng mật khẩu mới.

            if error
                div(class="mt-5 flex items-start gap-3 p-4 bg-red-50 border border-red-200 rounded-xl")
                    i(data-lucide="circle-alert", class="w-5 h-5 text-red-500 flex-shrink-0")
                    p(class="text-sm text-red-700")= error

            form(action="/auth/change-password", method="POST", class="mt-6 space-y-5", id="changePwForm")
                div
                    label(for="password", class="block text-sm font-medium text-gray-700 mb-2") Mật khẩu mới
                    div(class="relative")
                        input(
                            id="password", type="password", name="password", required, minlength="8", maxlength="128",
                            autocomplete="new-password", placeholder="Tối thiểu 8 ký tự",
                            class="w-full px-4 pr-12 py-3 border border-gray-300 rounded-xl text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                        )
                        button(type="button", data-toggle="password", aria-label="Hiện/ẩn mật khẩu", class="pw-toggle absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600")
                            i(data-lucide="eye", class="w-5 h-5")

                div
                    label(for="confirmPassword", class="block text-sm font-medium text-gray-700 mb-2") Nhập lại mật khẩu mới
                    div(class="relative")
                        input(
                            id="confirmPassword", type="password", name="confirmPassword", required, minlength="8", maxlength="128",
                            autocomplete="new-password", placeholder="Nhập lại mật khẩu",
                            class="w-full px-4 pr-12 py-3 border border-gray-300 rounded-xl text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                        )
                        button(type="button", data-toggle="confirmPassword", aria-label="Hiện/ẩn mật khẩu", class="pw-toggle absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600")
                            i(data-lucide="eye", class="w-5 h-5")
                    p(id="pwMismatch", class="hidden text-xs text-red-600 mt-2") Mật khẩu xác nhận chưa khớp.

                button(type="submit", class="w-full py-3 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100 transition")
                    | Đổi mật khẩu

    script.
        (function () {
            document.querySelectorAll('.pw-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.getAttribute('data-toggle'));
                    if (!input) return;
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.innerHTML = '<i data-lucide="' + (show ? 'eye-off' : 'eye') + '" class="w-5 h-5"></i>';
                    if (window.lucide) lucide.createIcons();
                });
            });
            var p = document.getElementById('password'), c = document.getElementById('confirmPassword'), m = document.getElementById('pwMismatch');
            function chk() { m.classList.toggle('hidden', !c.value || p.value === c.value); }
            p.addEventListener('input', chk); c.addEventListener('input', chk);
            document.getElementById('changePwForm').addEventListener('submit', function (e) {
                if (p.value !== c.value) { e.preventDefault(); chk(); c.focus(); }
            });
        })();
