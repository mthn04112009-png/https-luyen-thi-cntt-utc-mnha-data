extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
        a(href="/flashcards/subjects", class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Danh sách môn học

        div(class="mt-3 mb-8 bg-white rounded-2xl border border-gray-200 overflow-hidden")
            div(class="h-2 bg-gradient-to-r from-indigo-500 to-violet-500")
            div(class="p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4")
                div
                    h1(class="text-2xl sm:text-3xl font-bold text-gray-900")= subject.name
                    if subject.code
                        p(class="mt-1 text-sm font-medium text-indigo-600")= subject.code
                    if subject.description
                        p(class="mt-2 text-gray-500")= subject.description
                if user && user.role === 'admin'
                    a(
                        href=("/flashcards/dashboard/new?subject=" + subject._id),
                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 self-start"
                    )
                        i(data-lucide="plus", class="w-4 h-4")
                        | Thêm flashcard

        form(action=("/flashcards/subjects/" + subject._id), method="GET", class="mb-6 flex gap-3")
            div(class="relative flex-1")
                i(data-lucide="search", class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none")
                input(
                    type="search",
                    name="q",
                    value=(filters && filters.q) || "",
                    placeholder="Tìm bộ flashcard theo tiêu đề hoặc mô tả...",
                    autocomplete="off",
                    class="w-full pl-9 pr-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                )
            button(type="submit", class="px-4 py-2.5 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800") Tìm
            if filters && filters.q
                a(href=("/flashcards/subjects/" + subject._id), class="px-4 py-2.5 border border-gray-300 bg-white text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50") Xoá lọc

        if !flashcards || flashcards.length === 0
            div(class="bg-white rounded-2xl border border-gray-200 p-10 text-center")
                div(class="w-16 h-16 mx-auto rounded-full bg-indigo-50 flex items-center justify-center mb-4")
                    i(data-lucide="layers", class="w-8 h-8 text-indigo-600")
                if filters && filters.q
                    h2(class="text-xl font-semibold text-gray-900") Không tìm thấy bộ flashcard
                    p(class="mt-2 text-gray-500") Không có kết quả cho "#{filters.q}".
                else
                    h2(class="text-xl font-semibold text-gray-900") Chưa có flashcard
                    p(class="mt-2 text-gray-500") Môn học này chưa có bộ flashcard nào.
        else
            div(class="grid grid-cols-1 sm:grid-cols-2 gap-5")
                each f in flashcards
                    a(
                        href=("/flashcards/study/" + f._id),
                        class="group block bg-white rounded-2xl border border-gray-200 hover:border-indigo-300 hover:shadow-lg transition-all p-6"
                    )
                        div(class="flex items-start justify-between gap-3")
                            div(class="w-12 h-12 rounded-xl bg-indigo-50 flex items-center justify-center flex-shrink-0")
                                i(data-lucide=(f.mode === 'theory' ? 'lightbulb' : 'languages'), class="w-6 h-6 text-indigo-600")
                            div(class="flex flex-wrap justify-end gap-2")
                                if f.mode === 'theory'
                                    span(class="px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-medium") Học lý thuyết
                                else
                                    span(class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-medium")= "Học ngoại ngữ · " + languageName(f.language)
                                if f.isPublished === false
                                    span(class="px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 text-xs font-medium") Chưa công khai
                        h2(class="mt-4 text-lg font-bold text-gray-900 group-hover:text-indigo-600 transition-colors")= f.title
                        if f.description
                            p(class="mt-2 text-sm text-gray-500 line-clamp-2")= f.description
                        div(class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between text-sm")
                            span(class="text-gray-500")
                                i(data-lucide="layers", class="w-4 h-4 inline-block mr-1")
                                | #{f.cardCount || 0} thẻ
                            span(class="font-medium text-indigo-600")
                                | Học ngay
                                i(data-lucide="chevron-right", class="w-4 h-4 inline-block ml-1")
            include ../pagination
