- var b = (typeof brand !== 'undefined' && brand) || { logoUrl: '/images/logo.png', logoAlt: 'Luyện thi CNTT UTC', subText: 'UTC', footerText: null }
doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= title || 'Luyện thi CNTT UTC'

        script(src="https://cdn.tailwindcss.com")
        script(src="https://unpkg.com/lucide@latest")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/pagination.css")

        //- ★ THÊM MATHJAX Ở ĐÂY
        script.
            window.MathJax = {
                tex: {
                    inlineMath: [['$', '$'], ['\\(', '\\)']],
                    displayMath: [['$$', '$$'], ['\\[', '\\]']]
                }
            };
        script(id="MathJax-script", async, src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js")


    body(class="bg-gray-50 text-gray-900 min-h-screen")

        header(class="bg-white border-b border-gray-200 sticky top-0 z-50")
            div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8")
                div(class="h-16 flex items-center justify-between")

                    //- ★ LOGO — mặc định public/images/logo.png; tổ chức (user_key) có thể đặt logo riêng qua `brand`
                    a(class="flex items-center gap-3", href="/")
                        img(
                            src=b.logoUrl
                            alt=b.logoAlt
                            class="w-10 h-10 rounded-xl object-contain"
                        )

                        div(class="hidden sm:block")
                            div(class="font-bold text-gray-900") Luyện thi của MNHA
                            div(class="text-xs text-gray-500 uppercase")= b.subText

                    //- DESKTOP NAVIGATION
                    nav(class="hidden md:flex items-center gap-1")

                        if user

                            //- ===== MENU CHUNG: Môn học / Luyện tập / Lịch sử / Ứng dụng =====
                            a(
                                class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors"
                                href="/subjects"
                            )
                                i(data-lucide="book-open", class="w-4 h-4 inline-block mr-1")
                                | Môn học

                            a(
                                class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors"
                                href="/practice"
                            )
                                i(data-lucide="pencil-line", class="w-4 h-4 inline-block mr-1")
                                | Luyện tập

                            a(
                                class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors"
                                href="/submissions/history"
                            )
                                i(data-lucide="file-check-2", class="w-4 h-4 inline-block mr-1")
                                | Lịch sử

                            a(
                                class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors"
                                href="/apps"
                            )
                                i(data-lucide="layout-grid", class="w-4 h-4 inline-block mr-1")
                                | Ứng dụng

                            //- ===== MENU RIÊNG ADMIN =====
                            if user.role === 'admin'

                                div(class="w-px h-5 bg-gray-200 mx-1")

                                a(
                                    class="px-3 py-2 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50 transition-colors"
                                    href="/admin/dashboard"
                                )
                                    i(data-lucide="layout-dashboard", class="w-4 h-4 inline-block mr-1")
                                    | Dashboard

                                //- QUẢN TRỊ DROPDOWN
                                div(class="relative")
                                    button(
                                        class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors flex items-center gap-1"
                                        id="adminMenuButton"
                                        type="button"
                                        aria-expanded="false"
                                    )
                                        i(data-lucide="settings", class="w-4 h-4")
                                        | Quản trị
                                        i(data-lucide="chevron-down", class="w-3 h-3")

                                    div(
                                        class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl border border-gray-200 shadow-lg overflow-hidden z-50"
                                        id="adminDropdown"
                                    )
                                        a(
                                            class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                            href="/admin/subjects"
                                        )
                                            i(data-lucide="book-open", class="w-4 h-4")
                                            | Quản lý môn học

                                        a(
                                            class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                            href="/admin/lessons"
                                        )
                                            i(data-lucide="layers", class="w-4 h-4")
                                            | Quản lý bài học

                                        div(class="border-t border-gray-100")

                                        a(
                                            class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                            href="/admin/prompts"
                                        )
                                            i(data-lucide="file-cog", class="w-4 h-4")
                                            | Prompt chấm

                                        if isDefaultAdmin
                                            a(
                                                class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                                href="/admin/ai-keys"
                                            )
                                                i(data-lucide="key-round", class="w-4 h-4")
                                                | Google AI Keys
                                        if isDefaultAdmin
                                            a(
                                                class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                                href="/admin/user-keys"
                                            )
                                                i(data-lucide="building-2", class="w-4 h-4")
                                                | Quản lý User Key

                                        a(
                                            class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                            href="/admin/disputes"
                                        )
                                            i(data-lucide="message-square-warning", class="w-4 h-4")
                                            | Khiếu nại

                                        div(class="border-t border-gray-100")

                                        a(
                                            class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                            href="/admin/users"
                                        )
                                            i(data-lucide="users", class="w-4 h-4")
                                            | Người dùng

                                        if isOrgAdmin
                                            a(
                                                class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                                href="/admin/users/connect"
                                            )
                                                i(data-lucide="link-2", class="w-4 h-4")
                                                | Tài khoản kết nối

                                        if canEditLayout
                                            a(
                                                class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                                href="/admin/layout"
                                            )
                                                i(data-lucide="palette", class="w-4 h-4")
                                                | Giao diện

                                        if isDefaultAdmin
                                            a(
                                                class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                                href="/admin/roles"
                                            )
                                                i(data-lucide="shield", class="w-4 h-4")
                                                | Vai trò

                                        if isDefaultAdmin
                                            a(
                                                class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                                href="/admin/audit-log"
                                            )
                                                i(data-lucide="scroll-text", class="w-4 h-4")
                                                | Audit log

                    //- RIGHT SIDE
                    div(class="flex items-center gap-2")

                        if user

                            //- THÔNG BÁO
                            a(
                                class="relative w-10 h-10 rounded-lg flex items-center justify-center text-gray-500 hover:bg-gray-100 hover:text-blue-600 transition-colors"
                                href="/notifications"
                                aria-label="Thông báo"
                            )
                                i(data-lucide="bell", class="w-5 h-5")

                            //- USER MENU
                            div(class="relative")
                                button(
                                    class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-gray-100 transition-colors"
                                    id="userMenuButton"
                                    type="button"
                                    aria-expanded="false"
                                )
                                    div(class="w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center")
                                        span(class="text-sm font-bold text-blue-700")
                                            | #{(user.name || user.email || 'U').charAt(0).toUpperCase()}

                                    div(class="hidden lg:block text-left")
                                        p(class="text-sm font-medium text-gray-900 max-w-32 truncate")
                                            = user.name || user.email

                                        p(class="text-xs text-gray-500")
                                            | #{user.role === 'admin' ? (isOrgAdmin ? 'Quản trị viên tổ chức' : 'Quản trị viên') : (user.role === 'student' ? 'Sinh viên' : 'Chờ duyệt')}

                                    i(data-lucide="chevron-down", class="w-4 h-4 text-gray-400")

                                div(
                                    class="hidden absolute right-0 mt-2 w-52 bg-white rounded-xl border border-gray-200 shadow-lg overflow-hidden z-50"
                                    id="userDropdown"
                                )
                                    div(class="px-4 py-3 border-b border-gray-100")
                                        p(class="text-sm font-medium text-gray-900 truncate")
                                            = user.name || user.email

                                        p(class="text-xs text-gray-500 truncate")
                                            = user.email

                                    //- ★ MENU CHUNG — dùng /practice, /submissions/history
                                    a(
                                        class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                        href="/subjects"
                                    )
                                        i(data-lucide="book-open", class="w-4 h-4")
                                        | Môn học

                                    a(
                                        class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                        href="/practice"
                                    )
                                        i(data-lucide="pencil-line", class="w-4 h-4")
                                        | Luyện tập

                                    a(
                                        class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                        href="/submissions/history"
                                    )
                                        i(data-lucide="file-check-2", class="w-4 h-4")
                                        | Lịch sử nộp

                                    a(
                                        class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                        href="/apps"
                                    )
                                        i(data-lucide="layout-grid", class="w-4 h-4")
                                        | Ứng dụng

                                    //- ADMIN thêm link quản trị
                                    if user.role === 'admin'

                                        div(class="border-t border-gray-100")

                                        a(
                                            class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                            href="/admin/dashboard"
                                        )
                                            i(data-lucide="layout-dashboard", class="w-4 h-4")
                                            | Dashboard

                                        a(
                                            class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                            href="/admin/subjects"
                                        )
                                            i(data-lucide="book-open", class="w-4 h-4")
                                            | Quản lý môn học

                                        a(
                                            class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-gray-50"
                                            href="/admin/lessons"
                                        )
                                            i(data-lucide="layers", class="w-4 h-4")
                                            | Quản lý bài học

                                    div(class="border-t border-gray-100")

                                    a(
                                        class="flex items-center gap-3 px-4 py-3 text-sm text-red-600 hover:bg-red-50"
                                        href="/auth/logout"
                                    )
                                        i(data-lucide="log-out", class="w-4 h-4")
                                        | Đăng xuất

                        else

                            a(
                                class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-blue-600 hover:bg-blue-50"
                                href="/auth/login"
                            )
                                | Đăng nhập

                            a(
                                class="px-3 py-2 rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700"
                                href="/auth/register"
                            )
                                | Đăng ký

                        //- MOBILE BUTTON
                        button(
                            class="md:hidden w-10 h-10 rounded-lg flex items-center justify-center text-gray-600 hover:bg-gray-100"
                            id="mobileMenuButton"
                            type="button"
                            aria-label="Mở menu"
                            aria-expanded="false"
                        )
                            i(data-lucide="menu", class="w-5 h-5")

            //- MOBILE NAV
            div(
                class="hidden md:hidden border-t border-gray-200 bg-white"
                id="mobileMenu"
            )
                div(class="max-w-7xl mx-auto px-4 py-4 space-y-1")

                    if user

                        //- ★ MENU CHUNG
                        a(
                            class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600"
                            href="/subjects"
                        )
                            i(data-lucide="book-open", class="w-5 h-5")
                            | Môn học

                        a(
                            class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600"
                            href="/practice"
                        )
                            i(data-lucide="pencil-line", class="w-5 h-5")
                            | Luyện tập

                        a(
                            class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600"
                            href="/submissions/history"
                        )
                            i(data-lucide="file-check-2", class="w-5 h-5")
                            | Lịch sử nộp

                        a(
                            class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600"
                            href="/apps"
                        )
                            i(data-lucide="layout-grid", class="w-5 h-5")
                            | Ứng dụng

                        a(
                            class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600"
                            href="/notifications"
                        )
                            i(data-lucide="bell", class="w-5 h-5")
                            | Thông báo

                        //- ★ MENU RIÊNG ADMIN
                        if user.role === 'admin'

                            div(class="border-t border-gray-100 my-2")

                            a(
                                class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                href="/admin/dashboard"
                            )
                                i(data-lucide="layout-dashboard", class="w-5 h-5")
                                | Dashboard

                            a(
                                class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                href="/admin/subjects"
                            )
                                i(data-lucide="book-open", class="w-5 h-5")
                                | Quản lý môn học

                            a(
                                class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                href="/admin/lessons"
                            )
                                i(data-lucide="layers", class="w-5 h-5")
                                | Quản lý bài học

                            a(
                                class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                href="/admin/prompts"
                            )
                                i(data-lucide="file-cog", class="w-5 h-5")
                                | Prompt chấm

                            if isDefaultAdmin
                                a(
                                    class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                    href="/admin/ai-keys"
                                )
                                    i(data-lucide="key-round", class="w-5 h-5")
                                    | Google AI Keys
                            if isDefaultAdmin
                                a(
                                    class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                    href="/admin/user-keys"
                                )
                                    i(data-lucide="building-2", class="w-5 h-5")
                                    | Quản lý User Key

                            a(
                                class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                href="/admin/disputes"
                            )
                                i(data-lucide="message-square-warning", class="w-5 h-5")
                                | Khiếu nại

                            a(
                                class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                href="/admin/users"
                            )
                                i(data-lucide="users", class="w-5 h-5")
                                | Người dùng

                            if isOrgAdmin
                                a(
                                    class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                    href="/admin/users/connect"
                                )
                                    i(data-lucide="link-2", class="w-5 h-5")
                                    | Tài khoản kết nối

                            if canEditLayout
                                a(
                                    class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                    href="/admin/layout"
                                )
                                    i(data-lucide="palette", class="w-5 h-5")
                                    | Giao diện

                            if isDefaultAdmin
                                a(
                                    class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                    href="/admin/roles"
                                )
                                    i(data-lucide="shield", class="w-5 h-5")
                                    | Vai trò

                            if isDefaultAdmin
                                a(
                                    class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-indigo-600 hover:bg-indigo-50"
                                    href="/admin/audit-log"
                                )
                                    i(data-lucide="scroll-text", class="w-5 h-5")
                                    | Audit log

                        div(class="border-t border-gray-100 my-2")

                        a(
                            class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50"
                            href="/auth/logout"
                        )
                            i(data-lucide="log-out", class="w-5 h-5")
                            | Đăng xuất

                    else

                        a(
                            class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600"
                            href="/auth/login"
                        )
                            i(data-lucide="log-in", class="w-5 h-5")
                            | Đăng nhập

                        a(
                            class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600"
                            href="/auth/register"
                        )
                            i(data-lucide="user-plus", class="w-5 h-5")
                            | Đăng ký

        //- PAGE CONTENT
        main(class="min-h-[calc(100vh-100px)]")
            block content

        //- FOOTER
        footer(class="bg-white border-t border-gray-200 mt-12")
            div(class="max-w-7xl mx-auto px-4 py-6 text-sm text-gray-500 text-center")
                | © #{new Date().getFullYear()} Luyện thi của MNHA. All rights reserved.
                if b.footerText
                    |  - #{b.footerText}

        //- JAVASCRIPT
        script.
            document.addEventListener('DOMContentLoaded', function () {

                try {
                    if (window.lucide && typeof window.lucide.createIcons === 'function') {
                        window.lucide.createIcons();
                    }
                } catch (e) {
                    console.warn('Lucide error:', e);
                }

                var adminButton = document.getElementById('adminMenuButton');
                var adminDropdown = document.getElementById('adminDropdown');

                var userButton = document.getElementById('userMenuButton');
                var userDropdown = document.getElementById('userDropdown');

                var mobileButton = document.getElementById('mobileMenuButton');
                var mobileMenu = document.getElementById('mobileMenu');

                function closeDropdowns() {
                    if (adminDropdown) adminDropdown.classList.add('hidden');
                    if (userDropdown) userDropdown.classList.add('hidden');
                    if (adminButton) adminButton.setAttribute('aria-expanded', 'false');
                    if (userButton) userButton.setAttribute('aria-expanded', 'false');
                }

                if (adminButton && adminDropdown) {
                    adminButton.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();

                        var isHidden = adminDropdown.classList.contains('hidden');

                        closeDropdowns();

                        if (isHidden) {
                            adminDropdown.classList.remove('hidden');
                            adminButton.setAttribute('aria-expanded', 'true');
                        }
                    });
                }

                if (userButton && userDropdown) {
                    userButton.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();

                        var isHidden = userDropdown.classList.contains('hidden');

                        closeDropdowns();

                        if (isHidden) {
                            userDropdown.classList.remove('hidden');
                            userButton.setAttribute('aria-expanded', 'true');
                        }
                    });
                }

                document.addEventListener('click', function (event) {
                    if (
                        !event.target.closest('#adminDropdown') &&
                        !event.target.closest('#adminMenuButton') &&
                        !event.target.closest('#userDropdown') &&
                        !event.target.closest('#userMenuButton')
                    ) {
                        closeDropdowns();
                    }
                });

                if (mobileButton && mobileMenu) {
                    mobileButton.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();

                        mobileMenu.classList.toggle('hidden');

                        var expanded = !mobileMenu.classList.contains('hidden');

                        mobileButton.setAttribute(
                            'aria-expanded',
                            expanded ? 'true' : 'false'
                        );
                    });
                }

                setTimeout(function () {
                    document.querySelectorAll('.flash-message').forEach(function (msg) {
                        msg.style.transition = 'opacity 0.3s';
                        msg.style.opacity = '0';

                        setTimeout(function () {
                            msg.remove();
                        }, 300);
                    });
                }, 5000);

                document.querySelectorAll('.flash-close').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var msg = btn.closest('.flash-message');

                        if (msg) {
                            msg.remove();
                        }
                    });
                });

            });