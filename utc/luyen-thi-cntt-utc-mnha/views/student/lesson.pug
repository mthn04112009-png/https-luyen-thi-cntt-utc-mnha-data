extends ../layout

block content
    style.
        .lesson-page {
            max-width: 1400px;
            margin: 28px auto 60px;
            padding: 0 4%;
        }
        .lesson-page * { box-sizing: border-box; }

        .ai-bar {
            background: #fff;
            border: 1px solid #e3e3e3;
            border-radius: 9px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            padding: 14px 16px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            flex-wrap: wrap;
        }
        .ai-bar-info {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }
        .ai-icon {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: #f8e9ec;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            font-size: 18px;
        }
        .ai-title { font-weight: 800; font-size: 14px; }
        .ai-desc { color: #6f6f6f; font-size: 12px; }
        .ai-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid #e3e3e3;
            background: #f8fafc;
            color: #64748b;
            white-space: nowrap;
        }
        .ai-status-pill .dot {
            width: 9px; height: 9px;
            border-radius: 50%;
            background: #94a3b8;
        }
        .ai-status-pill.checking {
            background: #eff6ff; color: #2563eb; border-color: #bfdbfe;
        }
        .ai-status-pill.checking .dot {
            background: #2563eb;
            animation: pulse 1s infinite;
        }
        .ai-status-pill.connected {
            background: #f0fdf4; color: #16834b; border-color: #bbf7d0;
        }
        .ai-status-pill.connected .dot { background: #16834b; }
        .ai-status-pill.error {
            background: #fef2f2; color: #dc2626; border-color: #fecaca;
        }
        .ai-status-pill.error .dot { background: #dc2626; }
        @keyframes pulse {
            0% { opacity: 1; } 50% { opacity: .35; } 100% { opacity: 1; }
        }

        .ai-selectors {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .ai-selectors .field {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .ai-selectors label { font-weight: 700; font-size: 13px; }
        .ai-selectors select {
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #e3e3e3;
            background: white;
            font-size: 13px;
            outline: none;
            max-width: 260px;
        }
        .ai-selectors select:disabled {
            background: #f1f5f9;
            cursor: not-allowed;
            opacity: 0.7;
        }

        .btn-outline {
            background: #f3f4f6;
            border: 1px solid #e3e3e3;
            padding: 8px 14px;
            border-radius: 7px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            color: #334155;
        }
        .btn-outline:hover { background: #e5e7eb; }
        .btn-outline:disabled { opacity: .5; cursor: not-allowed; }

        .btn-check {
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #dbeafe;
            padding: 8px 12px;
            border-radius: 7px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
        }
        .btn-check:hover { background: #dbeafe; }
        .btn-check:disabled { opacity: .6; cursor: not-allowed; }

        .lesson-header {
            background: white;
            border: 1px solid #e3e3e3;
            border-left: 5px solid #a61c2f;
            border-radius: 10px;
            padding: 20px 24px;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }
        .lesson-header h1 {
            color: #a61c2f;
            font-size: 23px;
            font-weight: 800;
            margin: 0 0 4px 0;
        }
        .lesson-header p { color: #6f6f6f; font-size: 14px; margin: 0; }

        .lesson-layout {
            display: grid;
            grid-template-columns: minmax(0, .95fr) minmax(0, 1.25fr);
            gap: 20px;
            align-items: start;
        }
        .panel {
            background: white;
            border: 1px solid #e3e3e3;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            overflow: hidden;
        }
        .panel-head {
            padding: 18px 22px;
            border-bottom: 1px solid #e3e3e3;
            background: linear-gradient(135deg, #fff, #fafafa);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }
        .panel-head h3 { color: #a61c2f; font-size: 18px; margin: 0; }
        .panel-head span { color: #6f6f6f; font-size: 13px; }
        .panel-body { padding: 22px; }

        .timer {
            background: #fff1f2; color: #a61c2f; border: 1px solid #fecdd3;
            padding: 7px 12px; border-radius: 7px;
            font-weight: 800; font-size: 14px;
            min-width: 67px; text-align: center;
            font-variant-numeric: tabular-nums;
        }
        .timer.waiting { background: #f8fafc; color: #64748b; border-color: #cbd5e1; }
        .timer.warning { background: #fff7ed; color: #d97706; border-color: #fed7aa; }
        .timer.danger { background: #fef2f2; color: #dc2626; border-color: #fecaca; }
        .timer.finished { background: #fef2f2; color: #dc2626; border-color: #fecaca; }
        .timer.finished { animation: pulse 1s infinite; }

        .writing-input {
            width: 100%; min-height: 480px; resize: vertical;
            border: 1px solid #d7d7d7; border-radius: 8px;
            padding: 20px; outline: none;
            font-family: inherit; font-size: 16px; line-height: 1.8;
            color: #222;
            background: repeating-linear-gradient(to bottom, #fff 0, #fff 31px, #eeeeee 32px);
        }
        .writing-input:focus {
            border-color: #a61c2f;
            box-shadow: 0 0 0 3px rgba(166,28,47,0.08);
        }
        .writing-input:disabled { background-color: #f1f5f9; cursor: not-allowed; }

        .writing-info {
            display: flex; justify-content: space-between;
            gap: 15px; margin-top: 12px;
            color: #6f6f6f; font-size: 13px;
        }
        .word-count { font-weight: 700; }
        .word-count.good { color: #16834b; }
        .word-count.low { color: #d97706; }

        .actions { display: flex; gap: 10px; margin-top: 18px; }
        .btn-submit {
            flex: 1; min-height: 48px; padding: 12px 20px;
            border-radius: 7px; background: #a61c2f; color: white;
            font-size: 15px; font-weight: 800;
            border: none; cursor: pointer;
        }
        .btn-submit:hover { background: #861426; }
        .btn-submit:disabled { background: #999; cursor: not-allowed; }

        .lock-msg {
            display: none; margin-bottom: 12px; padding: 10px 13px;
            border-radius: 7px; background: #eff6ff;
            border: 1px solid #bfdbfe; color: #1d4ed8;
            font-size: 13px; font-weight: 700;
        }
        .lock-msg.show { display: block; }
        .lock-msg.timeup {
            background: #fef2f2; border-color: #fecaca; color: #dc2626;
        }

        .result-box {
            display: none; margin-top: 20px;
            border: 1px solid #e3e3e3; border-radius: 9px;
            overflow: hidden; background: white;
        }
        .result-box.show { display: block; }
        .result-head {
            padding: 17px 20px; background: #fafafa;
            border-bottom: 1px solid #e3e3e3;
        }
        .result-head h3 { color: #a61c2f; font-size: 17px; margin: 0; }
        .result-body { padding: 20px; }

        .overall {
            display: flex; align-items: center;
            gap: 15px; margin-bottom: 20px;
        }
        .score-circle {
            width: 70px; height: 70px; border-radius: 50%;
            background: #f8e9ec; color: #a61c2f;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; font-weight: 900;
        }
        .score-meta { color: #6f6f6f; font-size: 13px; }
        .score-meta strong { display: block; color: #222; font-size: 17px; }

        .feedback {
            margin-top: 15px; padding: 15px;
            background: #f8fafc; border: 1px solid #e2e8f0;
            border-radius: 7px; font-size: 14px;
        }
        .feedback h4 { margin: 0 0 7px 0; color: #334155; }

        .sample-box {
            margin-top: 20px; padding: 18px;
            background: #f0fdf4; border: 1px solid #bbf7d0;
            border-radius: 9px;
        }
        .sample-box h3 { color: #166534; margin: 0 0 10px 0; font-size: 16px; }
        .sample-box pre {
            white-space: pre-wrap; font-family: inherit;
            font-size: 14px; color: #14532d; margin: 0;
        }

        /* ===== TAB: NHẬP CHỮ / VẼ TAY (JS Paint) ===== */
        .write-tabs {
            display: flex; gap: 8px; margin-bottom: 14px;
            border-bottom: 2px solid #eeeeee;
        }
        .write-tab {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 9px 16px; margin-bottom: -2px;
            background: transparent; border: none;
            border-bottom: 3px solid transparent;
            font-size: 14px; font-weight: 800; color: #64748b;
            cursor: pointer;
        }
        .write-tab:hover { color: #a61c2f; }
        .write-tab.active { color: #a61c2f; border-bottom-color: #a61c2f; }
        .write-badge {
            display: none; min-width: 20px; padding: 1px 7px;
            border-radius: 12px; font-size: 11px; font-weight: 800;
            background: #dcfce7; color: #166534;
        }
        .write-badge.show { display: inline-block; }
        .write-pane { display: none; }
        .write-pane.active { display: block; }
        .draw-hint {
            margin-top: 10px; padding: 9px 12px; border-radius: 7px;
            background: #f5f3ff; border: 1px solid #ddd6fe;
            color: #5b21b6; font-size: 12.5px; line-height: 1.5;
        }

        /* ===== AUDIO HẾT GIỜ ===== */
        .audio-bar {
            background: linear-gradient(135deg, #fff7ed, #ffedd5);
            border: 1px solid #fed7aa;
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            box-shadow: 0 6px 18px rgba(217,119,6,0.08);
        }
        .audio-bar-icon {
            width: 38px; height: 38px;
            border-radius: 50%;
            background: #ffedd5;
            border: 1px solid #fed7aa;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }
        .audio-bar-info { flex: 1; min-width: 200px; }
        .audio-bar-info .title {
            font-weight: 800; font-size: 13px; color: #9a3412;
        }
        .audio-bar-info .desc {
            font-size: 12px; color: #c2410c;
        }
        .audio-bar audio {
            height: 38px;
            max-width: 100%;
            outline: none;
        }
        .audio-bar.locked {
            opacity: 0.75;
            filter: grayscale(0.15);
        }
        .audio-bar.locked audio {
            pointer-events: none;
        }
        .audio-badge {
            display: inline-block;
            margin-left: 6px;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 800;
            background: #fecaca;
            color: #7f1d1d;
        }
        .audio-bar.unlocked .audio-badge {
            background: #bbf7d0; color: #14532d;
        }

        @media (max-width: 1000px) {
            .lesson-layout { grid-template-columns: 1fr; }
            .writing-panel { order: -1; }
        }
        @media (max-width: 700px) {
            .panel-head { flex-direction: column; align-items: flex-start; }
            .actions { flex-direction: column; }
            .ai-selectors { width: 100%; }
            .ai-selectors .field { width: 100%; }
            .ai-selectors select { flex: 1; max-width: none; }
            .audio-bar audio { width: 100%; }
        }

    link(rel="stylesheet", href="/css/drawing-pad.css")

    div(class="lesson-page")

        div(class="mb-5")
            a(
                href="/practice"
                class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700"
            )
                i(data-lucide="arrow-left", class="w-4 h-4")
                | Quay lại luyện tập

        if isAdminView
            div(class="mb-5 p-3 rounded-lg bg-yellow-50 border border-yellow-200 text-yellow-800 text-sm")
                | 👁 Bạn đang xem với tư cách Admin. Có thể nộp thử để kiểm tra prompt chấm.

        if resolvedPrompt
            - var hasWarning = isAdminView && promptUnknownPlaceholders && promptUnknownPlaceholders.length
            div(
                class="mb-5 p-3 rounded-lg border text-sm " + (hasWarning ? "bg-red-50 border-red-200 text-red-800" : (resolvedPrompt.isFallback ? "bg-gray-50 border-gray-200 text-gray-700" : "bg-indigo-50 border-indigo-200 text-indigo-800"))
            )
                div(class="flex items-center flex-wrap gap-2")
                    strong 🧠 Prompt chấm đang dùng cho bài này:
                    span= resolvedPrompt.name
                    if resolvedPrompt.scope
                        span(class="text-xs opacity-75")
                            | (gán ở cấp: #{resolvedPrompt.scope === 'lesson' ? 'bài học này' : resolvedPrompt.scope === 'subject' ? 'môn học' : resolvedPrompt.scope === 'fallback' ? 'fallback mặc định' : 'global'})
                    if isAdminView && resolvedPrompt._id
                        a(
                            href="/admin/prompts/" + resolvedPrompt._id + "/edit"
                            class="text-xs underline font-semibold"
                            target="_blank"
                        )
                            | Sửa prompt này →
                if hasWarning
                    div(class="mt-1 text-xs font-semibold")
                        | ⚠️ Prompt có biến chưa nhận diện: #{promptUnknownPlaceholders.join(', ')} — vào link "Sửa prompt này" ở trên để sửa tên biến.

        //- ============================================
        //- AUDIO BÁO HẾT GIỜ
        //-   - Hiển thị công khai cho cả admin và student
        //-   - CHẶN phát khi chưa hết giờ
        //-   - Tự động phát lặp liên tục khi hết giờ
        //-   - Không phát nếu đã nộp bài sớm
        //- ============================================
        div(id="audioBar", class="audio-bar locked")
            div(class="audio-bar-icon") 🔊
            div(class="audio-bar-info")
                div(class="title")
                    | Âm thanh báo hết giờ
                    span(id="audioBadge", class="audio-badge") 🔒 Đang khoá
                div(class="desc")
                    | Chỉ tự động phát lặp khi đồng hồ về 00:00 — tự tắt khi bạn nộp bài.

            audio(
                id="timeUpAudio"
                controls
                preload="auto"
                src="/musics/iphone-17-pro-max.mp3"
            )
                | Trình duyệt của bạn không hỗ trợ thẻ audio.

        div(class="ai-bar")
            div(class="ai-bar-info")
                div(class="ai-icon") 🤖
                div
                    div(class="ai-title") Trạng thái AI chấm bài
                    if aiLabel
                        div(class="ai-desc", id="aiLabelText", style="font-weight:600")= '🤖 ' + aiLabel
                    div(class="ai-desc", id="aiDesc") Chưa kiểm tra kết nối.

            div(class="ai-selectors")
                div(class="field")
                    label(for="aiKeySelect") 🔑 AI Key:
                    select(id="aiKeySelect")
                        option(value="") — Mặc định hệ thống —

                div(class="field")
                    label(for="modelSelect") 🤖 Model:
                    select(id="modelSelect", disabled)
                        option(value="") — Chọn AI Key trước —

                button(
                    type="button"
                    class="btn-outline"
                    onclick="randomModel()"
                    title="Chọn ngẫu nhiên model"
                )
                    | 🎲

            div(class="flex items-center gap-2")
                div(id="aiStatusPill", class="ai-status-pill")
                    span(class="dot")
                    span(id="aiStatusText") Chưa kiểm tra

                button(
                    type="button"
                    id="aiCheckBtn"
                    class="btn-check"
                    onclick="checkAIConnection()"
                )
                    | 🔄 Kiểm tra AI

        div(class="lesson-header")
            h1= lesson.title
            p
                if lesson.subject
                    = (lesson.subject.name || '') + ' • '
                | Nộp bài — AI chấm tự động

        div(class="lesson-layout")

            div(class="panel")
                div(class="panel-head")
                    h3 Đề bài
                    span #{lesson.duration || 20} phút

                div(class="panel-body")
                    if lesson.contentHtml
                        div(class="prose prose-sm max-w-none text-gray-800")
                            != lesson.contentHtml
                    else
                        p(class="text-gray-500 italic")
                            | (Chưa có nội dung đề bài)

            div(class="panel writing-panel")
                div(class="panel-head")
                    h3 ✍️ Bài viết của bạn
                    div(id="timer", class="timer waiting")
                        = String(lesson.duration || 20).padStart(2, '0') + ':00'

                div(class="panel-body")
                    div(id="lockMessage", class="lock-msg show")
                        | 🔒 Hãy kết nối AI thành công để bắt đầu tính giờ.

                    //- ★ Hai phần bài làm: nhập chữ + vẽ tay (JS Paint). Có phần nào thì chấm phần đó;
                    //-   có cả hai thì AI chấm cả hai (bản vẽ được AI đọc/phân tích ảnh trước).
                    div(class="write-tabs", role="tablist")
                        button(type="button", id="tabText", class="write-tab active", role="tab")
                            | ⌨️ Nhập chữ
                            span(id="textBadge", class="write-badge") ✓
                        button(type="button", id="tabDraw", class="write-tab", role="tab")
                            | 🎨 Vẽ tay (JS Paint)
                            span(id="drawBadge", class="write-badge") ✓

                    div(id="textPane", class="write-pane active")
                        textarea(
                            id="writingInput"
                            class="writing-input"
                            placeholder="Nhập bài làm của bạn vào đây..."
                            disabled
                        )

                        div(class="writing-info")
                            span(id="wordCount", class="word-count low") 0 từ
                            span Mục tiêu: xem đề bài

                    div(id="drawPane", class="write-pane")
                        //- ★ Tải ảnh chụp bài viết tay: Cloudinary kiểm duyệt → CNN chuyển thành nét vẽ trên bảng
                        div(class="photo-bar")
                            input(type="file", id="photoInput", accept="image/png,image/jpeg,image/webp", hidden)
                            button(type="button", id="photoBtn", class="photo-btn", disabled)
                                | 📷 Tải ảnh viết tay lên
                            span(id="photoStatus", class="photo-status")
                        div(id="drawingPad")
                        div(class="draw-hint")
                            | 🎨 Vẽ sơ đồ, hình, công thức hoặc viết tay tuỳ ý. Dùng <b>🔍+ / 🔍−</b> để phóng to/thu nhỏ và <b>▲ ▼ ◀ ▶</b> (hoặc ✋ kéo) để di chuyển sang vùng khác của tờ giấy.
                            |  Khi nộp, AI sẽ <b>đọc hiểu bản vẽ trước</b> rồi chấm cùng phần nhập chữ. Không vẽ gì thì phần này được bỏ qua.

                    div(class="actions")
                        button(
                            type="button"
                            id="clearBtn"
                            class="btn-outline"
                            onclick="clearWriting()"
                        )
                            | 🗑 Xoá bài

                        button(
                            type="button"
                            id="submitBtn"
                            class="btn-submit"
                            onclick="submitWriting()"
                            disabled
                        )
                            | 🚀 Nộp bài & chấm AI

                    div(id="resultBox", class="result-box")
                        div(class="result-head")
                            h3 🤖 Kết quả chấm bài AI
                        div(id="resultBody", class="result-body")

        if lesson.sampleSolution && lastSubmission && lastSubmission.status === 'graded'
            div(class="bg-white border border-green-200 rounded-2xl p-6 shadow-sm mb-6")
                h3(class="text-lg font-bold text-green-900 mb-3 flex items-center gap-2")
                    i(data-lucide="lightbulb", class="w-5 h-5 text-green-600")
                    | Lời giải mẫu
                div(class="prose prose-sm max-w-none text-green-900 p-4 rounded-lg bg-green-50 border border-green-100")
                    != lesson.sampleSolution

        if lastSubmission
            div(class="panel mt-5")
                div(class="panel-head")
                    h3 Bài nộp gần nhất
                    a(
                        href=`/submissions/${lastSubmission._id}`
                        class="text-sm font-medium text-indigo-600 hover:text-indigo-700"
                    )
                        | Xem chi tiết →

                div(class="panel-body")
                    div(class="flex items-center gap-4 mb-3 flex-wrap")
                        if lastSubmission.status === 'graded'
                            span(class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-700")
                                i(data-lucide="check-circle-2", class="w-4 h-4")
                                | Đã chấm: #{lastSubmission.score}
                        else if lastSubmission.status === 'grading' || lastSubmission.status === 'pending'
                            span(class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-700")
                                | Đang chấm...
                        else if lastSubmission.status === 'failed'
                            span(class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-700")
                                | Chấm lỗi

                        if lastSubmission.model
                            span(class="text-xs text-gray-500")
                                | 🤖 #{lastSubmission.model}
                        if lastSubmission.aiLabel
                            span(class="text-xs text-gray-500")
                                | 🔑 #{lastSubmission.aiLabel}

                        span(class="text-xs text-gray-500")
                            = new Date(lastSubmission.createdAt).toLocaleString('vi-VN')

                    if lastSubmission.feedback
                        div(class="p-3 rounded-lg bg-gray-50 text-sm text-gray-700 whitespace-pre-wrap")
                            = lastSubmission.feedback

    script(src="/js/drawingPad.js")
    script(src="/js/photoToPaint.js")

    script.
        (function () {
            const LESSON_ID = "!{lesson._id}";
            const API_AI = "/api/ai";
            // ★ provider thật của từng key lấy từ MongoDB (server truyền xuống)
            const AI_KEY_PROVIDERS = !{JSON.stringify(aiKeyProviders || {}).replace(/</g, "\\u003c")};

            let aiConnected = false;
            let checkingAI = false;
            let submitting = false;
            let submitted = false;

            const TIMER_TOTAL = (!{lesson.duration || 20}) * 60;
            let timeLeft = TIMER_TOTAL;
            let timerInterval = null;

            const textarea = document.getElementById("writingInput");
            const wordCountEl = document.getElementById("wordCount");
            const timerEl = document.getElementById("timer");
            const submitBtn = document.getElementById("submitBtn");
            const clearBtn = document.getElementById("clearBtn");
            const lockMsg = document.getElementById("lockMessage");
            const aiStatusPill = document.getElementById("aiStatusPill");
            const aiStatusText = document.getElementById("aiStatusText");
            const aiDesc = document.getElementById("aiDesc");
            // ★ Nhãn "🤖 Gemini / vilao.ai: {tên}" ở khung trạng thái: server chỉ render nhãn mặc định,
            //   nên phải cập nhật theo key đang chọn trong dropdown.
            const aiLabelText = document.getElementById("aiLabelText");
            const defaultAiLabelText = aiLabelText ? aiLabelText.textContent : "";
            function isVilao(p) {
                return /vilao/i.test(String(p || ""));
            }
            function providerName(provider) {
                return isVilao(provider) ? "vilao.ai" : "Gemini";
            }
            // DB (AI_KEY_PROVIDERS) được ưu tiên; /api/ai/keys chỉ là phương án dự phòng
            function resolveKeyProvider(k) {
                const fromDb = AI_KEY_PROVIDERS[String(k._id)];
                return isVilao(fromDb) || isVilao(k.provider) ? "vilao" : "gemini";
            }
            function updateAiLabelFromSelection() {
                if (!aiLabelText) return;
                const o = aiKeySelect.options[aiKeySelect.selectedIndex];
                const label = aiKeySelect.value && o ? o.getAttribute("data-label") : "";
                aiLabelText.textContent = label ? "🤖 " + label : defaultAiLabelText;
            }
            const resultBox = document.getElementById("resultBox");
            const resultBody = document.getElementById("resultBody");
            const aiKeySelect = document.getElementById("aiKeySelect");
            const modelSelect = document.getElementById("modelSelect");
            const timeUpAudio = document.getElementById("timeUpAudio");
            const audioBar = document.getElementById("audioBar");
            const audioBadge = document.getElementById("audioBadge");

            // ============================================
            // ★ VẼ TAY (JS Paint) + TAB
            // ============================================
            const tabText = document.getElementById("tabText");
            const tabDraw = document.getElementById("tabDraw");
            const textPane = document.getElementById("textPane");
            const drawPane = document.getElementById("drawPane");
            const textBadge = document.getElementById("textBadge");
            const drawBadge = document.getElementById("drawBadge");
            let drawFitted = false;
            let lastSubmittedHadDrawing = false;

            // ★ Tải ảnh viết tay (khai báo TRƯỚC DrawingPad.create vì onChange → updateBadges chạy ngay lúc create)
            const photoInput = document.getElementById("photoInput");
            const photoBtn = document.getElementById("photoBtn");
            const photoStatus = document.getElementById("photoStatus");
            let photoCfg = { enabled: false, maxBytes: 10 * 1024 * 1024 };
            let photoBusy = false;
            let photoToken = null; // token Cloudinary đã duyệt ảnh đang dùng (server kiểm lại khi nộp)

            function syncPhotoBtn() {
                if (!photoBtn) return;
                const locked = !drawPad || drawPad.isDisabled();
                photoBtn.disabled = photoBusy || !photoCfg.enabled || locked;
                photoBtn.title = !photoCfg.enabled
                    ? "Máy chủ chưa bật tính năng tải ảnh"
                    : (locked ? "Hãy kết nối AI để mở khoá phần làm bài" : "Chọn ảnh chụp bài viết tay");
            }
            function setPhotoStatus(kind, text) {
                photoStatus.className = "photo-status" + (kind ? " ps-" + kind : "");
                photoStatus.textContent = text || "";
            }

            function updateBadges() {
                textBadge.classList.toggle("show", !!textarea.value.trim());
                drawBadge.classList.toggle("show", !!(drawPad && drawPad.hasContent()));
                syncPhotoBtn();
            }

            // (khai báo trước: onChange chạy ngay lúc create, lúc đó drawPad còn null)
            let drawPad = null;
            drawPad = DrawingPad.create(document.getElementById("drawingPad"), {
                onChange: updateBadges
            });
            drawPad.setDisabled(true); // mở khi AI kết nối + còn giờ (xem updateLock)

            fetch("/submissions/drawing-upload/config", { cache: "no-store", headers: { "Accept": "application/json" } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                    if (d && d.success) photoCfg = { enabled: !!d.enabled, maxBytes: d.maxBytes || photoCfg.maxBytes };
                    if (!photoCfg.enabled) setPhotoStatus("", "Tải ảnh viết tay chưa được bật trên máy chủ.");
                    syncPhotoBtn();
                })
                .catch(function () { syncPhotoBtn(); });

            function fmtMB(n) { return (n / 1024 / 1024).toFixed(1).replace(/\.0$/, "") + "MB"; }

            async function handlePhoto(file) {
                if (!file || photoBusy) return;
                if (drawPad.isDisabled()) { alert("Hãy kết nối AI trước khi tải ảnh."); return; }
                if (!/^image\/(png|jpeg|webp)$/.test(file.type)) {
                    setPhotoStatus("error", "Chỉ nhận ảnh PNG / JPEG / WEBP.");
                    return;
                }
                if (file.size > photoCfg.maxBytes) {
                    setPhotoStatus("error", "Ảnh nặng " + fmtMB(file.size) + ", tối đa " + fmtMB(photoCfg.maxBytes) + ".");
                    return;
                }
                if (drawPad.hasContent() && !confirm("Ảnh sẽ được thêm đè lên bản vẽ hiện tại (có thể Hoàn tác ↶). Tiếp tục?")) return;

                photoBusy = true;
                syncPhotoBtn();
                try {
                    setPhotoStatus("busy", "⏳ Đang kiểm tra ảnh (kiểm duyệt nội dung)...");
                    const res = await fetch("/submissions/drawing-upload", {
                        method: "POST",
                        headers: { "Content-Type": file.type, "Accept": "application/json" },
                        body: file
                    });
                    let data = null;
                    try { data = await res.json(); } catch (e) { /* server không trả JSON */ }
                    if (!res.ok || !data || !data.success) {
                        throw new Error((data && data.message) || "Không tải được ảnh (HTTP " + res.status + ").");
                    }

                    setPhotoStatus("busy", "🧠 Ảnh hợp lệ — đang chuyển thành nét vẽ (CNN)...");
                    const out = await PhotoToPaint.convert(file, {});
                    if (out.inkRatio < 0.0005) {
                        throw new Error("Không nhận ra nét viết nào trong ảnh. Hãy chụp rõ hơn, đủ sáng, chữ đậm hơn.");
                    }
                    if (out.inkRatio > 0.5) {
                        throw new Error("Ảnh không giống trang viết tay (quá nhiều vùng tối). Hãy chụp thẳng vào trang giấy.");
                    }
                    if (!drawPad.importBitmap(out.canvas)) throw new Error("Không đưa được ảnh vào bảng vẽ.");

                    photoToken = data.token;
                    setPhotoStatus("ok", "✅ Đã đưa ảnh vào bảng vẽ (" + (out.engine === "tfjs" ? "TensorFlow.js" : "JS thuần") + "). Có thể tẩy / vẽ thêm.");
                } catch (e) {
                    setPhotoStatus("error", "❌ " + e.message);
                } finally {
                    photoBusy = false;
                    photoInput.value = "";
                    syncPhotoBtn();
                }
            }
            photoBtn.addEventListener("click", function () { photoInput.click(); });
            photoInput.addEventListener("change", function () { handlePhoto(photoInput.files && photoInput.files[0]); });

            function showTab(which) {
                const isDraw = which === "draw";
                tabText.classList.toggle("active", !isDraw);
                tabDraw.classList.toggle("active", isDraw);
                textPane.classList.toggle("active", !isDraw);
                drawPane.classList.toggle("active", isDraw);
                if (isDraw && !drawFitted) {
                    drawFitted = true;
                    drawPad.fitWidth(); // khung vừa hiện ra mới đo được chiều rộng
                }
            }
            tabText.addEventListener("click", function () { showTab("text"); });
            tabDraw.addEventListener("click", function () { showTab("draw"); });

            // Cờ: đánh dấu việc pause là do hệ thống chủ động (không phải user bấm)
            let intentionalStop = false;
            let blockMsgTimer = null;

            // ============================================
            // AUDIO HELPERS
            // ============================================
            function canPlayAlarm() {
                // Chỉ cho phép phát khi: đã hết giờ VÀ chưa nộp bài VÀ không đang nộp
                return timeLeft <= 0 && !submitted && !submitting;
            }

            function playTimeUpAudio() {
                if (!timeUpAudio) return;
                try {
                    timeUpAudio.loop = true;      // lặp liên tục
                    timeUpAudio.volume = 1.0;
                    timeUpAudio.currentTime = 0;
                    const p = timeUpAudio.play();
                    if (p && typeof p.catch === "function") {
                        p.catch(function (err) {
                            console.warn("Không tự phát được audio hết giờ:", err);
                        });
                    }
                } catch (e) {
                    console.warn("playTimeUpAudio error:", e);
                }
            }

            function stopTimeUpAudio() {
                if (!timeUpAudio) return;
                intentionalStop = true;
                try {
                    timeUpAudio.loop = false;
                    timeUpAudio.pause();
                    timeUpAudio.currentTime = 0;
                } catch (e) { /* noop */ }
                // Cho event 'pause' kịp bỏ qua
                setTimeout(() => { intentionalStop = false; }, 60);
            }

            function updateAudioBarState() {
                if (!audioBar || !audioBadge) return;
                if (canPlayAlarm()) {
                    audioBar.classList.remove("locked");
                    audioBar.classList.add("unlocked");
                    audioBadge.textContent = "🔓 Đã mở khoá";
                } else {
                    audioBar.classList.add("locked");
                    audioBar.classList.remove("unlocked");
                    audioBadge.textContent = submitted ? "✓ Đã nộp" : "🔒 Đang khoá";
                }
            }

            // Chặn mọi nỗ lực phát audio khi chưa hết giờ (hoặc đã nộp bài)
            if (timeUpAudio) {
                timeUpAudio.addEventListener("play", function () {
                    if (!canPlayAlarm()) {
                        // Dừng ngay
                        intentionalStop = true;
                        try {
                            timeUpAudio.pause();
                            timeUpAudio.currentTime = 0;
                        } catch (e) { /* noop */ }
                        setTimeout(() => { intentionalStop = false; }, 60);
                        showBlockedAudioMessage();
                    }
                });

                // Nếu user bấm pause khi đang trong trạng thái hết giờ (chưa nộp)
                // → tự động phát lại để đảm bảo "lặp liên tục"
                timeUpAudio.addEventListener("pause", function () {
                    if (intentionalStop) return;
                    if (canPlayAlarm()) {
                        setTimeout(() => {
                            if (canPlayAlarm() && timeUpAudio.paused) {
                                try {
                                    timeUpAudio.loop = true;
                                    timeUpAudio.play().catch(() => {});
                                } catch (e) { /* noop */ }
                            }
                        }, 400);
                    }
                });
            }

            function showBlockedAudioMessage() {
                if (!lockMsg) return;
                // Chỉ hiện thông báo ngắn, không ghi đè thông báo hết giờ
                if (lockMsg.classList.contains("timeup")) return;
                lockMsg.textContent = "🔒 Âm thanh chỉ tự động phát khi đồng hồ về 00:00 (hết giờ).";
                lockMsg.classList.add("show");
                lockMsg.classList.remove("timeup");
                if (blockMsgTimer) clearTimeout(blockMsgTimer);
                blockMsgTimer = setTimeout(() => {
                    blockMsgTimer = null;
                    updateLock();
                }, 2500);
            }

            // ============================================
            // HELPERS
            // ============================================
            function setAIStatus(type, text, desc) {
                aiStatusPill.classList.remove("checking", "connected", "error");
                if (type) aiStatusPill.classList.add(type);
                aiStatusText.textContent = text;
                if (desc) aiDesc.textContent = desc;
            }

            function countWords(t) {
                if (!t || !t.trim()) return 0;
                return t.trim().split(/\s+/).filter(Boolean).length;
            }

            function updateWordCount() {
                const n = countWords(textarea.value);
                wordCountEl.textContent = n + " từ";
                wordCountEl.classList.remove("good", "low");
                if (n >= 80) wordCountEl.classList.add("good");
                else wordCountEl.classList.add("low");
            }

            function fmtTime(s) {
                const m = Math.floor(s / 60);
                const ss = s % 60;
                return String(m).padStart(2, "0") + ":" + String(ss).padStart(2, "0");
            }

            function updateTimer() {
                timerEl.textContent = fmtTime(Math.max(0, timeLeft));
                timerEl.classList.remove("waiting", "warning", "danger", "finished");
                if (!aiConnected) { timerEl.classList.add("waiting"); return; }
                if (submitted) { timerEl.classList.add("finished"); return; }
                if (timeLeft <= 0) { timerEl.classList.add("finished"); return; }
                if (timeLeft <= 60) { timerEl.classList.add("danger"); return; }
                if (timeLeft <= 300) { timerEl.classList.add("warning"); }
            }

            function startTimer() {
                if (timerInterval || !aiConnected || submitted) return;
                timerInterval = setInterval(() => {
                    if (!aiConnected || submitted) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                        updateTimer();
                        return;
                    }
                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                        updateTimer();
                        onTimeUp();
                        return;
                    }
                    timeLeft--;
                    updateTimer();
                    updateAudioBarState();
                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                        updateTimer();
                        onTimeUp();
                    }
                }, 1000);
            }

            function stopTimer() {
                if (timerInterval) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                }
            }

            function onTimeUp() {
                if (!submitted) {
                    lockMsg.textContent = "⏰ Đã hết thời gian làm bài! Hãy nộp bài ngay.";
                    lockMsg.classList.add("show", "timeup");
                }
                updateAudioBarState();
                // Tự động phát lặp liên tục (chỉ khi chưa nộp bài)
                if (canPlayAlarm()) {
                    playTimeUpAudio();
                }
            }

            function updateLock() {
                if (submitted) {
                    lockMsg.classList.remove("show", "timeup");
                    textarea.disabled = true;
                    drawPad.setDisabled(true);
                    submitBtn.disabled = true;
                    clearBtn.disabled = true;
                    return;
                }
                if (!aiConnected) {
                    lockMsg.textContent = "🔒 Hãy kết nối AI thành công để bắt đầu tính giờ.";
                    lockMsg.classList.add("show");
                    lockMsg.classList.remove("timeup");
                    textarea.disabled = true;
                    drawPad.setDisabled(true);
                    submitBtn.disabled = true;
                    clearBtn.disabled = false;
                    return;
                }
                if (timeLeft <= 0) {
                    lockMsg.textContent = "⏰ Đã hết thời gian làm bài! Hãy nộp bài ngay.";
                    lockMsg.classList.add("show", "timeup");
                    textarea.disabled = true;
                    drawPad.setDisabled(true);
                    submitBtn.disabled = false;
                    clearBtn.disabled = true;
                    return;
                }
                lockMsg.classList.remove("show", "timeup");
                textarea.disabled = false;
                drawPad.setDisabled(false);
                submitBtn.disabled = false;
                clearBtn.disabled = false;
            }

            function escapeHTML(s) {
                const d = document.createElement("div");
                d.textContent = String(s ?? "");
                return d.innerHTML;
            }

            // ============================================
            // LOAD MODELS
            // ============================================
            // ★ vilao.ai: danh sách model tách theo nhà cung cấp.
            //   /api/ai/models có thể trả thêm vilaoModels + vilaoDefaultModel;
            //   nếu không có thì mọi key dùng danh sách Gemini như cũ.
            const modelLists = { gemini: [], vilao: [] };
            const defaultModels = { gemini: "", vilao: "" };
            let currentModelProvider = "gemini";

            // extraModel: model gắn trên key nhưng không nằm trong danh sách có sẵn → vẫn hiện
            function fillModelOptions(provider, extraModel) {
                const useVilao = provider === "vilao" && modelLists.vilao.length;
                const list = (useVilao ? modelLists.vilao : modelLists.gemini).slice();
                currentModelProvider = useVilao ? "vilao" : "gemini";
                if (extraModel && !list.includes(extraModel)) list.unshift(extraModel);
                modelSelect.innerHTML = '<option value="">— Chọn AI Key trước —</option>';
                list.forEach((m) => {
                    const opt = document.createElement("option");
                    opt.value = m;
                    opt.textContent = m;
                    modelSelect.appendChild(opt);
                });
                modelSelect.dataset.default = defaultModels[currentModelProvider] || "";
            }

            function selectModelValue(v) {
                for (let i = 0; i < modelSelect.options.length; i++) {
                    if (modelSelect.options[i].value === v) {
                        modelSelect.selectedIndex = i;
                        return true;
                    }
                }
                return false;
            }

            async function loadModels() {
                try {
                    const res = await fetch(API_AI + "/models");
                    const data = await res.json();
                    if (data.success) {
                        modelLists.gemini = data.models || [];
                        modelLists.vilao = data.vilaoModels || [];
                        defaultModels.gemini = data.defaultModel || "";
                        defaultModels.vilao = data.vilaoDefaultModel || "";
                        fillModelOptions("gemini");
                    }
                } catch (e) {
                    console.warn("loadModels:", e);
                }
            }

            // ============================================
            // LOAD AI KEYS
            // ============================================
            async function loadKeys() {
                try {
                    const res = await fetch(API_AI + "/keys");
                    const data = await res.json();

                    if (data.success && Array.isArray(data.keys)) {
                        aiKeySelect.innerHTML =
                            '<option value="">— Mặc định hệ thống —</option>';

                        data.keys.forEach((k) => {
                            const opt = document.createElement("option");
                            opt.value = k._id;
                            opt.setAttribute("data-model", k.model || "");
                            const keyProvider = resolveKeyProvider(k);
                            opt.setAttribute("data-provider", keyProvider);

                            // ★ vilao.ai: "Gemini: {tên}" / "vilao.ai: {tên}"
                            const baseLabel = providerName(keyProvider) + ": " + k.name;
                            opt.setAttribute("data-label", baseLabel);
                            let label = baseLabel;
                            if (k.model) label += " (" + k.model + ")";

                            if (!k.usable) {
                                if (!k.isActive) {
                                    label += " [Đã tắt]";
                                } else if (k.isDisabledTemp) {
                                    if (k.disabledUntil) {
                                        const remain = Math.ceil(
                                            (new Date(k.disabledUntil) - new Date()) / 60000
                                        );
                                        if (remain > 0) {
                                            label += " [Tạm nghỉ ~" + remain + "p]";
                                        } else {
                                            label += " [Tạm nghỉ]";
                                        }
                                    } else {
                                        label += " [Tạm nghỉ]";
                                    }
                                }
                                opt.disabled = true;
                            }

                            opt.textContent = label;
                            aiKeySelect.appendChild(opt);
                        });

                        const firstUsable = data.keys.find((k) => k.usable);
                        if (firstUsable) {
                            aiKeySelect.value = firstUsable._id;
                            syncModelFromKey();
                        } else {
                            modelSelect.disabled = false;
                            const def = modelSelect.dataset.default;
                            if (def) {
                                for (let i = 0; i < modelSelect.options.length; i++) {
                                    if (modelSelect.options[i].value === def) {
                                        modelSelect.selectedIndex = i;
                                        break;
                                    }
                                }
                            }
                        }
                    }
                } catch (e) {
                    console.warn("loadKeys:", e);
                }
            }

            function syncModelFromKey() {
                updateAiLabelFromSelection();
                const opt = aiKeySelect.options[aiKeySelect.selectedIndex];
                const keyModel = opt ? opt.getAttribute("data-model") || "" : "";
                const keyProvider = aiKeySelect.value && opt
                    ? opt.getAttribute("data-provider") || "gemini"
                    : "gemini";

                // ★ Mỗi lần đổi key: nạp lại ĐÚNG danh sách model của nhà cung cấp key đó
                //   (Gemini ↔ danh sách Gemini, vilao.ai ↔ danh sách vilao.ai)
                fillModelOptions(keyProvider, keyProvider === "vilao" ? keyModel : "");
                modelSelect.disabled = false;

                if (keyModel && selectModelValue(keyModel)) {
                    // Key vilao.ai đã gắn model (đã subscribe) → server luôn dùng model này, khoá lại
                    if (keyProvider === "vilao") modelSelect.disabled = true;
                    return;
                }
                const def = modelSelect.dataset.default;
                if (def) selectModelValue(def);
            }

            window.randomModel = function () {
                if (modelSelect.disabled) return;
                const opts = modelSelect.options;
                if (!opts.length) return;
                let idx;
                do {
                    idx = Math.floor(Math.random() * opts.length);
                } while (!opts[idx].value && opts.length > 1);
                modelSelect.selectedIndex = idx;
            };

            // ============================================
            // CHECK AI
            // ============================================
            window.checkAIConnection = async function () {
                if (checkingAI) return;
                checkingAI = true;

                const btn = document.getElementById("aiCheckBtn");
                btn.disabled = true;
                btn.textContent = "Đang kiểm tra...";
                setAIStatus("checking", "Đang kiểm tra", "Đang kết nối AI...");

                try {
                    const model = modelSelect.value || "";
                    const aiKeyId = aiKeySelect.value || "";

                    const params = new URLSearchParams();
                    if (model) params.append("model", model);
                    if (aiKeyId) params.append("aiKeyId", aiKeyId);

                    const url = API_AI + "/ai-status?" + params.toString();
                    const res = await fetch(url, { cache: "no-store" });
                    const data = await res.json();

                    if (!res.ok || !data.success || data.connected !== true) {
                        throw new Error(data.message || "AI chưa kết nối.");
                    }

                    aiConnected = true;
                    if (aiLabelText && (data.aiLabel || data.provider)) {
                        const realLabel = data.aiLabel ||
                            providerName(data.provider) + (data.keyName ? ": " + data.keyName : "");
                        aiLabelText.textContent = "🤖 " + realLabel;
                    }
                    const keyLabel = data.keyName ? " • Key: " + data.keyName : "";
                    setAIStatus(
                        "connected",
                        "Đã kết nối (" + (data.model || "") + ")",
                        "AI hoạt động" + keyLabel
                    );
                    updateLock();
                    startTimer();
                } catch (err) {
                    aiConnected = false;
                    setAIStatus("error", "Chưa kết nối", err.message);
                    updateLock();
                    updateTimer();
                } finally {
                    checkingAI = false;
                    btn.disabled = false;
                    btn.textContent = "🔄 Kiểm tra AI";
                }
            };

            // ============================================
            // SUBMIT
            // ============================================
            window.submitWriting = async function () {
                if (submitting || submitted) return;
                if (!aiConnected) {
                    alert("AI chưa kết nối. Hãy bấm 'Kiểm tra AI' trước.");
                    return;
                }

                const text = textarea.value.trim();
                const words = countWords(text);

                // ★ Xuất ảnh bản vẽ (null = không vẽ gì → bỏ qua phần vẽ tay)
                let drawing = null;
                if (drawPad.hasContent()) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = "🖼️ Đang nén bản vẽ...";
                    try {
                        drawing = await drawPad.exportImage();
                    } catch (e) {
                        alert("❌ " + e.message);
                        submitBtn.disabled = false;
                        submitBtn.textContent = "🚀 Nộp bài & chấm AI";
                        return;
                    }
                }

                if (!text && !drawing) {
                    alert("Bạn chưa làm bài: hãy nhập chữ hoặc vẽ tay (hoặc cả hai).");
                    submitBtn.disabled = false;
                    submitBtn.textContent = "🚀 Nộp bài & chấm AI";
                    if (!textarea.disabled) textarea.focus();
                    return;
                }

                // Chỉ nhắc "quá ngắn" khi bài chỉ có chữ (có bản vẽ thì không cần)
                if (text && !drawing && words < 30) {
                    if (!confirm("Bài chỉ có " + words + " từ. Vẫn nộp?")) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = "🚀 Nộp bài & chấm AI";
                        return;
                    }
                }

                submitting = true;
                submitBtn.disabled = true;
                submitBtn.textContent = drawing ? "🤖 AI đang đọc hình vẽ & chấm..." : "🤖 AI đang chấm...";
                setAIStatus(
                    "checking",
                    "Đang chấm bài",
                    drawing ? "AI đọc hiểu bản vẽ trước, rồi chấm cả chữ + hình..." : "AI đang phân tích..."
                );

                // Khoá ô nhập + bảng vẽ trong lúc chấm (lỗi → catch gọi updateLock() mở lại)
                textarea.disabled = true;
                drawPad.setDisabled(true);

                // Tắt audio (nếu đang phát) ngay khi bắt đầu nộp
                stopTimeUpAudio();
                updateAudioBarState();

                try {
                    const body = new URLSearchParams();
                    body.append("lessonId", LESSON_ID);
                    body.append("answerHtml", text);
                    if (drawing) {
                        body.append("drawingData", drawing.dataUrl);
                        if (photoToken) {
                            body.append("drawingSource", "photo");
                            body.append("drawingUploadToken", photoToken);
                        }
                    }
                    body.append("model", modelSelect.value || "");
                    body.append("aiKeyId", aiKeySelect.value || "");

                    const res = await fetch("/submissions", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "Accept": "application/json"
                        },
                        body: body.toString()
                    });

                    let data;
                    try {
                        data = await res.json();
                    } catch (e) {
                        throw new Error("Server không trả JSON. Kiểm tra log backend.");
                    }

                    if (!res.ok || !data.success) {
                        const apiErr = new Error(data.message || "Chấm bài thất bại.");
                        apiErr.status = res.status;
                        throw apiErr;
                    }

                    submitted = true;
                    photoToken = null;
                    lastSubmittedHadDrawing = !!drawing;
                    stopTimer();
                    stopTimeUpAudio();
                    updateAudioBarState();
                    setAIStatus("connected", "Đã chấm xong", "AI chấm thành công.");
                    updateLock();
                    renderResult(data);
                } catch (err) {
                    console.error("submitWriting:", err);
                    // 400/403/413/422 = bản vẽ/ảnh bị từ chối (không phải lỗi AI) → giữ kết nối AI để sửa rồi nộp lại.
                    // Trước đây mọi lỗi đều đặt aiConnected=false → khoá luôn bảng vẽ, không sửa được bản vẽ quá nặng.
                    const clientErr = [400, 403, 413, 422].indexOf(err.status) !== -1;
                    if (!clientErr) aiConnected = false;
                    setAIStatus(clientErr ? "connected" : "error", clientErr ? "Chưa nộp được" : "Lỗi chấm bài", err.message);
                    submitting = false; // cho phép thử lại
                    updateLock();
                    updateAudioBarState();
                    alert("❌ " + err.message);
                    // Nếu đã hết giờ mà nộp lỗi → bật lại audio cảnh báo
                    if (timeLeft <= 0 && !submitted) {
                        playTimeUpAudio();
                    }
                } finally {
                    submitting = false;
                    submitBtn.disabled = submitted;
                    submitBtn.textContent = submitted
                        ? "✓ Đã chấm"
                        : "🚀 Nộp bài & chấm AI";
                    updateAudioBarState();
                }
            };

            // ============================================
            // RENDER RESULT
            // ============================================
            function renderResult(data) {
                const score = data.score ?? 0;
                const words = countWords(textarea.value);
                const hadText = words > 0;
                const parts = [];
                if (hadText) parts.push("⌨️ chữ");
                if (lastSubmittedHadDrawing) parts.push("🎨 vẽ tay");
                const graded = parts.length ? "Đã chấm: " + parts.join(" + ") : "";

                let meta = "";
                if (data.model) meta += "🤖 " + escapeHTML(data.model);
                // ★ vilao.ai: nhãn thật của key đã chấm; fallback khi server chưa trả aiLabel
                const resultLabel = data.aiLabel || (data.aiKeyName ? providerName(data.aiProvider) + ": " + data.aiKeyName : "");
                if (resultLabel) meta += (meta ? " • " : "") + "🔑 " + escapeHTML(resultLabel);

                resultBody.innerHTML =
                    '<div class="overall">' +
                    '<div class="score-circle">' + score + '</div>' +
                    '<div class="score-meta">' +
                    '<span>Điểm tổng</span>' +
                    '<strong>' + (hadText ? words + ' từ' : '🎨 Chỉ vẽ tay') + '</strong>' +
                    (graded ? '<span style="font-size:12px;color:#6f6f6f;display:block">' + graded + '</span>' : '') +
                    (meta ? '<span style="font-size:12px;color:#6f6f6f;display:block;margin-top:4px">' + meta + '</span>' : '') +
                    '</div>' +
                    '</div>' +
                    '<div class="feedback">' +
                    '<h4>📝 Nhận xét</h4>' +
                    '<div>' + escapeHTML(data.feedback || 'Không có nhận xét chi tiết.') + '</div>' +
                    '</div>' +
                    '<div class="mt-4">' +
                    '<a href="' +
                    (data.redirect || ('/submissions/' + data.submissionId)) +
                    '" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">' +
                    'Xem chi tiết đầy đủ →</a>' +
                    '</div>';

                resultBox.classList.add("show");
                resultBox.scrollIntoView({ behavior: "smooth", block: "start" });
            }

            // ============================================
            // CLEAR
            // ============================================
            window.clearWriting = function () {
                if (submitted) {
                    alert("Bài đã nộp, không thể xoá.");
                    return;
                }
                if (!textarea.value.trim()) return;
                if (!confirm("Xoá toàn bộ phần nhập chữ? (Bản vẽ giữ nguyên — xoá bằng nút 🗑 trong khung vẽ.)")) return;
                textarea.value = "";
                updateWordCount();
                updateBadges();
            };

            // ============================================
            // INIT
            // ============================================
            textarea.addEventListener("input", function () { updateWordCount(); updateBadges(); });
            aiKeySelect.addEventListener("change", syncModelFromKey);

            // Khi rời trang → dừng audio
            window.addEventListener("beforeunload", stopTimeUpAudio);

            updateWordCount();
            updateTimer();
            updateLock();
            updateAudioBarState();

            // ★ vilao.ai: tải model trước, rồi mới tải key (key cần danh sách model đã có để chọn đúng provider)
            loadModels().then(loadKeys).then(() => {
                checkAIConnection();
            });
        })();