extends ../layout

block content
    div(class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6")
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900") Quản lý nhóm
                p(class="text-gray-500 mt-1") Gom sinh viên thành nhóm. Khi chọn "Chỉ hiển thị với…" ở Đề, Tài liệu, Slide, Flashcards bạn chọn được cả nhóm lẫn tài khoản. Nhóm được lưu trên GitHub (userkeys/groups).
            div(class="flex items-center gap-3")
                if isDefaultAdmin
                    a(href="/admin/user-keys" class="text-sm text-indigo-600 hover:underline") ← Quản lý User Key
                else
                    a(href="/admin/dashboard" class="text-sm text-indigo-600 hover:underline") ← Dashboard
                a(href="/admin/user-keys/groups/new" class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition")
                    i(data-lucide="plus", class="w-4 h-4")
                    | Tạo nhóm

        if error
            div(class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700")= error
        if success
            div(class="mb-4 p-3 rounded-lg bg-green-50 border border-green-200 text-sm text-green-700")= success

        div(class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden")
            if !groups.length
                div(class="p-10 text-center")
                    div(class="w-14 h-14 mx-auto rounded-full bg-violet-50 flex items-center justify-center mb-3 text-2xl") 👥
                    p(class="text-gray-500 text-sm") Chưa có nhóm nào. Bấm "Tạo nhóm" để gom sinh viên lại.
            else
                div(class="overflow-x-auto")
                    table(class="w-full text-sm")
                        thead(class="bg-gray-50")
                            tr
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Nhóm
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Thành viên
                                th(class="px-5 py-3 text-center font-semibold text-gray-600") Đang dùng ở
                                th(class="px-5 py-3 text-right font-semibold text-gray-600") Hành động
                        tbody(class="divide-y divide-gray-100")
                            each g in groups
                                tr(class="hover:bg-gray-50 align-top")
                                    td(class="px-5 py-4")
                                        span(class="inline-flex items-center gap-1.5 font-medium text-gray-900")
                                            span 👥
                                            = g.name
                                        div(class="text-xs text-gray-400 mt-1") Cập nhật #{new Date(g.updatedAt).toLocaleString('vi-VN')}
                                    td(class="px-5 py-4")
                                        div(class="text-gray-700 font-medium") #{g.count} người
                                        if g.members.length
                                            div(class="mt-1.5 flex flex-wrap gap-1")
                                                each m in g.members
                                                    span(class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-700 text-xs", title=m.email)= m.name || m.email
                                                if g.more
                                                    span(class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 text-xs") +#{g.more}
                                    td(class="px-5 py-4 text-center text-gray-700")
                                        if g.used
                                            span(class="px-2.5 py-1 rounded-full bg-violet-50 text-violet-700 text-xs font-medium") #{g.used} mục
                                        else
                                            span(class="text-gray-400") —
                                    td(class="px-5 py-4 text-right whitespace-nowrap")
                                        a(href=`/admin/user-keys/groups/${g.id}/edit` class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-indigo-50 text-indigo-700 hover:bg-indigo-100") Sửa
                                        form(method="POST" action=`/admin/user-keys/groups/${g.id}/delete` class="inline ml-1" data-confirm=`Xoá nhóm "${g.name}"?` + (g.used ? ` Đang có ${g.used} mục dùng nhóm này.` : ''))
                                            button(type="submit" class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-red-50 text-red-600 hover:bg-red-100") Xoá

    script.
        document.querySelectorAll('form[data-confirm]').forEach(function (f) {
            f.addEventListener('submit', function (e) { if (!confirm(f.getAttribute('data-confirm'))) e.preventDefault(); });
        });
