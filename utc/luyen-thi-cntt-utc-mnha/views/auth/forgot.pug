doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Quên mật khẩu | AI Grading System

        script(src="/js/theme.js")
        link(rel="stylesheet", href="/css/theme.css")
        script(src="https://cdn.tailwindcss.com")
        script(src="https://unpkg.com/lucide@latest")

    body(class="min-h-screen bg-gray-50")

        div(class="min-h-screen flex items-center justify-center px-4 py-10")
            div(class="w-full max-w-md")

                //- Logo
                div(class="text-center mb-8")
                    a(
                        href="/"
                        class="inline-flex items-center gap-3"
                    )
                        div(class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center shadow-lg")
                            i(
                                data-lucide="graduation-cap"
                                class="w-7 h-7 text-white"
                            )

                        div(class="text-left")
                            h1(class="text-xl font-bold text-gray-900")
                                | AI Grading
                            p(class="text-xs text-gray-500")
                                | Hệ thống học tập trực tuyến

                //- Card
                div(class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8")

                    div(class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center mb-5")
                        i(
                            data-lucide="key-round"
                            class="w-6 h-6"
                        )

                    h2(class="text-2xl font-bold text-gray-900")
                        | Quên mật khẩu?

                    p(class="text-sm text-gray-500 mt-2 leading-6")
                        | Nhập email tài khoản của bạn. Nếu tài khoản tồn tại, chúng tôi sẽ gửi mã xác minh để đặt lại mật khẩu.

                    if error
                        div(class="mt-5 flex items-start gap-3 p-4 bg-red-50 border border-red-200 rounded-xl")
                            i(
                                data-lucide="circle-alert"
                                class="w-5 h-5 text-red-500 flex-shrink-0"
                            )
                            p(class="text-sm text-red-700")
                                = error

                    if success
                        div(class="mt-5 flex items-start gap-3 p-4 bg-green-50 border border-green-200 rounded-xl")
                            i(
                                data-lucide="circle-check"
                                class="w-5 h-5 text-green-500 flex-shrink-0"
                            )
                            p(class="text-sm text-green-700")
                                = success

                    form(
                        action="/auth/forgot"
                        method="POST"
                        class="mt-6 space-y-5"
                    )

                        div
                            label(
                                for="email"
                                class="block text-sm font-medium text-gray-700 mb-2"
                            )
                                | Email tài khoản

                            div(class="relative")
                                i(
                                    data-lucide="mail"
                                    class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"
                                )

                                input(
                                    id="email"
                                    type="email"
                                    name="email"
                                    value=email || ''
                                    required
                                    autocomplete="email"
                                    placeholder="example@email.com"
                                    class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                                )

                        button(
                            type="submit"
                            class="w-full py-3 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100 transition"
                        )
                            | Gửi mã xác minh

                    div(class="mt-6 pt-6 border-t border-gray-100")
                        a(
                            href="/auth/login"
                            class="flex items-center justify-center gap-2 text-sm font-medium text-indigo-600 hover:text-indigo-700"
                        )
                            i(data-lucide="arrow-left" class="w-4 h-4")
                            | Quay lại đăng nhập

                p(class="text-center text-xs text-gray-400 mt-6")
                    | © #{new Date().getFullYear()} AI Grading System

        script.
            lucide.createIcons();