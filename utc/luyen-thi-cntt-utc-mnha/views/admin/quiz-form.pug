extends ../layout

//- ================================================================
//-  Admin: TẠO / SỬA BÀI TRẮC NGHIỆM
//-  Controller (quiz.controller.js) truyền:
//-    mode ('create'|'edit'), subjectId, subjects, prompts, aiKeys, canPickAIKey,
//-    quiz (null | file đề GitHub { title, contentHtml, quiz:{ maxScore, parts } }),
//-    lesson (null | Lesson — có field duration (phút) giống bài tự luận), rawTexts {mcq,tf,fill}, submissionCount, sha (edit), quizConfig
//- ================================================================

block content
    - var isEdit = (typeof mode !== 'undefined' && mode === 'edit')
    - var q0 = (quiz && quiz.quiz) ? quiz.quiz : {}
    - var cfgq = (typeof quizConfig !== 'undefined' && quizConfig) ? quizConfig : {}
    - var chosenAi = (lesson && lesson.analysisAiKeyIds ? lesson.analysisAiKeyIds : []).map(String)
    - var payload = { mode: isEdit ? 'edit' : 'create', lessonId: lesson ? String(lesson._id) : null, sha: (typeof sha !== 'undefined' && sha) ? sha : null, parts: q0.parts || {}, raw: rawTexts || { mcq: '', tf: '', fill: '' }, authoringPrompt: cfgq.QUIZ_AUTHORING_PROMPT || null, allowedImageHosts: cfgq.ALLOWED_IMAGE_HOSTS || ['raw.githubusercontent.com'], audioUrl: q0.audioUrl || '', allowedAudioHosts: cfgq.ALLOWED_AUDIO_HOSTS || ['raw.githubusercontent.com', 'media.githubusercontent.com'], maxOptions: cfgq.MAX_OPTIONS_PER_QUESTION || 10, tfScoring: ((q0.parts && q0.parts.tf && q0.parts.tf.scoring) || cfgq.TF_DEFAULT_SCORING || 'equal'), tfMinStatements: (cfgq.LIMITS && cfgq.LIMITS.MIN_STATEMENTS_TF) || 1, tfMaxStatements: (cfgq.LIMITS && cfgq.LIMITS.MAX_STATEMENTS_TF) || 10, tfThptqgStatements: cfgq.TF_THPTQG_STATEMENTS || 4, defaults: { ppq: cfgq.DEFAULT_POINTS_PER_QUESTION || 1, maxScore: cfgq.DEFAULT_MAX_SCORE || 10, duration: (lesson && lesson.duration) || cfgq.DEFAULT_DURATION || 20 }, durationLimits: { min: 1, max: 600 } }
    - var safeJson = JSON.stringify(payload).replace(/</g, '\\u003c')

    link(rel="stylesheet", href="/css/quiz-form.css")

    div(class="qf")
        div(class="qf-top")
            a(href="/admin/lessons", class="qf-back") ← Danh sách bài học
            h1= isEdit ? 'Sửa bài trắc nghiệm' : 'Tạo bài trắc nghiệm'
            p Dán đề do AI tạo theo đúng định dạng → bấm “Chuyển” → sửa từng câu (đổi/xoá ảnh, đổi đáp án, giải thích) → Lưu.

        if isEdit && submissionCount
            div(class="qf-alert warn")
                | ⚠️ Đã có #{submissionCount} bài nộp. Các bài đó giữ nguyên đề cũ (đã lưu snapshot), sửa đề không làm đổi điểm của họ.

        div(id="qfErrors", class="qf-alert err", hidden)
        div(id="qfOk", class="qf-alert ok", hidden)
        div(id="qfImgNeed", class="qf-alert warn", hidden)

        //- ========== 1. THÔNG TIN CHUNG ==========
        section(class="qf-card")
            h2 1. Thông tin chung
            div(class="qf-grid")
                div(class="qf-field")
                    label(for="fSubject") Môn học
                    select(id="fSubject", disabled=isEdit)
                        option(value="") — Chọn môn —
                        each s in (subjects || [])
                            option(value=s._id, selected=(String(s._id) === String(subjectId)))= s.name
                    if isEdit
                        small Không đổi môn khi sửa bài.
                div(class="qf-field")
                    label(for="fTitle") Tiêu đề bài
                    input(id="fTitle", type="text", maxlength="200", value=(quiz && quiz.title) || (lesson && lesson.title) || '', placeholder="Kiểm tra chương 1")
                if !isEdit
                    div(class="qf-field")
                        label(for="fSlug") Slug (tuỳ chọn)
                        input(id="fSlug", type="text", maxlength="120", placeholder="để trống = tự sinh từ tiêu đề")
                div(class="qf-field")
                    label(for="fMax") Thang điểm tối đa
                    input(id="fMax", type="text", inputmode="decimal", autocomplete="off", value=(q0.maxScore || cfgq.DEFAULT_MAX_SCORE || 10), placeholder="VD: 10 hoặc 2.5")
                    small Có thể nhập số thập phân (VD 10, 2.5, 0.5).
                div(class="qf-field")
                    label(for="fDuration") ⏱ Thời gian làm bài (phút)
                    input(id="fDuration", type="number", min="1", max="600", step="1", value=(lesson && lesson.duration) || cfgq.DEFAULT_DURATION || 20, placeholder="20")
                    small Số phút dùng để đếm ngược ở trang làm bài. Mặc định 20.
                div(class="qf-field")
                    label(for="fPrompt") Prompt phân tích AI
                    select(id="fPrompt")
                        option(value="") — Mặc định hệ thống —
                        each p in (prompts || [])
                            option(value=p._id, selected=(lesson && String(lesson.promptId) === String(p._id)))= p.name + ' (v' + p.version + ')'
            div(class="qf-field")
                label(for="fDesc") Mô tả / hướng dẫn chung (tuỳ chọn, HTML ngắn)
                textarea(id="fDesc", rows="3", placeholder="Ví dụ: Thời gian 45 phút, không dùng tài liệu.")= (quiz && quiz.contentHtml) || ''

            //- ===== AUDIO (tuỳ chọn) =====
            div(class="qf-field qf-audio")
                label(for="fAudio") 🎧 Audio cho bài (tuỳ chọn — bài nghe)
                input(id="fAudio", type="text", autocomplete="off", spellcheck="false", value=q0.audioUrl || '', placeholder="https://raw.githubusercontent.com/<user>/<repo>/main/audio/bai-nghe-1.mp3")
                small Để trống = bài không có audio. Chấp nhận .mp3 .wav .ogg .m4a .aac .opus.
                div(id="audioWarn", class="qf-audio-warn", hidden)
                audio(id="audioPrev", class="qf-audio-prev", controls, preload="metadata", hidden)
                details(class="qf-audio-help")
                    summary Cách đưa file audio lên GitHub &amp; lấy link
                    ol
                        li Vào repo GitHub (nên là repo <b>public</b>) → <b>Add file → Upload files</b> → chọn file audio (up qua web tối đa 25 MB/file) → <b>Commit</b>.
                        li Mở file vừa up → bấm <b>View raw</b> / <b>Download raw file</b> → copy link trên thanh địa chỉ (dạng <code>https://raw.githubusercontent.com/…</code>).
                        li Dán vào ô trên. Dán link dạng <code>github.com/…/blob/…</code> hoặc <code>github.com/…/raw/…</code> cũng được — hệ thống tự đổi sang link raw.
                        li Nghe thử bằng player ngay bên dưới ô trước khi lưu. Repo <b>private</b> thì sinh viên không nghe được.

            if canPickAIKey
                div(class="qf-field")
                    label Cho phép sinh viên chọn AI để phân tích
                    div(class="qf-checks")
                        each k in (aiKeys || [])
                            label(class="qf-check")
                                input(type="checkbox", name="aiKeyIds", value=k._id, checked=(chosenAi.indexOf(String(k._id)) !== -1))
                                span= (k.provider === 'vilao' ? 'vilao.ai' : 'Gemini') + ': ' + k.name
                        if !(aiKeys || []).length
                            small Chưa có AI Key nào đang bật.
                    small Không chọn = dùng AI của bài / xoay key Gemini.

        //- ========== 2. PROMPT MẪU ==========
        section(class="qf-card")
            h2 2. Prompt mẫu nhờ AI tạo đề
            ol(class="qf-steps")
                li Bấm <b>Sao chép prompt</b> bên dưới.
                li Dán vào ChatGPT / Gemini / Claude, thay các chỗ <code>[...]</code> (chủ đề, mức độ, số câu mỗi phần).
                li AI trả về <b>3 khối code</b>. Copy <b>từng khối</b> dán vào đúng ô Phần 1 / 2 / 3 ở bước 3.
            div(class="qf-promptbar")
                button(type="button", id="btnCopyPrompt", class="qf-btn primary") 📋 Sao chép prompt
                button(type="button", id="btnTogglePrompt", class="qf-btn") Xem / ẩn prompt
                span(id="copyMsg", class="qf-msg")
            pre(id="promptBox", class="qf-prompt", hidden)

        //- ========== 3. NHẬP ĐỀ 3 PHẦN ==========
        section(class="qf-card")
            h2 3. Nhập đề &amp; chỉnh từng câu
            div(class="qf-bar")
                button(type="button", id="btnParse", class="qf-btn primary") ⬇ Chuyển text → câu hỏi
                button(type="button", id="btnExport", class="qf-btn") ⬆ Xuất câu hỏi → text
                span(id="syncHint", class="qf-msg")

            p(class="qf-hint")
                | 🛡 Ảnh câu hỏi: mỗi câu có ô <b>“Kiểm duyệt bằng”</b> để chọn CLOUDINARY_CLOUD_NAME, bấm <b>⬆ Tải ảnh lên</b> → Cloudinary kiểm duyệt → lưu GitHub <code>cache/image/&lt;timestamp&gt;.&lt;đuôi ảnh&gt;</code> → link raw tự điền (ảnh trên Cloudinary được xoá ngay sau khi duyệt). Dòng <code>//image: 5,8,10</code> trong text AI = các câu cần ảnh.

            each part in [{ k: 'mcq', t: 'Phần 1 · Trắc nghiệm nhiều đáp án', hint: 'Mỗi câu: “- câu hỏi”, các dòng “+)đáp án”, rồi “=> A” (nhiều đáp án đúng: “=> A, C”). Câu hỏi chùm: thêm dòng “*)/1-3/ nội dung chùm” (có thể in đậm/nghiêng bằng <b>, <i>) ngay trước câu 1; không có dòng *) = không phải câu chùm.' }, { k: 'tf', t: 'Phần 2 · Đúng / Sai', hint: 'Mỗi câu: “- câu dẫn”, rồi nhiều ý: “+)ý a”, “=> Đúng/Sai”, (tuỳ chọn) “++) giải thích ý”; lặp lại cho ý b, c, d.' }, { k: 'fill', t: 'Phần 3 · Điền số liệu / đáp án', hint: 'Mỗi câu: “- câu hỏi”, rồi “=> đáp án” (nhiều cách viết ngăn bằng |). Câu hỏi chùm: thêm dòng “*)/1-3/ nội dung chùm” ngay trước câu 1 (ghi chú hướng dẫn điền, nếu có, đặt trước dòng *) đầu tiên).' }]
                div(class="qf-part", id="part-" + part.k)
                    div(class="qf-parthead")
                        h3= part.t
                        span(class="qf-msg", id="sum-" + part.k)
                        span(class="qf-count", id="count-" + part.k) 0 câu
                    p(class="qf-hint")= part.hint + ' Điểm / câu nhập được số thập phân (VD 0.1, 0.2, 0.25). Phần Đúng/Sai: điểm / câu là điểm tối đa của cả câu (mọi ý).'
                    div(class="qf-partcfg")
                        label
                            | Điểm / câu
                            input(type="text", inputmode="decimal", autocomplete="off", id="ppq-" + part.k, value=(q0.parts && q0.parts[part.k] && q0.parts[part.k].pointsPerQuestion) || cfgq.DEFAULT_POINTS_PER_QUESTION || 1, placeholder="VD: 0.1 · 0.2 · 0.25 · 1")
                        if part.k === 'tf'
                            - var tfSc = (q0.parts && q0.parts.tf && q0.parts.tf.scoring) || cfgq.TF_DEFAULT_SCORING || 'equal'
                            div(class="qf-wide qf-scoring")
                                span(class="qf-scoring-title") Cách chia điểm phần Đúng/Sai
                                div(class="qf-opts")
                                    label(class="qf-opt")
                                        input(type="radio", name="scoring_tf", value="equal", checked=(tfSc === 'equal'))
                                        span(class="qf-opt-body")
                                            strong(class="qf-opt-name") Chia đều các ý
                                            span(class="qf-opt-desc") Đúng k trên n ý thì được k/n × điểm/câu.
                                    label(class="qf-opt")
                                        input(type="radio", name="scoring_tf", value="thptqg", checked=(tfSc === 'thptqg'))
                                        span(class="qf-opt-body")
                                            strong(class="qf-opt-name") THPTQG
                                            span(class="qf-opt-rows")
                                                span(class="qf-opt-row")
                                                    | Đúng 1 ý
                                                    b 0.1 × điểm/câu
                                                span(class="qf-opt-row")
                                                    | Đúng 2 ý
                                                    b 0.25 × điểm/câu
                                                span(class="qf-opt-row")
                                                    | Đúng 3 ý
                                                    b 0.5 × điểm/câu
                                                span(class="qf-opt-row")
                                                    | Đúng 4 ý
                                                    b điểm/câu
                        if part.k === 'fill'
                            label
                                | Sai số cho phép
                                input(type="text", inputmode="decimal", autocomplete="off", id="tolerance", value=(q0.parts && q0.parts.fill && q0.parts.fill.tolerance) || 0, placeholder="VD: 0 · 0.01 · 0.5")
                            label(class="qf-wide")
                                | Ghi chú hướng dẫn điền (không viết = không hiện)
                                input(type="text", id="fillNote", maxlength="300", value=(q0.parts && q0.parts.fill && q0.parts.fill.note) || '', placeholder="Làm tròn 2 chữ số thập phân, chỉ nhập số, không ghi đơn vị.")
                    textarea(class="qf-paste", id="paste-" + part.k, rows="6", spellcheck="false", placeholder="Dán khối text AI tạo cho phần này… (để trống nếu không có phần này)")
                    div(class="qf-cards", id="cards-" + part.k)
                    button(type="button", class="qf-btn", data-add=part.k) ＋ Thêm câu vào phần này

        div(class="qf-save")
            span(id="saveSummary", class="qf-msg") Chưa có câu hỏi
            button(type="button", id="btnSave", class="qf-btn primary big")= isEdit ? '💾 Lưu thay đổi' : '💾 Tạo bài trắc nghiệm'

    style.
        /* ★ Khối "Điểm / câu" + "Cách chia điểm" (phần Đúng/Sai) */
        .qf-partcfg { align-items: flex-start; gap: 16px 24px; }
        .qf-partcfg > label:first-child { flex: 0 0 200px; }
        .qf-partcfg > label:first-child input { font-size: 18px; font-weight: 700; padding: 10px 12px; }
        .qf-partcfg .qf-scoring { display: flex; flex-direction: column; gap: 8px; flex: 1 1 440px; min-width: 0; }
        .qf-scoring-title { font-size: 12px; font-weight: 700; color: #555; }
        .qf-opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
        .qf-partcfg .qf-scoring .qf-opt { position: relative; display: block; min-width: 0; cursor: pointer; font-weight: 400; }
        .qf-opt input { position: absolute; opacity: 0; pointer-events: none; }
        .qf-opt-body { position: relative; display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 12px 14px 12px 42px; border: 1.5px solid #d3d7de; border-radius: 10px; background: #fff; transition: border-color .15s, background .15s, box-shadow .15s; }
        .qf-opt-body::before { content: ""; position: absolute; left: 14px; top: 14px; width: 16px; height: 16px; border: 2px solid #b6bdc9; border-radius: 50%; background: #fff; transition: all .15s; }
        .qf-opt:hover .qf-opt-body { border-color: #a8b3c4; }
        .qf-opt input:checked + .qf-opt-body { border-color: #a61c2f; background: #fff7f8; box-shadow: 0 0 0 3px rgba(166, 28, 47, .08); }
        .qf-opt input:checked + .qf-opt-body::before { border-color: #a61c2f; background: radial-gradient(circle, #a61c2f 0 40%, #fff 45%); }
        .qf-opt input:focus-visible + .qf-opt-body { outline: 2px solid #2c71c2; outline-offset: 2px; }
        .qf-opt-name { font-size: 14px; font-weight: 700; color: #222; line-height: 1.3; }
        .qf-opt-desc { font-size: 12.5px; color: #6b7280; line-height: 1.5; }
        .qf-opt-rows { display: flex; flex-direction: column; gap: 4px; }
        .qf-opt-row { display: flex; justify-content: space-between; gap: 10px; padding: 4px 8px; border-radius: 6px; background: #f3f5f9; font-size: 12.5px; color: #4b5563; }
        .qf-opt-row b { color: #1c4385; font-weight: 700; white-space: nowrap; }
        .qf-opt input:checked + .qf-opt-body .qf-opt-row { background: #fdecee; }
        .qf-audio-warn { color: #b91c1c; font-size: 13px; margin-top: 6px; }
        .qf-audio-prev { display: block; width: 100%; max-width: 520px; margin-top: 10px; }
        .qf-audio-prev[hidden], .qf-audio-warn[hidden] { display: none; }
        .qf-audio-help { margin-top: 8px; font-size: 13px; color: #475569; }
        .qf-audio-help summary { cursor: pointer; color: #2563eb; }
        .qf-audio-help ol { margin: 8px 0 0; padding-left: 20px; line-height: 1.7; }
    script(id="qfData", type="application/json")!= safeJson
    script(src="/js/quizEditor.js")
