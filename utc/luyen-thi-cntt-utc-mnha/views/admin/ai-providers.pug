extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Header
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8")
            div
                a(href="/admin/ai-keys" class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
                    i(data-lucide="arrow-left", class="w-4 h-4")
                    | Quay lại API Key AI
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900 mt-2")
                    | Nhà cung cấp AI
                p(class="text-gray-500 mt-1")
                    | Các loại AI hiện có và biến API của từng loại. Thêm loại mới (ChatGPT, DeepSeek…) rồi gắn key ở trang API Key AI.

            div(class="flex flex-wrap items-center gap-3")
                button(
                    type="button"
                    id="btnNewSupplier"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700"
                )
                    i(data-lucide="plus", class="w-4 h-4")
                    | Thêm nhà cung cấp

        if success
            div(class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm")
                = success
        if error
            div(class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm")
                = error

        //- Nguồn dữ liệu
        if status && status.source === 'github'
            div(class="mb-6 p-4 rounded-xl bg-blue-50 border border-blue-200 text-blue-800 text-sm flex items-start gap-3")
                i(data-lucide="database", class="w-5 h-5 mt-0.5 shrink-0")
                div
                    p(class="font-medium") Dữ liệu lưu trên GitHub
                    p(class="mt-1")
                        | File 
                        code(class="px-1 bg-blue-100 rounded")= status.path
                        |  — sửa ở đây sẽ ghi thẳng vào file này. API Key vẫn lưu mã hoá trong MongoDB, không nằm trên GitHub.
        else
            div(class="mb-6 p-4 rounded-xl bg-yellow-50 border border-yellow-200 text-yellow-800 text-sm")
                div(class="flex items-start gap-3")
                    i(data-lucide="triangle-alert", class="w-5 h-5 mt-0.5 shrink-0")
                    div(class="flex-1")
                        p(class="font-medium") Chưa có file #{status ? status.path : 'AI-database/index.json'} trên GitHub
                        p(class="mt-1")
                            | Đang dùng danh sách mặc định (Gemini + vilao.ai) nên hệ thống vẫn chạy bình thường. Bấm nút bên dưới (hoặc chạy 
                            code(class="px-1 bg-yellow-100 rounded") node migrateMongoToGithub.js --only=aiproviders --run
                            | ) để tạo file trước khi thêm nhà cung cấp mới.
                        if status && status.lastError
                            p(class="mt-1 text-xs") Lỗi đọc GitHub gần nhất: #{status.lastError}
                        form(action="/admin/ai-keys/Supplier/init" method="POST" class="mt-3")
                            button(type="submit" class="px-3 py-2 rounded-lg bg-yellow-600 text-white text-sm font-medium hover:bg-yellow-700")
                                | Tạo file trên GitHub

        //- Danh sách nhà cung cấp
        div(class="grid grid-cols-1 lg:grid-cols-2 gap-5")
            each p in providers
                - const nKeys = (keyCounts && keyCounts[p.id]) || 0
                div(class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm" + (p.enabled === false ? ' opacity-70' : ''))
                    div(class="flex items-start justify-between gap-3")
                        div
                            div(class="flex flex-wrap items-center gap-2")
                                h2(class="font-semibold text-gray-900 text-lg")= p.label
                                span(class="px-2 py-0.5 rounded text-xs font-mono bg-gray-100 text-gray-700")= p.id
                                if p.kind === 'gemini'
                                    span(class="px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700") SDK Gemini
                                else
                                    span(class="px-2 py-0.5 rounded text-xs font-medium bg-teal-100 text-teal-700") API kiểu OpenAI
                                if p.builtin
                                    span(class="px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700") Mặc định
                            if p.description
                                p(class="text-sm text-gray-500 mt-1")= p.description
                        if p.enabled === false
                            span(class="px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 text-xs font-medium whitespace-nowrap") Đã tắt
                        else
                            span(class="px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-medium whitespace-nowrap") Đang bật

                    //- Biến API
                    div(class="mt-4 rounded-lg bg-gray-50 border border-gray-100 divide-y divide-gray-100 text-sm")
                        if p.kind !== 'gemini'
                            div(class="px-3 py-2 flex gap-3")
                                span(class="w-32 shrink-0 text-gray-500") baseUrl
                                span(class="font-mono text-gray-800 break-all")= p.baseUrl
                            div(class="px-3 py-2 flex gap-3")
                                span(class="w-32 shrink-0 text-gray-500") chatPath
                                span(class="font-mono text-gray-800 break-all")= p.chatPath
                            div(class="px-3 py-2 flex gap-3")
                                span(class="w-32 shrink-0 text-gray-500") xác thực
                                span(class="font-mono text-gray-800")= (p.authHeader || 'Authorization') + ': ' + (p.authScheme === '' ? '<key>' : ((p.authScheme === undefined ? 'Bearer' : p.authScheme) + ' <key>'))
                            div(class="px-3 py-2 flex gap-3")
                                span(class="w-32 shrink-0 text-gray-500") maxTokens
                                span(class="font-mono text-gray-800")= p.maxTokens
                            div(class="px-3 py-2 flex gap-3")
                                span(class="w-32 shrink-0 text-gray-500") model theo key
                                span(class="text-gray-800")= p.modelPerKey ? 'Có — mỗi key gắn 1 model (vd vilao.ai)' : 'Không — chọn model lúc chấm bài'
                        div(class="px-3 py-2 flex gap-3")
                            span(class="w-32 shrink-0 text-gray-500") defaultModel
                            span(class="font-mono text-gray-800 break-all")= p.defaultModel
                        div(class="px-3 py-2 flex gap-3")
                            span(class="w-32 shrink-0 text-gray-500") models (#{(p.models || []).length})
                            span(class="text-gray-800 flex flex-wrap gap-1")
                                each m, i in (p.models || [])
                                    if i < 8
                                        span(class="px-1.5 py-0.5 rounded bg-white border border-gray-200 text-xs font-mono")= m
                                if (p.models || []).length > 8
                                    span(class="text-xs text-gray-500 self-center") +#{p.models.length - 8} model nữa
                        if p.jsVars
                            div(class="px-3 py-2 flex gap-3")
                                span(class="w-32 shrink-0 text-gray-500") biến JS cũ
                                span(class="font-mono text-xs text-gray-500 break-all")= Object.values(p.jsVars).join(', ')

                    div(class="mt-4 flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-gray-100")
                        p(class="text-xs text-gray-500")
                            | API Key: 
                            span(class="font-semibold text-gray-700")= nKeys
                            if p.updatedAt
                                |  · Cập nhật: #{new Date(p.updatedAt).toLocaleString('vi-VN')}
                        div(class="flex items-center gap-2")
                            if p.enabled !== false
                                a(href="/admin/ai-keys?provider=" + p.id, class="px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-100 text-xs font-medium")
                                    | Thêm key
                            button(type="button", data-edit=p.id, class="btn-edit-supplier px-3 py-1.5 rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 text-xs font-medium")
                                | Sửa
                            if !p.builtin
                                form(action="/admin/ai-keys/Supplier/" + p.id + "/toggle", method="POST", class="inline")
                                    button(type="submit" class="px-3 py-1.5 rounded-lg bg-gray-100 text-gray-700 hover:bg-gray-200 text-xs font-medium")
                                        = p.enabled === false ? 'Bật' : 'Tắt'
                                form(action="/admin/ai-keys/Supplier/" + p.id + "/delete", method="POST", class="inline", onsubmit="return confirm('Xoá nhà cung cấp này khỏi danh sách?')")
                                    button(type="submit" class="w-8 h-8 rounded-lg text-red-500 hover:bg-red-50 flex items-center justify-center" title="Xoá")
                                        i(data-lucide="trash-2", class="w-4 h-4")

        //- ============ FORM THÊM / SỬA ============
        div#supModal(class="hidden fixed inset-0 z-50 bg-black/50 p-4 overflow-y-auto")
            div(class="min-h-full flex items-center justify-center")
                div(class="bg-white rounded-2xl w-full max-w-2xl shadow-xl")
                    div(class="px-6 py-5 border-b border-gray-200 flex items-center justify-between")
                        h2(id="supTitle" class="font-bold text-gray-900") Thêm nhà cung cấp
                        button(type="button" id="btnCloseSup" class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center")
                            i(data-lucide="x", class="w-5 h-5")

                    form(action="/admin/ai-keys/Supplier" method="POST" id="supForm" class="p-6 space-y-5")
                        input(type="hidden" name="mode" id="f_mode" value="create")

                        //- Mẫu điền nhanh (chỉ khi thêm mới)
                        div(id="tplBox")
                            label(class="block text-sm font-medium text-gray-700 mb-2") Điền nhanh từ mẫu (tuỳ chọn)
                            div(class="flex flex-wrap gap-2")
                                each t in templates
                                    button(type="button", data-tpl=t.templateId, class="btn-tpl px-3 py-1.5 rounded-lg border border-gray-300 text-sm text-gray-700 hover:bg-gray-50")= t.label
                            p(class="text-xs text-gray-500 mt-1") Chỉ là gợi ý — hãy đối chiếu địa chỉ API / tên model với tài liệu của nhà cung cấp.

                        div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
                            div
                                label(class="block text-sm font-medium text-gray-700 mb-1") Mã (id) *
                                input(type="text" name="id" id="f_id" required maxlength="32" placeholder="vd: openai, deepseek" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono outline-none focus:ring-2 focus:ring-indigo-500")
                                p(class="text-xs text-gray-500 mt-1") a-z, 0-9, "-", "_". Lưu cùng key trong MongoDB nên không đổi được sau khi tạo.
                            div
                                label(class="block text-sm font-medium text-gray-700 mb-1") Tên hiển thị *
                                input(type="text" name="label" id="f_label" required maxlength="60" placeholder="vd: ChatGPT (OpenAI)" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500")
                        div
                            label(class="block text-sm font-medium text-gray-700 mb-1") Mô tả
                            input(type="text" name="description" id="f_description" maxlength="300" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500")

                        //- Biến API (chỉ loại OpenAI)
                        fieldset(id="apiBox" class="border border-gray-200 rounded-xl p-4 space-y-4")
                            legend(class="px-2 text-sm font-semibold text-gray-700") Biến API
                            div
                                label(class="block text-sm font-medium text-gray-700 mb-1") baseUrl — địa chỉ API *
                                input(type="url" name="baseUrl" id="f_baseUrl" placeholder="https://api.openai.com" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500")
                                p(class="text-xs text-gray-500 mt-1") Phải là https và tên miền công khai.
                            div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
                                div
                                    label(class="block text-sm font-medium text-gray-700 mb-1") chatPath
                                    input(type="text" name="chatPath" id="f_chatPath" placeholder="/v1/chat/completions" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500")
                                div
                                    label(class="block text-sm font-medium text-gray-700 mb-1") maxTokens
                                    input(type="number" name="maxTokens" id="f_maxTokens" min="1" max="200000" placeholder="4096" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500")
                                div
                                    label(class="block text-sm font-medium text-gray-700 mb-1") Header xác thực
                                    input(type="text" name="authHeader" id="f_authHeader" placeholder="Authorization" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500")
                                div
                                    label(class="block text-sm font-medium text-gray-700 mb-1") Kiểu xác thực
                                    input(type="text" name="authScheme" id="f_authScheme" placeholder="Bearer" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500")
                            div
                                label(class="block text-sm font-medium text-gray-700 mb-1") System prompt (tuỳ chọn)
                                textarea(name="systemPrompt" id="f_systemPrompt" rows="2" maxlength="1000" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-indigo-500")
                            div(class="flex flex-col gap-2")
                                label(class="inline-flex items-center gap-2 text-sm text-gray-700")
                                    input(type="hidden" name="modelPerKey" value="0")
                                    input(type="checkbox" name="modelPerKey" id="f_modelPerKey" class="rounded border-gray-300")
                                    | Mỗi key gắn 1 model riêng (kiểu vilao.ai: key chỉ dùng model đã subscribe)
                                label(class="inline-flex items-center gap-2 text-sm text-gray-700")
                                    input(type="hidden" name="allowCustomModel" value="0")
                                    input(type="checkbox" name="allowCustomModel" id="f_allowCustomModel" class="rounded border-gray-300")
                                    | Cho phép dùng tên model ngoài danh sách
                            details(class="text-sm")
                                summary(class="cursor-pointer text-gray-600") Nâng cao: nhận diện lỗi "chưa subscribe model"
                                div(class="mt-3 space-y-3")
                                    div
                                        label(class="block text-xs font-medium text-gray-600 mb-1") subscribeRegex
                                        input(type="text" name="subscribeRegex" id="f_subscribeRegex" class="w-full px-3 py-2 border border-gray-300 rounded-lg font-mono text-xs")
                                    div
                                        label(class="block text-xs font-medium text-gray-600 mb-1") missingModelRegex (nhóm 1 = tên model)
                                        input(type="text" name="missingModelRegex" id="f_missingModelRegex" class="w-full px-3 py-2 border border-gray-300 rounded-lg font-mono text-xs")

                        //- Model
                        fieldset(class="border border-gray-200 rounded-xl p-4 space-y-4")
                            legend(class="px-2 text-sm font-semibold text-gray-700") Model
                            div
                                label(class="block text-sm font-medium text-gray-700 mb-1") models — mỗi dòng một model *
                                textarea(name="models" id="f_models" rows="5" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500" placeholder="gpt-4o-mini\ngpt-4o")
                            div
                                label(class="block text-sm font-medium text-gray-700 mb-1") defaultModel *
                                input(type="text" name="defaultModel" id="f_defaultModel" required placeholder="gpt-4o-mini" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500")
                            div(id="fbBox")
                                label(class="block text-sm font-medium text-gray-700 mb-1") fallbackModels — dự phòng khi model chính quá tải (Gemini)
                                textarea(name="fallbackModels" id="f_fallbackModels" rows="3" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500")

                        div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
                            div
                                label(class="block text-sm font-medium text-gray-700 mb-1") Tiền tố key (cách nhau bằng dấu phẩy)
                                input(type="text" name="keyPrefixes" id="f_keyPrefixes" placeholder="sk-" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500")
                            div
                                label(class="block text-sm font-medium text-gray-700 mb-1") Gợi ý ô nhập key
                                input(type="text" name="keyPlaceholder" id="f_keyPlaceholder" placeholder="sk-..." class="w-full px-3 py-2.5 border border-gray-300 rounded-lg font-mono text-sm outline-none focus:ring-2 focus:ring-indigo-500")

                        div(class="flex justify-end gap-3 pt-2")
                            button(type="button" id="btnCancelSup" class="px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50") Hủy
                            button(type="submit" class="px-4 py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700") Lưu nhà cung cấp

        script#supProviders(type="application/json")!= providersJson
        script#supTemplates(type="application/json")!= templatesJson
        script#supPre(type="application/json")!= formDataJson

        script.
            (function () {
                var providers = JSON.parse(document.getElementById('supProviders').textContent) || [];
                var templates = JSON.parse(document.getElementById('supTemplates').textContent) || [];
                var pre = JSON.parse(document.getElementById('supPre').textContent);
                var openMode = '#{formMode || ""}';
                var openEdit = '#{openEdit || ""}';
                var openNew = #{openNew ? 'true' : 'false'};
                var modal = document.getElementById('supModal');
                var form = document.getElementById('supForm');

                function $(id) { return document.getElementById(id); }
                function listToText(v) { return Array.isArray(v) ? v.join('\n') : (v || ''); }

                function setForm(mode, data) {
                    data = data || {};
                    var edit = mode === 'edit';
                    var builtin = !!data.builtin || data.id === 'gemini';
                    var isGemini = (data.kind === 'gemini') || data.id === 'gemini';
                    $('f_mode').value = mode;
                    $('supTitle').textContent = edit ? 'Sửa nhà cung cấp: ' + (data.label || data.id) : 'Thêm nhà cung cấp';
                    $('tplBox').style.display = edit ? 'none' : '';
                    $('apiBox').style.display = isGemini ? 'none' : '';
                    $('fbBox').style.display = isGemini ? '' : 'none';
                    var idEl = $('f_id');
                    idEl.value = data.id || '';
                    idEl.readOnly = edit;
                    idEl.classList.toggle('bg-gray-100', edit);
                    var map = {
                        f_label: data.label, f_description: data.description, f_baseUrl: data.baseUrl,
                        f_chatPath: data.chatPath, f_maxTokens: data.maxTokens, f_authHeader: data.authHeader,
                        f_authScheme: data.authScheme, f_systemPrompt: data.systemPrompt,
                        f_defaultModel: data.defaultModel, f_keyPlaceholder: data.keyPlaceholder,
                        f_subscribeRegex: (data.errors && data.errors.subscribeRegex) || data.subscribeRegex,
                        f_missingModelRegex: (data.errors && data.errors.missingModelRegex) || data.missingModelRegex
                    };
                    Object.keys(map).forEach(function (k) { $(k).value = map[k] == null ? '' : map[k]; });
                    $('f_models').value = listToText(data.models);
                    $('f_fallbackModels').value = listToText(data.fallbackModels);
                    $('f_keyPrefixes').value = Array.isArray(data.keyPrefixes) ? data.keyPrefixes.join(', ') : (data.keyPrefixes || '');
                    var truthy = function (v) { return v === true || v === 'true' || v === 'on' || v === '1' || v === 1; };
                    $('f_modelPerKey').checked = truthy(data.modelPerKey);
                    $('f_allowCustomModel').checked = data.allowCustomModel === undefined ? true : truthy(data.allowCustomModel);
                    modal.classList.remove('hidden');
                }

                function closeForm() { modal.classList.add('hidden'); }

                $('btnNewSupplier').addEventListener('click', function () {
                    setForm('create', { chatPath: '/v1/chat/completions', maxTokens: 4096, authHeader: 'Authorization', authScheme: 'Bearer', allowCustomModel: true });
                });
                $('btnCloseSup').addEventListener('click', closeForm);
                $('btnCancelSup').addEventListener('click', closeForm);

                document.querySelectorAll('.btn-edit-supplier').forEach(function (b) {
                    b.addEventListener('click', function () {
                        var id = b.getAttribute('data-edit');
                        var p = providers.filter(function (x) { return x.id === id; })[0];
                        if (p) setForm('edit', p);
                    });
                });

                document.querySelectorAll('.btn-tpl').forEach(function (b) {
                    b.addEventListener('click', function () {
                        var t = templates.filter(function (x) { return x.templateId === b.getAttribute('data-tpl'); })[0];
                        if (!t) return;
                        var d = Object.assign({ authHeader: 'Authorization', authScheme: 'Bearer', allowCustomModel: true }, t);
                        setForm('create', d);
                    });
                });

                // Mở lại form khi server báo lỗi (giữ nguyên dữ liệu đã nhập) hoặc từ link ?edit= / ?new=1
                if (pre && openMode) {
                    var base = openMode === 'edit' ? (providers.filter(function (x) { return x.id === pre.id; })[0] || {}) : {};
                    setForm(openMode, Object.assign({}, base, pre, { kind: base.kind, builtin: base.builtin }));
                } else if (openEdit) {
                    var p2 = providers.filter(function (x) { return x.id === openEdit; })[0];
                    if (p2) setForm('edit', p2);
                } else if (openNew) {
                    $('btnNewSupplier').click();
                }
            })();
