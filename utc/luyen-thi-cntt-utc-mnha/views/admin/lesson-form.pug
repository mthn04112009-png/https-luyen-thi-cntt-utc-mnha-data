extends ../layout

block content
    div(class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Back
        div(class="mb-6")
            a(
                href="/admin/lessons"
                class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700"
            )
                i(data-lucide="arrow-left", class="w-4 h-4")
                | Quay lại danh sách

        //- Flash
        if success
            div(class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm")
                = success
        if error
            div(class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm")
                = error

        .bg-white.border.border-gray-200.rounded-2xl.p-6.shadow-sm
            h1(class="text-2xl font-bold text-gray-900 mb-6")
                if lesson
                    | Chỉnh sửa bài học
                else
                    | Thêm bài học

            //- ★ Flash động: đỏ khi lỗi, xanh khi lưu được (điền bằng JS bên dưới)
            div(id="formAlert", role="alert", class="hidden mb-6 p-4 rounded-xl border text-sm")

            form(
                action=(lesson ? `/admin/lessons/${lesson._id}/edit` : '/admin/lessons')
                method="POST"
                class="space-y-5"
                id="lessonForm"
            )
                //- Môn học
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Môn học *
                    select(
                        name="subjectId"
                        required
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                    )
                        option(value="") — Chọn môn học —
                        each subject in subjects
                            option(
                                value=subject._id
                                selected=(lesson && String(lesson.subjectId) === String(subject._id))
                            )
                                = subject.name

                //- ★ AI KEY + MODEL
                div(class="p-4 rounded-xl bg-indigo-50 border border-indigo-100")
                    div(class="flex items-center gap-2 mb-3")
                        i(data-lucide="bot", class="w-4 h-4 text-indigo-600")
                        h3(class="font-semibold text-indigo-900 text-sm")
                            | Cấu hình AI chấm bài

                    div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")

                        //- (1) Chọn Tên AI Key
                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | 🔑 Tên AI Key
                            select(
                                name="aiKeyId"
                                id="aiKeySelect"
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 bg-white"
                            )
                                option(value="") — Dùng key mặc định hệ thống —
                                if aiKeys && aiKeys.length
                                    each k in aiKeys
                                        option(
                                            value=k._id
                                            data-model=(k.model || '')
                                            data-provider=(k.provider || 'gemini')
                                            selected=(lesson && lesson.aiKeyId && String(lesson.aiKeyId) === String(k._id))
                                        )
                                            = k.aiLabel || ((k.providerLabel || k.provider || 'Gemini') + ': ' + k.name)
                                            if k.model
                                                |  (#{k.model})
                            p(class="text-xs text-gray-500 mt-1")
                                if aiKeys && aiKeys.length
                                    | Chọn key AI để chấm bài này. Bỏ trống → dùng key mặc định.
                                else
                                    | Chưa có API Key. Vào 
                                    a(href="/admin/ai-keys", class="text-indigo-600 underline") đây 
                                    | để thêm.

                        //- (2) Chọn Model — chỉ enable khi đã chọn key
                        div
                            label(class="block text-sm font-medium text-gray-700 mb-2")
                                | 🤖 Model AI
                            select(
                                name="model"
                                id="modelSelect"
                                disabled=(!lesson || !lesson.aiKeyId)
                                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 bg-white disabled:bg-gray-100 disabled:cursor-not-allowed"
                            )
                                option(value="") — Chọn AI Key trước —
                                //- ★ Model của MỌI nhà cung cấp (AI-database/index.json); JS bên dưới chỉ hiện model đúng nhà cung cấp của key đang chọn
                                - const curKey = (aiKeys || []).filter(function (k) { return lesson && lesson.aiKeyId && String(k._id) === String(lesson.aiKeyId); })[0]
                                - const curProv = curKey ? (curKey.provider || 'gemini') : 'gemini'
                                if providers && providers.length
                                    each pv in providers
                                        each m in (pv.models || [])
                                            option(
                                                value=m
                                                data-provider=pv.id
                                                hidden=(pv.id !== 'gemini')
                                                disabled=(pv.id !== 'gemini')
                                                selected=(lesson && lesson.model === m && pv.id === curProv)
                                            )
                                                = m
                                else if supportedModels && supportedModels.length
                                    each m in supportedModels
                                        option(
                                            value=m
                                            data-provider="gemini"
                                            selected=(lesson && lesson.model === m)
                                        )
                                            = m
                            p(class="text-xs text-gray-500 mt-1", id="modelHint")
                                | Model sẽ dùng để chấm bài. Tự động điền theo key đã chọn.

                //- Prompt chấm
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Prompt chấm điểm
                    select(
                        name="promptId"
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                    )
                        option(value="") — Dùng prompt mặc định —
                        if prompts && prompts.length
                            each prompt in prompts
                                option(
                                    value=prompt._id
                                    selected=(lesson && lesson.promptId && String(lesson.promptId) === String(prompt._id))
                                )
                                    = prompt.name
                                    if prompt.strictness
                                        |  [#{prompt.strictness}]

                //- Tiêu đề
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Tiêu đề bài học *
                    input(
                        type="text"
                        name="title"
                        required
                        value=(lesson && lesson.title) || ''
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                        placeholder="Ví dụ: Bài 1 — Giới thiệu về thuật toán"
                    )

                //- ★ THỜI GIAN LÀM BÀI
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | ⏱ Thời gian làm bài (phút)
                    input(
                        type="number"
                        name="duration"
                        min="1"
                        max="600"
                        value=(lesson && lesson.duration) || 20
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                        placeholder="20"
                    )
                    p(class="text-xs text-gray-500 mt-1")
                        | Số phút dùng để đếm ngược ở trang làm bài. Mặc định 20.

                //- Mô tả
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | Mô tả ngắn
                    textarea(
                        name="description"
                        rows="2"
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
                    )= (lesson && lesson.description) || ''

                //- Nội dung đề bài
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | 📝 Nội dung đề bài (HTML)
                    textarea(
                        name="contentHtml"
                        rows="12"
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-mono text-sm resize-y"
                        placeholder="<p>Đề bài...</p>"
                    )= (content && content.contentHtml) || ''
                    p(class="text-xs text-gray-500 mt-1")
                        | Hỗ trợ HTML: &lt;p&gt;, &lt;strong&gt;, &lt;ul&gt;, &lt;li&gt;, &lt;div&gt;...

                //- Lời giải mẫu
                div
                    label(class="block text-sm font-medium text-gray-700 mb-2")
                        | 💡 Lời giải mẫu (chỉ hiện sau khi chấm)
                    textarea(
                        name="sampleSolution"
                        rows="6"
                        class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-mono text-sm resize-y"
                        placeholder="Lời giải mẫu..."
                    )= (lesson && lesson.sampleSolution) || ''

                //- Order + Published
                div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
                    div
                        label(class="block text-sm font-medium text-gray-700 mb-2")
                            | Thứ tự
                        input(
                            type="number"
                            name="order"
                            value=(lesson && lesson.order) || 0
                            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                        )

                    div(class="flex items-end pb-2.5")
                        label(class="flex items-center gap-2 cursor-pointer")
                            input(
                                type="checkbox"
                                name="isPublished"
                                checked=(!lesson || lesson.isPublished)
                                class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                            )
                            span(class="text-sm text-gray-700")
                                | Công khai cho sinh viên

                //- Audit
                if lesson
                    div(class="pt-4 border-t border-gray-100 text-xs text-gray-500 space-y-1")
                        if lesson.createdBy
                            div
                                | Người tạo: #{lesson.createdBy.name || lesson.createdBy.email}
                        if lesson.createdAt
                            div
                                | Tạo lúc: #{new Date(lesson.createdAt).toLocaleString('vi-VN')}
                        if lesson.updatedAt
                            div
                                | Cập nhật: #{new Date(lesson.updatedAt).toLocaleString('vi-VN')}

                //- Actions
                div(class="flex justify-end gap-3 pt-4")
                    a(
                        href="/admin/lessons"
                        class="px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50"
                    )
                        | Hủy

                    button(
                        type="submit"
                        class="px-4 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700"
                    )
                        if lesson
                            | Lưu thay đổi
                        else
                            | Tạo bài học

    //- JS: auto-fill model theo key
    script.
        (function () {
            var keySelect = document.getElementById('aiKeySelect');
            var modelSelect = document.getElementById('modelSelect');
            var hint = document.getElementById('modelHint');

            if (!keySelect || !modelSelect) return;

            // Chỉ hiện model đúng nhà cung cấp của key đang chọn
            // (không chọn key = coi như gemini, giữ hành vi cũ)
            function filterModelsByProvider() {
                var opt = keySelect.options[keySelect.selectedIndex];
                var provider = (opt && opt.value) ? (opt.getAttribute('data-provider') || 'gemini') : 'gemini';
                for (var i = 0; i < modelSelect.options.length; i++) {
                    var o = modelSelect.options[i];
                    var op = o.getAttribute('data-provider');
                    if (!op) continue; // option placeholder
                    var show = op === provider;
                    o.hidden = !show;
                    o.disabled = !show;
                }
                var cur = modelSelect.options[modelSelect.selectedIndex];
                if (cur && cur.getAttribute('data-provider') && cur.getAttribute('data-provider') !== provider) {
                    modelSelect.value = '';
                }
            }

            function syncFromKey() {
                filterModelsByProvider();
                var opt = keySelect.options[keySelect.selectedIndex];
                var keyModel = opt ? (opt.getAttribute('data-model') || '') : '';

                if (!keySelect.value) {
                    modelSelect.disabled = true;
                    modelSelect.value = '';
                    if (hint) {
                        hint.textContent = 'Chọn AI Key ở trên để bật chọn model.';
                        hint.className = 'text-xs text-gray-500 mt-1';
                    }
                    return;
                }

                modelSelect.disabled = false;

                if (keyModel) {
                    var found = false;
                    for (var i = 0; i < modelSelect.options.length; i++) {
                        if (modelSelect.options[i].value === keyModel) {
                            modelSelect.selectedIndex = i;
                            found = true;
                            break;
                        }
                    }
                    if (found && hint) {
                        hint.textContent = 'Đã tự động chọn model: ' + keyModel + '. Có thể đổi nếu muốn.';
                        hint.className = 'text-xs text-green-600 mt-1';
                    }
                    return;
                }

                if (hint) {
                    hint.textContent = 'Key này chưa có model mặc định. Hãy chọn model ở trên.';
                    hint.className = 'text-xs text-yellow-600 mt-1';
                }
            }

            keySelect.addEventListener('change', syncFromKey);

            filterModelsByProvider();

            if (keySelect.value) {
                modelSelect.disabled = false;
                if (!modelSelect.value) syncFromKey();
            }
        })();

    //- ★ Gửi form bằng fetch: chống bấm 2 lần + hiện flash đỏ/xanh, KHÔNG mất nội dung đã nhập khi lỗi
    script.
        (function () {
            var form = document.getElementById('lessonForm');
            var box = document.getElementById('formAlert');
            if (!form || !box) return;

            var GREEN = ['bg-green-50', 'border-green-200', 'text-green-800'];
            var RED = ['bg-red-50', 'border-red-200', 'text-red-800'];
            var isEdit = /\/edit$/.test(form.getAttribute('action') || '');

            function show(type, msg) {
                box.classList.remove.apply(box.classList, GREEN.concat(RED));
                box.classList.add.apply(box.classList, type === 'ok' ? GREEN : RED);
                box.textContent = (type === 'ok' ? '✅ ' : '⚠️ ') + msg;
                box.classList.remove('hidden');
                box.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            function readJson(res) {
                return res.text().then(function (t) {
                    var data = null;
                    try { data = JSON.parse(t); } catch (e) {}
                    return { res: res, data: data };
                });
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (form.dataset.busy === '1') return; // chống bấm 2 lần
                if (!form.checkValidity()) { form.reportValidity(); return; }

                var btn = form.querySelector('button[type=submit]');
                var oldText = btn ? btn.textContent : '';
                form.dataset.busy = '1';
                if (btn) { btn.disabled = true; btn.textContent = 'Đang lưu...'; }
                box.classList.add('hidden');

                function fail(msg) {
                    form.dataset.busy = '0';
                    if (btn) { btn.disabled = false; btn.textContent = oldText; }
                    show('err', msg);
                }

                fetch(form.getAttribute('action'), {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest', // server trả JSON thay vì redirect
                        'Accept': 'application/json'
                    },
                    body: new URLSearchParams(new FormData(form)).toString()
                })
                .then(readJson)
                .then(function (r) {
                    if (r.res.ok && r.data && r.data.ok) {
                        if (btn) btn.textContent = 'Đã lưu ✓'; // giữ khoá nút → không tạo trùng
                        show('ok', isEdit ? 'Đã cập nhật bài học thành công. Đang quay về danh sách...'
                                          : 'Đã tạo bài học thành công. Đang quay về danh sách...');
                        setTimeout(function () { window.location.href = '/admin/lessons'; }, 1200);
                        return;
                    }
                    var msg = r.data && (r.data.error || r.data.message);
                    if (!msg) {
                        if (r.res.redirected || r.res.ok) msg = 'Phản hồi không hợp lệ (có thể phiên đăng nhập đã hết hạn). Hãy tải lại trang rồi kiểm tra danh sách bài trước khi lưu lại.';
                        else if (r.res.status === 413) msg = 'Dữ liệu gửi lên quá lớn (413).';
                        else if (r.res.status === 504) msg = 'Máy chủ phản hồi quá lâu (504). Kiểm tra danh sách bài trước khi lưu lại, có thể bài đã được lưu.';
                        else msg = 'Lỗi máy chủ (' + r.res.status + ').';
                    }
                    fail(msg);
                })
                .catch(function () {
                    fail('Không kết nối được máy chủ. Kiểm tra mạng rồi thử lại (nội dung bạn nhập vẫn được giữ).');
                });
            });
        })();
