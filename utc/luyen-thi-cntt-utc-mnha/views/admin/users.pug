extends ../layout

block content
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- ============================================================
        //- HEADER
        //- ============================================================
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8")
            div
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900") Quản lý tài khoản
                p(class="text-gray-500 mt-1") Duyệt, phân quyền và quản lý người dùng hệ thống

        //- ============================================================
        //- STATS BAR
        //- ============================================================
        div(class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-8")
            div(class="bg-white border border-gray-200 rounded-xl p-4")
                p(class="text-xs font-medium text-gray-500") Tổng
                p(class="text-2xl font-bold text-gray-900 mt-1")= stats.total || 0

            div(class="bg-amber-50 border border-amber-200 rounded-xl p-4")
                p(class="text-xs font-medium text-amber-700") Chờ duyệt
                p(class="text-2xl font-bold text-amber-800 mt-1")= stats.pending || 0

            div(class="bg-blue-50 border border-blue-200 rounded-xl p-4")
                p(class="text-xs font-medium text-blue-700") Sinh viên
                p(class="text-2xl font-bold text-blue-800 mt-1")= stats.student || 0

            div(class="bg-indigo-50 border border-indigo-200 rounded-xl p-4")
                p(class="text-xs font-medium text-indigo-700") Admin
                p(class="text-2xl font-bold text-indigo-800 mt-1")= stats.admin || 0

            div(class="bg-gray-50 border border-gray-200 rounded-xl p-4")
                p(class="text-xs font-medium text-gray-600") Client
                p(class="text-2xl font-bold text-gray-700 mt-1")= stats.client || 0

        //- ============================================================
        //- FILTERS
        //- ============================================================
        form(
            method="GET"
            action="/admin/users"
            class="bg-white border border-gray-200 rounded-2xl p-4 mb-6 flex flex-col md:flex-row gap-3 md:items-end flex-wrap"
        )
            div(class="flex-1 min-w-48")
                label(class="block text-xs font-medium text-gray-500 mb-1") Tìm kiếm
                input(
                    type="text"
                    name="q"
                    value=(filters.q || '')
                    placeholder="Tìm theo tên hoặc email..."
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 outline-none"
                )

            div
                label(class="block text-xs font-medium text-gray-500 mb-1") Vai trò
                select(
                    name="role"
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 outline-none"
                )
                    option(value="all", selected=filters.role === 'all') Tất cả vai trò
                    option(value="client", selected=filters.role === 'client') Client
                    option(value="student", selected=filters.role === 'student') Student
                    option(value="admin", selected=filters.role === 'admin') Admin

            div
                label(class="block text-xs font-medium text-gray-500 mb-1") Trạng thái
                select(
                    name="status"
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 outline-none"
                )
                    option(value="all", selected=filters.status === 'all') Tất cả trạng thái
                    option(value="pending", selected=filters.status === 'pending') Chờ duyệt
                    option(value="approved", selected=filters.status === 'approved') Đã duyệt
                    option(value="rejected", selected=filters.status === 'rejected') Bị từ chối
                    option(value="disabled", selected=filters.status === 'disabled') Vô hiệu hoá

            //- 👇 Lọc theo tổ chức GỐC (user_key) — chỉ admin default
            if canManageUserKey
                div(class="md:w-56")
                    label(class="block text-xs font-medium text-gray-500 mb-1") Tổ chức gốc
                    select(
                        name="userKey"
                        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 outline-none"
                    )
                        option(
                            value="all"
                            selected=(!filters.userKey || filters.userKey === 'all')
                        ) Tất cả tổ chức
                        option(
                            value="default"
                            selected=filters.userKey === 'default'
                        ) ⌂ Mặc định (default — null)
                        if userKeys && userKeys.length
                            each uk in userKeys
                                option(
                                    value=String(uk._id)
                                    selected=(String(filters.userKey) === String(uk._id))
                                )= uk.name + ' (' + uk.code + ')'
                        option(
                            value="unassigned"
                            selected=filters.userKey === 'unassigned'
                        ) — Chưa gán tổ chức —

            //- 👇 MỚI: lọc user ĐÃ KẾT NỐI tới 1 tổ chức (connectedUserKeys)
            if canManageUserKey
                div(class="md:w-56")
                    label(class="block text-xs font-medium text-gray-500 mb-1") Đã kết nối tới
                    select(
                        name="connectedKey"
                        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 outline-none"
                    )
                        option(
                            value=""
                            selected=(!filters.connectedKey)
                        ) — Bất kỳ —
                        if userKeys && userKeys.length
                            each uk in userKeys
                                option(
                                    value=String(uk._id)
                                    selected=(String(filters.connectedKey) === String(uk._id))
                                )= uk.name + ' (' + uk.code + ')'

            div(class="flex gap-2")
                button(
                    type="submit"
                    class="px-5 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
                ) Lọc

                a(
                    href="/admin/users"
                    class="px-5 py-2.5 border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 transition"
                ) Xoá lọc

        //- ============================================================
        //- TABLE
        //- ============================================================
        div(class="bg-white border border-gray-200 rounded-2xl overflow-hidden")
            .overflow-x-auto
                table(class="w-full text-sm")
                    thead(class="bg-gray-50")
                        tr
                            th(class="px-5 py-3 text-left font-semibold text-gray-600") Người dùng
                            th(class="px-5 py-3 text-left font-semibold text-gray-600") Vai trò
                            th(class="px-5 py-3 text-left font-semibold text-gray-600") Trạng thái
                            th(class="px-5 py-3 text-left font-semibold text-gray-600") Tổ chức
                            if canManageUserKey
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Sửa layout
                            th(class="px-5 py-3 text-left font-semibold text-gray-600") Ngày tạo
                            th(class="px-5 py-3 text-right font-semibold text-gray-600") Hành động

                    tbody(class="divide-y divide-gray-100")
                        if users && users.length
                            each u in users
                                - var connectedIds = (u.connectedUserKeys || []).map(function(k){ return String(k._id || k); });
                                tr(class="hover:bg-gray-50", data-user-id=u._id)
                                    td(class="px-5 py-4")
                                        div(class="flex items-center gap-3")
                                            div(class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0")
                                                span(class="text-sm font-bold text-indigo-700")
                                                    | #{(u.name || u.email || 'U').charAt(0).toUpperCase()}
                                            div(class="min-w-0")
                                                p(class="font-medium text-gray-900 truncate")= u.name || '(Chưa có tên)'
                                                p(class="text-xs text-gray-500 truncate")= u.email

                                    td(class="px-5 py-4")
                                        if u.role === 'admin'
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-100 text-indigo-700") Admin
                                        else if u.role === 'student'
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700") Sinh viên
                                        else
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700") Client

                                    td(class="px-5 py-4")
                                        if u.status === 'approved'
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700") Đã duyệt
                                        else if u.status === 'pending'
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700") Chờ duyệt
                                        else if u.status === 'rejected'
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700") Bị từ chối
                                        else if u.status === 'disabled'
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-gray-200 text-gray-700") Vô hiệu hoá
                                        else
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700")= u.status

                                    //- 👇 Cột tổ chức: gốc + các tổ chức đã kết nối (multi)
                                    td(class="px-5 py-4")
                                        div(class="flex flex-col gap-1.5")
                                            //- Tổ chức gốc
                                            div
                                                if u.userKey && u.userKey.name
                                                    span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-700 w-fit")
                                                        i(data-lucide="building-2", class="w-3 h-3")
                                                        = u.userKey.name
                                                    span(class="text-[10px] text-gray-400 font-mono ml-1")= u.userKey.code || ''
                                                else
                                                    span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600")
                                                        i(data-lucide="home", class="w-3 h-3")
                                                        if canManageUserKey
                                                            | Mặc định
                                                        else
                                                            | Chưa gán tổ chức

                                            //- 👇 MỚI: các tổ chức đã kết nối thêm (connectedUserKeys)
                                            if u.connectedUserKeys && u.connectedUserKeys.length
                                                div(class="flex flex-wrap gap-1")
                                                    each ck in u.connectedUserKeys
                                                        if ck && ck.name
                                                            span(
                                                                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-blue-50 text-blue-700 border border-blue-100"
                                                                title="Đã kết nối (có thể làm bài của tổ chức này)"
                                                            )
                                                                i(data-lucide="link-2", class="w-2.5 h-2.5")
                                                                = ck.name

                                    //- 👇 MỚI: quyền sửa layout — chỉ admin default thấy; chỉ admin thuộc user_key mới có công tắc
                                    if canManageUserKey
                                        td(class="px-5 py-4")
                                            if u.role === 'admin' && u.userKey
                                                button(
                                                    type="button"
                                                    class="toggle-layout-perm inline-flex px-2.5 py-1 rounded-full text-xs font-medium transition " + (u.canEditLayout ? 'bg-green-100 text-green-700 hover:bg-green-200' : 'bg-gray-100 text-gray-600 hover:bg-gray-200')
                                                    data-id=u._id
                                                    data-name=(u.name || u.email)
                                                    data-grant=(u.canEditLayout ? 'false' : 'true')
                                                    title=(u.canEditLayout ? 'Bấm để thu hồi quyền sửa layout' : 'Bấm để cấp quyền sửa layout')
                                                )= u.canEditLayout ? 'Đang bật' : 'Đang tắt'
                                            else
                                                span(class="text-gray-300") —

                                    td(class="px-5 py-4 text-gray-500 text-xs")
                                        = u.createdAt ? new Date(u.createdAt).toLocaleString('vi-VN') : '—'

                                    td(class="px-5 py-4")
                                        div(class="flex items-center justify-end gap-2")
                                            if u.status === 'pending' && u.role !== 'admin'
                                                button(
                                                    type="button"
                                                    class="quick-approve px-3 py-1.5 bg-green-600 text-white rounded-lg text-xs font-medium hover:bg-green-700 transition"
                                                    data-id=u._id
                                                ) Duyệt

                                            //- admin default: full quyền. admin user_key: sửa/xoá user (kể cả admin) CỦA tổ chức mình;
                                            //- admin default và client mới chưa gán tổ chức: không có Sửa/Xoá (client chỉ có Duyệt).
                                            if canManageUserKey || u.userKey
                                                button(
                                                    type="button"
                                                    class="edit-user px-3 py-1.5 border border-gray-300 text-gray-700 rounded-lg text-xs font-medium hover:bg-gray-50 transition"
                                                    data-user=JSON.stringify({
                                                        _id: String(u._id),
                                                        name: u.name || '',
                                                        email: u.email || '',
                                                        role: u.role,
                                                        status: u.status,
                                                        userKeyId: u.userKey ? String(u.userKey._id || u.userKey) : null,
                                                        connectedUserKeys: connectedIds,
                                                        canEditLayout: u.canEditLayout === true
                                                    })
                                                ) Sửa

                                            else if u.role === 'admin' && !u.userKey
                                                span(class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-gray-100 text-gray-500 text-xs font-medium", title="Admin default: bạn chỉ được xem")
                                                    i(data-lucide="eye", class="w-3 h-3")
                                                    | Chỉ xem

                                            //- Xoá: admin default xoá được mọi user; admin user_key chỉ xoá user thuộc user_key mình; không tự xoá mình
                                            if String(u._id) !== String(user._id) && (canManageUserKey || u.userKey)
                                                button(
                                                    type="button"
                                                    class="delete-user px-3 py-1.5 border border-red-300 text-red-600 rounded-lg text-xs font-medium hover:bg-red-50 transition"
                                                    data-id=u._id
                                                    data-email=u.email
                                                ) Xoá
                        else
                            tr
                                td(colspan=(canManageUserKey ? 7 : 6), class="px-5 py-12 text-center")
                                    i(data-lucide="users", class="w-10 h-10 mx-auto text-gray-300")
                                    p(class="text-gray-500 mt-3") Không có user nào.

        //- ============================================================
        //- PAGINATION (nếu controller có truyền)
        //- ============================================================
        if typeof totalPages !== 'undefined'
            include ../pagination
        else if pagination && pagination.totalPages > 1
            div(class="flex items-center justify-between mt-6")
                p(class="text-sm text-gray-500")
                    | Trang #{pagination.page} / #{pagination.totalPages} — Tổng #{pagination.total} user

                div(class="flex gap-2")
                    if pagination.hasPrev
                        a(
                            href=`/admin/users?q=${encodeURIComponent(filters.q || '')}&role=${filters.role}&status=${filters.status}&userKey=${encodeURIComponent(filters.userKey || 'all')}&connectedKey=${encodeURIComponent(filters.connectedKey || '')}&page=${pagination.page - 1}`
                            class="px-4 py-2 border border-gray-300 rounded-lg text-sm hover:bg-gray-50"
                        ) ← Trước
                    if pagination.hasNext
                        a(
                            href=`/admin/users?q=${encodeURIComponent(filters.q || '')}&role=${filters.role}&status=${filters.status}&userKey=${encodeURIComponent(filters.userKey || 'all')}&connectedKey=${encodeURIComponent(filters.connectedKey || '')}&page=${pagination.page + 1}`
                            class="px-4 py-2 border border-gray-300 rounded-lg text-sm hover:bg-gray-50"
                        ) Sau →

    //- ================================================================
    //- MODAL EDIT USER
    //- ================================================================
    div#editUserModal(class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 overflow-y-auto")
        div(class="bg-white rounded-2xl max-w-lg w-full shadow-xl my-8")
            div(class="px-6 py-4 border-b border-gray-200 flex items-center justify-between")
                h3(class="font-bold text-lg text-gray-900") Sửa tài khoản
                button#closeEditModal(class="text-gray-400 hover:text-gray-600", type="button")
                    i(data-lucide="x", class="w-5 h-5")

            form#editUserForm(class="px-6 py-5 space-y-4")
                input#editUserId(type="hidden", name="id")

                div
                    label(class="block text-sm font-medium text-gray-700 mb-1") Email
                    input#editUserEmail(
                        type="email"
                        disabled
                        class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-500"
                    )

                div
                    label(class="block text-sm font-medium text-gray-700 mb-1") Tên
                    input#editUserName(
                        type="text"
                        name="name"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 outline-none"
                    )

                div
                    label(class="block text-sm font-medium text-gray-700 mb-1") Vai trò
                    select#editUserRole(
                        name="role"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 outline-none"
                    )
                        option(value="client") Client
                        option(value="student") Sinh viên
                        option(value="admin") Admin

                div
                    label(class="block text-sm font-medium text-gray-700 mb-1") Trạng thái
                    select#editUserStatus(
                        name="status"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 outline-none"
                    )
                        option(value="pending") Chờ duyệt
                        option(value="approved") Đã duyệt
                        option(value="rejected") Bị từ chối
                        option(value="disabled") Vô hiệu hoá

                //- 👇 Tổ chức GỐC (1 lựa chọn duy nhất)
                if canManageUserKey
                    div
                        label(class="block text-sm font-medium text-gray-700 mb-1") Tổ chức gốc (user_key)
                        select#editUserKey(
                            name="userKey"
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-200 focus:border-indigo-500 outline-none"
                        )
                            option(value="") ⌂ Mặc định (default — null)
                            if userKeys && userKeys.length
                                each uk in userKeys
                                    option(value=String(uk._id))= uk.name + ' (' + uk.code + ')'
                        p(class="text-xs text-gray-400 mt-1") Tổ chức gốc của user. Để trống = tổ chức mặc định.
                else
                    div
                        label(class="block text-sm font-medium text-gray-700 mb-1") Tổ chức gốc (user_key)
                        input#editUserKeyLocked(
                            type="text"
                            disabled
                            class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-500"
                            value="(Cố định theo admin duyệt — không đổi được)"
                        )
                        p(class="text-xs text-gray-400 mt-1") Admin user_key không thể đổi tổ chức của user.

                //- 👇 MỚI: Tổ chức ĐÃ KẾT NỐI (multi-select checkbox)
                //   - Chỉ admin default thấy
                //   - Là mảng connectedUserKeys — user có thể làm bài của NHIỀU tổ chức
                //   - Server tự động loại bỏ nếu trùng với tổ chức gốc
                if canManageUserKey
                    div
                        label(class="block text-sm font-medium text-gray-700 mb-1") Tổ chức đã kết nối (connectedUserKeys)
                        div(class="border border-gray-300 rounded-lg p-3 max-h-48 overflow-y-auto bg-white")
                            if userKeys && userKeys.length
                                each uk, idx in userKeys
                                    label(class="flex items-center gap-2 py-1.5 cursor-pointer hover:bg-gray-50 rounded px-2")
                                        input(
                                            type="checkbox"
                                            class="connected-key-checkbox w-4 h-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500"
                                            value=String(uk._id)
                                        )
                                        span(class="text-sm text-gray-800")
                                            = uk.name
                                            span(class="text-xs text-gray-400 ml-1")= '(' + uk.code + ')'
                            else
                                p(class="text-sm text-gray-400 text-center py-2") Chưa có tổ chức nào đang hoạt động.
                        p(class="text-xs text-gray-400 mt-1")
                            | User sẽ làm được bài của các tổ chức được tick ở đây (ngoài tổ chức gốc). Không tick = chỉ làm bài của tổ chức gốc.
                else
                    div
                        label(class="block text-sm font-medium text-gray-700 mb-1") Tổ chức đã kết nối (connectedUserKeys)
                        input(
                            type="text"
                            disabled
                            class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-500"
                            value="(Chỉ admin default quản lý được mục này)"
                        )

                //- 👇 MỚI: quyền sửa layout — chỉ admin default thấy.
                //-   Chỉ hiện khi Vai trò = Admin VÀ có tổ chức gốc (JS ẩn/hiện, server cũng ép lại)
                if canManageUserKey
                    div#editLayoutPermWrap(class="hidden")
                        label(class="flex items-start gap-2 cursor-pointer")
                            input#editCanEditLayout(
                                type="checkbox"
                                class="mt-0.5 w-4 h-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500"
                            )
                            span
                                span(class="block text-sm font-medium text-gray-700") Cho phép sửa layout
                                span(class="block text-xs text-gray-400") Admin này được sửa logo, chữ dưới logo và chân trang của tổ chức mình.

                div#editUserError(class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2")

                div(class="flex items-center justify-end gap-3 pt-2")
                    button(
                        type="button"
                        id="cancelEditModal"
                        class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50"
                    ) Huỷ
                    button(
                        type="submit"
                        class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700"
                    ) Lưu

    //- ================================================================
    //- JS
    //- ================================================================
    script.
        (function () {
            var CAN_MANAGE_USER_KEY = #{canManageUserKey ? 'true' : 'false'};
            var modal = document.getElementById('editUserModal');
            var form = document.getElementById('editUserForm');
            var errBox = document.getElementById('editUserError');

            function getConnectedCheckboxes() {
                return document.querySelectorAll('.connected-key-checkbox');
            }

            //- 👇 MỚI: ô "Cho phép sửa layout" chỉ hiện khi role=admin và có tổ chức gốc
            function layoutPermVisible() {
                var role = document.getElementById('editUserRole').value;
                var keySel = document.getElementById('editUserKey');
                return role === 'admin' && !!(keySel && keySel.value);
            }

            function syncLayoutPerm() {
                var wrap = document.getElementById('editLayoutPermWrap');
                if (!wrap) return;
                var show = layoutPermVisible();
                wrap.classList.toggle('hidden', !show);
                if (!show) document.getElementById('editCanEditLayout').checked = false;
            }

            function openModal(user) {
                document.getElementById('editUserId').value = user._id;
                document.getElementById('editUserEmail').value = user.email;
                document.getElementById('editUserName').value = user.name || '';
                document.getElementById('editUserRole').value = user.role;
                document.getElementById('editUserStatus').value = user.status;

                if (CAN_MANAGE_USER_KEY) {
                    //- Tổ chức gốc
                    var sel = document.getElementById('editUserKey');
                    if (sel) sel.value = user.userKeyId || '';

                    //- 👇 MỚI: set trạng thái checkbox cho connectedUserKeys
                    var connected = Array.isArray(user.connectedUserKeys)
                        ? user.connectedUserKeys.map(String)
                        : [];
                    getConnectedCheckboxes().forEach(function (cb) {
                        cb.checked = connected.indexOf(String(cb.value)) !== -1;
                    });

                    var perm = document.getElementById('editCanEditLayout');
                    if (perm) perm.checked = user.canEditLayout === true;
                    syncLayoutPerm();
                }

                errBox.classList.add('hidden');
                errBox.textContent = '';
                modal.classList.remove('hidden');
            }

            function closeModal() {
                modal.classList.add('hidden');
            }

            document.querySelectorAll('.edit-user').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    try {
                        var user = JSON.parse(btn.getAttribute('data-user'));
                        openModal(user);
                    } catch (e) {
                        alert('Không đọc được dữ liệu user');
                    }
                });
            });

            if (CAN_MANAGE_USER_KEY) {
                document.getElementById('editUserRole').addEventListener('change', syncLayoutPerm);
                document.getElementById('editUserKey').addEventListener('change', syncLayoutPerm);
            }

            document.getElementById('closeEditModal').addEventListener('click', closeModal);
            document.getElementById('cancelEditModal').addEventListener('click', closeModal);
            modal.addEventListener('click', function (e) {
                if (e.target === modal) closeModal();
            });

            // Quick approve
            document.querySelectorAll('.quick-approve').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var id = btn.getAttribute('data-id');
                    if (!confirm('Duyệt user này?')) return;
                    btn.disabled = true;
                    btn.textContent = '...';
                    try {
                        var res = await fetch('/admin/users/' + id + '/approve', {
                            method: 'POST',
                            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
                        });
                        var data = await res.json();
                        if (data.success) {
                            location.reload();
                        } else {
                            alert(data.message || 'Lỗi duyệt user');
                            btn.disabled = false;
                            btn.textContent = 'Duyệt';
                        }
                    } catch (e) {
                        alert('Lỗi mạng');
                        btn.disabled = false;
                        btn.textContent = 'Duyệt';
                    }
                });
            });

            // Delete
            document.querySelectorAll('.delete-user').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var id = btn.getAttribute('data-id');
                    var email = btn.getAttribute('data-email');
                    if (!confirm('Xoá vĩnh viễn user "' + email + '"? Hành động không thể hoàn tác.')) return;
                    btn.disabled = true;
                    try {
                        var res = await fetch('/admin/users/' + id + '/delete', {
                            method: 'POST',
                            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
                        });
                        var data = await res.json();
                        if (data.success) {
                            location.reload();
                        } else {
                            alert(data.message || 'Lỗi xoá');
                            btn.disabled = false;
                        }
                    } catch (e) {
                        alert('Lỗi mạng');
                        btn.disabled = false;
                    }
                });
            });

            // 👇 MỚI: cấp / thu hồi quyền sửa layout (chỉ admin default có nút này)
            document.querySelectorAll('.toggle-layout-perm').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var id = btn.getAttribute('data-id');
                    var name = btn.getAttribute('data-name');
                    var grant = btn.getAttribute('data-grant') === 'true';
                    var msg = grant
                        ? 'Cấp quyền sửa layout cho "' + name + '"?'
                        : 'Thu hồi quyền sửa layout của "' + name + '"?';
                    if (!confirm(msg)) return;
                    btn.disabled = true;
                    try {
                        var res = await fetch('/admin/users/' + id + '/layout-permission', {
                            method: 'POST',
                            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                            body: JSON.stringify({ canEditLayout: grant ? 'true' : 'false' })
                        });
                        var data = await res.json();
                        if (data.success) {
                            location.reload();
                        } else {
                            alert(data.message || 'Lỗi cập nhật quyền');
                            btn.disabled = false;
                        }
                    } catch (e) {
                        alert('Lỗi mạng');
                        btn.disabled = false;
                    }
                });
            });

            // Submit form update
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                var id = document.getElementById('editUserId').value;
                var body = {
                    name: document.getElementById('editUserName').value,
                    role: document.getElementById('editUserRole').value,
                    status: document.getElementById('editUserStatus').value
                };

                if (CAN_MANAGE_USER_KEY) {
                    //- Tổ chức gốc (1 lựa chọn)
                    var sel = document.getElementById('editUserKey');
                    body.userKey = (sel && sel.value) ? sel.value : "";

                    //- 👇 MỚI: thu thập các connectedUserKeys đã tick → mảng ObjectId
                    var checked = [];
                    getConnectedCheckboxes().forEach(function (cb) {
                        if (cb.checked) checked.push(cb.value);
                    });
                    body.connectedUserKeys = checked;

                    //- 👇 MỚI: chỉ gửi true khi ô đang hiện và được tick
                    body.canEditLayout = layoutPermVisible() &&
                        document.getElementById('editCanEditLayout').checked;
                }

                errBox.classList.add('hidden');

                try {
                    var res = await fetch('/admin/users/' + id + '/update', {
                        method: 'POST',
                        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                        body: JSON.stringify(body)
                    });
                    var data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        errBox.textContent = data.message || 'Lỗi cập nhật';
                        errBox.classList.remove('hidden');
                    }
                } catch (e) {
                    errBox.textContent = 'Lỗi mạng';
                    errBox.classList.remove('hidden');
                }
            });
        })();