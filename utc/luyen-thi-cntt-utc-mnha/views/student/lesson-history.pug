extends ../layout

//- ================================================================
//-  Lịch sử làm bài của 1 bài học — GET /lessons/:id/history
//-  Controller truyền: lesson {_id,title,type}, subject, submissions, stats,
//-                     isAdmin, q, currentPage/totalPages/baseUrl (pagination)
//-    admin   → tất cả bài nộp của mọi sinh viên (có ô tìm theo tên/email)
//-    student → chỉ bài nộp của chính mình
//- ================================================================
block content
    - var lessonId = String(lesson._id)
    div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")

        //- Header
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6")
            div(class="min-w-0")
                a(href=("/lessons/" + lessonId), class="inline-flex items-center gap-1 text-sm text-indigo-600 hover:underline mb-2")
                    i(data-lucide="arrow-left", class="w-4 h-4")
                    | Quay lại bài học
                h1(class="text-2xl sm:text-3xl font-bold text-gray-900")
                    | Lịch sử làm bài
                p(class="text-gray-700 font-medium mt-1 break-words")= lesson.title
                p(class="text-gray-500 text-sm mt-0.5")
                    if subject && subject.name
                        = subject.name + ' • '
                    if isAdmin
                        | Bài nộp của tất cả sinh viên
                    else
                        | Tất cả bài bạn đã nộp vào bài học này

            a(
                href=("/lessons/" + lessonId)
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
            )
                i(data-lucide="pencil", class="w-4 h-4")
                | Làm bài

        //- Thống kê nhanh
        div(class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6")
            div(class="bg-white border border-gray-200 rounded-xl px-4 py-3")
                p(class="text-xs text-gray-500") #{isAdmin ? 'Tổng bài nộp' : 'Số lần đã nộp'}
                p(class="text-2xl font-bold text-gray-900")= stats.total
            if isAdmin
                div(class="bg-white border border-gray-200 rounded-xl px-4 py-3")
                    p(class="text-xs text-gray-500") Số sinh viên đã nộp
                    p(class="text-2xl font-bold text-gray-900")= stats.students
            div(class="bg-white border border-gray-200 rounded-xl px-4 py-3")
                p(class="text-xs text-gray-500") Điểm cao nhất
                if stats.bestScore !== null && stats.bestScore !== undefined
                    p(class="text-2xl font-bold text-gray-900")
                        = stats.bestScore
                        span(class="text-sm font-normal text-gray-500")= ' / ' + stats.bestMax
                else
                    p(class="text-2xl font-bold text-gray-400") —

        //- ★ Biểu đồ điểm theo thời gian (admin + student).
        //-   admin: tất cả sinh viên • student: chỉ bài của mình. Vẽ bởi /js/historyChart.js
        div(class="bg-white border border-gray-200 rounded-2xl shadow-sm p-4 sm:p-5 mb-6")
            div(class="flex flex-wrap items-baseline justify-between gap-2")
                h2(class="text-lg font-bold text-gray-900")
                    | Biểu đồ điểm
                    span(id="hcRangeLabel", class="ml-2 text-sm font-medium text-indigo-600")
                span(id="hcSummary", class="text-xs sm:text-sm text-gray-600 font-mono")
            p(class="text-xs text-gray-500 mt-1")
                if isAdmin
                    | Điểm của tất cả sinh viên đã nộp bài học này.
                else
                    | Điểm của cả lớp (ẩn danh) để bạn so sánh — chấm to viền đen là bài của bạn.

            //- Chọn khoảng thời gian: gần nhất
            div(class="flex flex-wrap items-center gap-2 mt-3")
                button(type="button", data-hc-range="day", class="px-3 py-1.5 rounded-lg text-sm font-medium border", style="background:#fff;border-color:#d1d5db;") 1 ngày
                button(type="button", data-hc-range="month", class="px-3 py-1.5 rounded-lg text-sm font-medium border", style="background:#fff;border-color:#d1d5db;") 1 tháng
                button(type="button", data-hc-range="year", class="px-3 py-1.5 rounded-lg text-sm font-medium border", style="background:#fff;border-color:#d1d5db;") 1 năm
                button(type="button", data-hc-range="all", class="px-3 py-1.5 rounded-lg text-sm font-medium border", style="background:#fff;border-color:#d1d5db;") Tất cả

                //- Chọn khoảng thời gian: cụ thể (năm / tháng / ngày)
                span(class="mx-1 text-gray-300 hidden sm:inline") |
                label(for="hcKind", class="text-sm text-gray-600") Xem theo:
                select(id="hcKind", class="px-2 py-1.5 border border-gray-300 rounded-lg text-sm bg-white")
                    option(value="year") Năm
                    option(value="month") Tháng
                    option(value="day") Ngày
                input(id="hcYear", type="number", min="2000", max="2100", step="1", class="w-24 px-2 py-1.5 border border-gray-300 rounded-lg text-sm")
                input(id="hcMonth", type="month", class="px-2 py-1.5 border border-gray-300 rounded-lg text-sm")
                input(id="hcDay", type="date", class="px-2 py-1.5 border border-gray-300 rounded-lg text-sm")

                div(class="ml-auto flex flex-wrap items-center gap-x-4 gap-y-1")
                    if !isAdmin
                        label(class="inline-flex items-center gap-1.5 text-sm text-gray-600 cursor-pointer select-none")
                            input(id="hcOthers", type="checkbox")
                            | Hiện sinh viên khác
                    label(class="inline-flex items-center gap-1.5 text-sm text-gray-600 cursor-pointer select-none")
                        input(id="hcLine", type="checkbox")
                        = isAdmin ? 'Nối các điểm' : 'Nối các điểm của tôi'

            div(style="position:relative;margin-top:12px;")
                div(id="hcSvgHost")
                div(id="hcEmpty", style="display:none;position:absolute;inset:0;align-items:center;justify-content:center;color:#9ca3af;font-size:14px;pointer-events:none;")
                    | Không có bài nộp trong khoảng này
                div(id="hcTip", style="display:none;position:absolute;z-index:5;pointer-events:none;background:#111827;color:#fff;font-size:12px;line-height:1.5;padding:8px 10px;border-radius:8px;box-shadow:0 6px 18px rgba(0,0,0,.25);white-space:nowrap;")

            //- Chú giải 10 khoảng điểm [0,1] … [9,10] (kèm số bài trong khoảng)
            div(id="hcLegend", class="flex flex-wrap gap-1.5 mt-3")
            p(class="text-xs text-gray-400 mt-2")
                | Mỗi khoảng điểm một màu. Điểm nằm đúng biên thuộc khoảng trên (1 → [1,2]); điểm 10 thuộc [9,10]. Bài trắc nghiệm được quy về thang 10.
            script(id="hcData", type="application/json")!= chartJson

        //- Tìm kiếm (chỉ admin)
        if isAdmin
            form(method="get", action=("/lessons/" + lessonId + "/history"), class="flex flex-wrap items-center gap-2 mb-5")
                input(
                    type="text"
                    name="q"
                    value=q
                    placeholder="Tìm theo tên hoặc email sinh viên…"
                    class="flex-1 min-w-[220px] px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300"
                )
                button(type="submit", class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700")
                    | Tìm
                if q
                    a(href=("/lessons/" + lessonId + "/history"), class="px-3 py-2 text-sm text-gray-600 hover:underline")
                        | Xoá lọc

        //- Empty state
        if !submissions || submissions.length === 0
            div(class="bg-white border border-gray-200 rounded-2xl py-16 text-center")
                div(class="w-14 h-14 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center mx-auto")
                    i(data-lucide="inbox", class="w-6 h-6")
                h2(class="font-semibold text-gray-900 mt-4")
                    if isAdmin && q
                        | Không có bài nộp phù hợp
                    else
                        | Chưa có bài nộp nào
                p(class="text-sm text-gray-500 mt-1")
                    if isAdmin
                        | Khi sinh viên nộp bài vào bài học này, bài nộp sẽ hiện ở đây.
                    else
                        | Làm bài và nộp để xem lịch sử ở đây.

        else
            div(class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden")
                div(class="overflow-x-auto")
                    table(class="w-full text-sm")
                        thead(class="bg-gray-50")
                            tr
                                if isAdmin
                                    th(class="px-5 py-3 text-left font-semibold text-gray-600") Sinh viên
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Điểm
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Số lỗi
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Model
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Thời gian
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Trạng thái
                                th(class="px-5 py-3 text-left font-semibold text-gray-600") Nhận xét GV
                                th(class="px-5 py-3 text-right font-semibold text-gray-600") Hành động

                        tbody(class="divide-y divide-gray-100")
                            each s in submissions
                                //- Bài cũ không có `type` (lean không áp default) → essay
                                - var isQuiz = (s.type || 'essay') === 'quiz'
                                - var hasScore = s.score !== null && s.score !== undefined
                                - var sid = String(s._id)
                                - var detailUrl = isQuiz ? ('/quiz-submissions/' + sid) : ('/submissions/' + sid)
                                - var reviewUrl = isQuiz ? ('/admin/quiz-submissions/' + sid + '/review') : ('/admin/submissions/' + sid + '/review')
                                tr(class="hover:bg-gray-50")

                                    //- Sinh viên (admin)
                                    if isAdmin
                                        td(class="px-5 py-4")
                                            if s.userId && s.userId.name
                                                p(class="font-medium text-gray-900")= s.userId.name
                                                if s.userId.email
                                                    p(class="text-xs text-gray-500 mt-0.5")= s.userId.email
                                            else
                                                span(class="text-gray-400") (Tài khoản đã xoá)

                                    //- Điểm
                                    td(class="px-5 py-4")
                                        if hasScore
                                            span(class="font-bold text-lg text-gray-900")= s.score
                                            span(class="text-sm text-gray-500")= ' / ' + (isQuiz ? (s.maxScore || 10) : 10)
                                        else
                                            span(class="text-gray-400") —

                                    //- Số lỗi
                                    td(class="px-5 py-4")
                                        - var errCount = (s.errorCount !== null && s.errorCount !== undefined) ? s.errorCount : ((s.grammar && Array.isArray(s.grammar.errors)) ? s.grammar.errors.length : 0)
                                        if isQuiz
                                            span(class="text-xs text-gray-400") —
                                        else if errCount > 0
                                            span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700")
                                                i(data-lucide="circle-alert", class="w-3 h-3")
                                                = errCount + ' lỗi'
                                        else if s.status === 'graded'
                                            span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700")
                                                i(data-lucide="check-circle-2", class="w-3 h-3")
                                                | Không có lỗi
                                        else
                                            span(class="text-xs text-gray-400") —

                                    //- Model
                                    td(class="px-5 py-4")
                                        if isQuiz
                                            span(class="inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-medium bg-emerald-50 text-emerald-700")
                                                i(data-lucide="zap", class="w-3 h-3")
                                                | Chấm tự động
                                        else if s.model
                                            span(class="text-xs font-mono px-2 py-1 rounded bg-indigo-50 text-indigo-700")= s.model
                                        else
                                            span(class="text-gray-400") —

                                    //- Thời gian
                                    td(class="px-5 py-4 text-gray-500 text-xs whitespace-nowrap")
                                        if s.submittedAt
                                            = new Date(s.submittedAt).toLocaleString('vi-VN')
                                        else if s.createdAt
                                            = new Date(s.createdAt).toLocaleString('vi-VN')
                                        else
                                            | —

                                    //- Trạng thái
                                    td(class="px-5 py-4")
                                        if s.status === 'graded' || (isQuiz && hasScore)
                                            span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700")
                                                i(data-lucide="check-circle-2", class="w-3 h-3")
                                                | Đã chấm
                                        else if s.status === 'grading' || s.status === 'pending'
                                            span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700") Đang chấm
                                        else if s.status === 'failed'
                                            span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700")
                                                i(data-lucide="circle-alert", class="w-3 h-3")
                                                | Lỗi
                                        else
                                            span(class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700")= s.status || 'Không xác định'

                                    //- Nhận xét giảng viên
                                    td(class="px-5 py-4 max-w-xs")
                                        - var tc = s.teacherComment
                                        - var teacherNote = (tc && tc.content) ? tc.content.trim() : ''
                                        - var teacherName = (tc && tc.commentedByName) ? tc.commentedByName : 'Giảng viên'
                                        if teacherNote
                                            div(class="flex items-start gap-1.5")
                                                i(data-lucide="message-square-text", class="w-3.5 h-3.5 text-indigo-500 mt-0.5 flex-shrink-0")
                                                div
                                                    p(class="text-xs font-medium text-gray-900")= teacherName
                                                    p(class="text-xs text-gray-700 line-clamp-2")= teacherNote
                                        else
                                            span(class="text-gray-400") —

                                    //- Hành động
                                    td(class="px-5 py-4 text-right whitespace-nowrap")
                                        a(
                                            href=detailUrl
                                            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition"
                                        )
                                            i(data-lucide="eye", class="w-3.5 h-3.5")
                                            | Xem chi tiết
                                        if isAdmin
                                            a(
                                                href=reviewUrl
                                                class="inline-flex items-center gap-1 ml-1 px-3 py-1.5 rounded-lg text-xs font-medium bg-amber-50 text-amber-700 hover:bg-amber-100 transition"
                                            )
                                                i(data-lucide="message-square-plus", class="w-3.5 h-3.5")
                                                | Nhận xét

            //- Phân trang
            include ../pagination

    script(src="/js/historyChart.js")
